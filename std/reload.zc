// Hot reload: a module of Zen C, rebuilt from source and loaded into this process through
// libtcc, for a development host that keeps running while the module's code changes.
//
//     let code = Reloader::new("src/game/game.zc", "build/game.c");
//     code.add_include("third_party/include");   (where the module's #includes are)
//     if !code.build() { /* the errors are printed; fix and save */ }
//     let frame: fn*(void*) = code.symbol("game_frame");
//     ...
//     // between frames, when none of the module's code is running:
//     if code.poll() { frame = code.symbol("game_frame"); }
//     ...
//     code.free();
//
// A build runs `zc transpile --reload` on the source, then compiles the C in memory. If
// either fails, the errors are printed and the version already loaded stays in use.
//
// The module's @constructor functions run when the first version loads, and the current
// version's @destructor functions at free(), as at the start and end of a program: a reload
// doesn't start the program again. Work to redo on each reload goes in @before_reload
// functions (run on the old version, just before it's replaced) and @after_reload ones (run
// on the new version, once the state has moved to it). A global marked @reset_on_reload goes
// back to its initial value on every reload, and one whose initial value was edited takes
// the new value.
//
// State survives reloads, and follows the code when its layout changes. The module's
// globals keep their values: each version uses the storage of the one that defined them, so
// a pointer to a global stays valid too. The host's own block, if it gives it to the
// Reloader (keep_state), keeps its contents. When an edit changes the layout of a type the
// state is made of, the state is moved to the new layout: fields by name (in nested structs
// and arrays too), enums by variant name, numbers converted to a new numeric type; a field
// that is new is zero (a global, its initial value), and one that is gone is dropped. When
// the globals themselves change (one added, or retyped), the new version gets new storage
// with the old values moved into it; a pointer to an old global then points at the old
// storage, which stays loaded.
//
// What can't be moved is data behind a pointer to a type whose layout changed: it is in the
// old layout, and how much of it there is isn't known. A version that would need that, or
// whose functions that the host looked up take other parameters, is not loaded: the running
// version stays in use, and the reload says why and to restart. Each reload says what
// changed in the module's types and globals, and what was done to the state (see
// print_changes()).
//
// Code kept from an old version follows the new code where the Reloader can find it. A trait
// object calls the newest code: its vtable's storage is kept like a global's, and refilled
// with the new version's functions on every reload. A function pointer in the state (a
// field of a function pointer type, in the host's block or a global, reached by value) is
// pointed at the new version's function of the same name, unless its signature changed;
// the reload says which. What it can't find keeps running the old code: a function pointer
// behind another pointer, or handed to a library; a lambda (it keeps the body it was made
// with, as in hotreload-hx); a string literal still points into the old version. So old
// versions stay loaded, by default until free(); keep_old(false) deletes each old version
// when the next one loads instead, for programs that keep nothing like that.
//
// The module's code can call the host's own functions, and any library linked into the
// host, if the host exports its symbols (link it with -rdynamic).
//
// libtcc can't give code compiled into memory thread-local storage, so the module's
// thread-locals are ordinary globals, shared by its threads (a release build keeps them per
// thread).
//
// Needs libtcc (0.9.27 or 0.9.28), which the program must link itself: an imported file's
// `//> link:` lines are not read. With zc: `zc build host.zc -l tcc -l dl -l pthread`; with
// a C compiler: `-ltcc -ldl -lpthread -lm`. Not available on Windows yet. It is for development
// hosts, and not written for --misra builds.

include <libtcc.h>

raw {
    #include <dirent.h>
    #include <stdarg.h>
    #include <stdint.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <sys/stat.h>
    #include <time.h>
    #include <unistd.h>

    enum { ZR_MAX_INCLUDES = 32, ZR_MAX_REQUIRED = 32 };

    // What `zc transpile --reload` writes about a module's types, returned by its
    // `_zc_manifest()`. The same definitions are in the module's C (codegen_main.c,
    // emit_reload_manifest); a change to them is a change of `format`.
    #ifndef ZC_MANIFEST_TYPES
    #define ZC_MANIFEST_TYPES
    typedef struct { const char *name; const char *type; unsigned offset; unsigned size; unsigned bits; } ZcMfField;
    typedef struct { const char *name; long long value; const char *payload; } ZcMfVariant;
    typedef struct { const char *c_name; const char *zc_name; unsigned kind; unsigned size; unsigned align; unsigned nfields; const ZcMfField *fields; unsigned nvariants; const ZcMfVariant *variants; } ZcMfType;
    typedef struct { const char *name; const char *type; unsigned size; void *addr; const char *init; const void *init_value; unsigned flags; } ZcMfGlobal;
    typedef struct { const char *name; const char *ret; unsigned nparams; const char *const *params; void *addr; } ZcMfFunc;
    typedef struct { unsigned format; const char *zc_version; unsigned ntypes; const ZcMfType *types; unsigned nglobals; const ZcMfGlobal *globals; unsigned nfuncs; const ZcMfFunc *funcs; } ZcManifest;
    #endif

    typedef struct
    {
        TCCState *tcc;
        void *mem;       // the code's memory, ours with libtcc 0.9.27; NULL with 0.9.28
        size_t mem_size; // 0 when not known (0.9.28)
        int owns_globals; // compiled with ZC_RELOAD_OWN_GLOBALS: the globals' storage is here
    } ZrVersion;

    typedef struct
    {
        char *zc;
        char *zc_flags;
        char *source;
        char *c_file;
        char *watch_dir;
        char *includes[ZR_MAX_INCLUDES];
        char *required[ZR_MAX_REQUIRED]; // types a new version must not change (require_same)
        int required_count;
        int include_count;
        int keep_old;
        int verbose;

        ZrVersion current;
        ZrVersion *old;
        int old_count;
        int old_cap;
        int version;
        int64_t seen; // newest .zc modification time at the last build, or -1
        ZcManifest *types_now;  // a copy of the current version's manifest, or NULL
        ZcManifest *types_prev; // the same for the version before it
        ZcMfGlobal *store;      // the module's globals: in the version that owns them
        int refused;            // builds not loaded: require_same(), or state that can't move
        char **fetched;         // the names the host looked up with symbol()
        int fetched_count;
        int fetched_cap;
        unsigned char *state;   // the block the host passes to the module (keep_state), or NULL
        size_t state_size;
        char *moved;            // what the last reload did to move state, for print_changes()
        ZcMfGlobal *old_vtables; // vtables in storage no longer the current one (old owners)
        unsigned nold_vtables;
        struct ZrFn { void *addr; char *name; char *sig; } *fns; // every version's functions
        unsigned nfns, fns_cap;
        unsigned nstore;
    } ZrReloader;

    static char *zr_strdup(const char *s)
    {
        if (!s) return NULL;
        size_t n = strlen(s) + 1;
        char *d = (char *)malloc(n);
        if (d) memcpy(d, s, n);
        return d;
    }

    static double zr_now_ms(void)
    {
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
    }

    static int64_t zr_mtime_ns(const struct stat *st)
    {
    #if defined(__APPLE__)
        return (int64_t)st->st_mtimespec.tv_sec * 1000000000LL + st->st_mtimespec.tv_nsec;
    #else
        return (int64_t)st->st_mtim.tv_sec * 1000000000LL + st->st_mtim.tv_nsec;
    #endif
    }

    // The newest modification time of the .zc files under `dir`, searched recursively, or
    // -1 if there are none.
    static int64_t zr_newest_zc(const char *dir_path, int depth)
    {
        int64_t newest = -1;
        if (depth > 16) return newest;
        DIR *dir = opendir(dir_path);
        if (!dir) return newest;
        struct dirent *entry;
        while ((entry = readdir(dir)) != NULL)
        {
            const char *name = entry->d_name;
            if (name[0] == '.') continue;
            size_t len = strlen(dir_path) + strlen(name) + 2;
            char *path = (char *)malloc(len);
            if (!path) break;
            snprintf(path, len, "%s/%s", dir_path, name);
            struct stat st;
            if (stat(path, &st) == 0)
            {
                int64_t m = -1;
                if (S_ISDIR(st.st_mode))
                {
                    m = zr_newest_zc(path, depth + 1);
                }
                else
                {
                    size_t n = strlen(name);
                    if (n > 3 && strcmp(name + n - 3, ".zc") == 0) m = zr_mtime_ns(&st);
                }
                if (m > newest) newest = m;
            }
            free(path);
        }
        closedir(dir);
        return newest;
    }

    static void zr_on_tcc_error(void *opaque, const char *msg)
    {
        (void)opaque;
        fprintf(stderr, "reload: tcc: %s\n", msg);
    }

    static void zr_on_tcc_quiet(void *opaque, const char *msg)
    {
        (void)opaque;
        (void)msg;
    }

    // libtcc 0.9.27 compiles into memory the caller gives it; 0.9.28 always allocates it.
    static int zr_relocate(ZrVersion *v)
    {
    #ifdef TCC_RELOCATE_AUTO
        int size = tcc_relocate(v->tcc, NULL);
        if (size < 0) return -1;
        long page = sysconf(_SC_PAGESIZE);
        v->mem_size = ((size_t)size + (size_t)page - 1) / (size_t)page * (size_t)page;
        if (posix_memalign(&v->mem, (size_t)page, v->mem_size) != 0)
        {
            v->mem = NULL;
            v->mem_size = 0;
            return -1;
        }
        return tcc_relocate(v->tcc, v->mem);
    #else
        return tcc_relocate(v->tcc);
    #endif
    }

    // Deletes a version. With libtcc 0.9.27 its memory is first filled with 0xCC (x86's
    // breakpoint instruction), so anything still using it fails at once instead of reading
    // what happens to be left in freed memory.
    // Runs a version's _zc_module_init or _zc_module_fini (from zc --reload), if it has one.
    static void zr_version_call(ZrVersion *v, const char *name)
    {
        if (!v->tcc) return;
        void (*fn)(void) = (void (*)(void))tcc_get_symbol(v->tcc, name);
        if (fn) fn();
    }

    static void zr_version_delete(ZrVersion *v)
    {
        if (v->tcc) tcc_delete(v->tcc);
        if (v->mem)
        {
            memset(v->mem, 0xCC, v->mem_size);
            free(v->mem);
        }
        memset(v, 0, sizeof(*v));
    }

    static void *zr_new(const char *source, const char *c_file)
    {
        ZrReloader *r = (ZrReloader *)calloc(1, sizeof(ZrReloader));
        if (!r) return NULL;
        r->zc = zr_strdup("zc");
        r->source = zr_strdup(source);
        r->c_file = zr_strdup(c_file);
        r->keep_old = 1;
        r->verbose = 1;
        r->seen = -1;
        return r;
    }

    static void zr_set(char **field, const char *value)
    {
        free(*field);
        *field = zr_strdup(value);
    }

    static void zr_set_zc(void *h, const char *zc) { zr_set(&((ZrReloader *)h)->zc, zc); }
    static void zr_set_zc_flags(void *h, const char *f) { zr_set(&((ZrReloader *)h)->zc_flags, f); }
    static void zr_set_source(void *h, const char *s) { zr_set(&((ZrReloader *)h)->source, s); }
    static void zr_set_watch(void *h, const char *d) { zr_set(&((ZrReloader *)h)->watch_dir, d); }
    static void zr_set_keep_old(void *h, int keep) { ((ZrReloader *)h)->keep_old = keep; }
    static void zr_set_verbose(void *h, int verbose) { ((ZrReloader *)h)->verbose = verbose; }

    static int zr_add_include(void *h, const char *dir)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (r->include_count >= ZR_MAX_INCLUDES) return 0;
        r->includes[r->include_count++] = zr_strdup(dir);
        return 1;
    }

    static int zr_require_same(void *h, const char *type)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (r->required_count >= ZR_MAX_REQUIRED) return 0;
        r->required[r->required_count++] = zr_strdup(type);
        return 1;
    }

    // The directory watched for changes: the one set, else the source's directory.
    static char *zr_watch_dir(ZrReloader *r)
    {
        if (r->watch_dir) return zr_strdup(r->watch_dir);
        char *dir = zr_strdup(r->source);
        char *slash = strrchr(dir, '/');
        if (slash) *slash = 0;
        else zr_set(&dir, ".");
        return dir;
    }

    static int64_t zr_newest(ZrReloader *r)
    {
        char *dir = zr_watch_dir(r);
        int64_t newest = zr_newest_zc(dir, 0);
        free(dir);
        return newest;
    }

    // The old versions kept, and their memory when known.
    static void zr_report_kept(ZrReloader *r)
    {
        size_t bytes = 0;
        int known = 1;
        for (int i = 0; i < r->old_count; i++)
        {
            if (r->old[i].mem_size == 0) known = 0;
            bytes += r->old[i].mem_size;
        }
        if (r->old_count == 0) return;
        if (known)
        {
            fprintf(stderr, "reload: %d old version%s kept loaded (%zu KB)\n", r->old_count,
                    r->old_count == 1 ? "" : "s", bytes / 1024);
        }
        else
        {
            fprintf(stderr, "reload: %d old version%s kept loaded\n", r->old_count,
                    r->old_count == 1 ? "" : "s");
        }
    }

    // ---- Comparing versions' manifests ------------------------------------------------
    //
    // The Reloader keeps a copy of each version's manifest, its types sorted by name, so the
    // next version can be compared with it after the old code is gone.

    static const char *zr_s(const char *s) { return s ? s : ""; }

    static int zr_mf_by_name(const void *a, const void *b)
    {
        return strcmp(zr_s(((const ZcMfType *)a)->c_name), zr_s(((const ZcMfType *)b)->c_name));
    }

    static void zr_mf_free(ZcManifest *m)
    {
        if (!m) return;
        for (unsigned i = 0; i < m->ntypes; i++)
        {
            const ZcMfType *t = &m->types[i];
            free((void *)t->c_name);
            free((void *)t->zc_name);
            for (unsigned j = 0; j < t->nfields; j++)
            {
                free((void *)t->fields[j].name);
                free((void *)t->fields[j].type);
            }
            for (unsigned j = 0; j < t->nvariants; j++)
            {
                free((void *)t->variants[j].name);
                free((void *)t->variants[j].payload);
            }
            free((void *)t->fields);
            free((void *)t->variants);
        }
        for (unsigned i = 0; i < m->nglobals; i++)
        {
            free((void *)m->globals[i].name);
            free((void *)m->globals[i].type);
            free((void *)m->globals[i].init);
        }
        free((void *)m->globals);
        for (unsigned i = 0; i < m->nfuncs; i++)
        {
            free((void *)m->funcs[i].name);
            free((void *)m->funcs[i].ret);
            for (unsigned j = 0; j < m->funcs[i].nparams; j++) free((void *)m->funcs[i].params[j]);
            free((void *)m->funcs[i].params);
        }
        free((void *)m->funcs);
        free((void *)m->types);
        free((void *)m->zc_version);
        free(m);
    }

    // A copy of `m` that owns all its memory, or NULL (no manifest, a format this file
    // doesn't know, or out of memory).
    static ZcManifest *zr_mf_copy(const ZcManifest *m)
    {
        if (!m || m->format < 1 || m->format > 5) return NULL;
        ZcManifest *c = (ZcManifest *)calloc(1, sizeof(ZcManifest));
        ZcMfType *types = (ZcMfType *)calloc(m->ntypes ? m->ntypes : 1, sizeof(ZcMfType));
        if (!c || !types)
        {
            free(c);
            free(types);
            return NULL;
        }
        c->format = m->format;
        c->zc_version = zr_strdup(m->zc_version);
        c->types = types;
        int ok = 1;
        if (m->format >= 5 && m->nfuncs)
        {
            ZcMfFunc *f = (ZcMfFunc *)calloc(m->nfuncs, sizeof(ZcMfFunc));
            if (!f) ok = 0;
            else
            {
                c->funcs = f;
                c->nfuncs = m->nfuncs;
                for (unsigned i = 0; i < m->nfuncs; i++)
                {
                    f[i].name = zr_strdup(m->funcs[i].name);
                    f[i].ret = zr_strdup(m->funcs[i].ret);
                    f[i].nparams = m->funcs[i].nparams;
                    f[i].addr = m->funcs[i].addr;
                    char **ps = m->funcs[i].nparams ? (char **)calloc(m->funcs[i].nparams, sizeof(char *)) : NULL;
                    for (unsigned j = 0; ps && j < m->funcs[i].nparams; j++)
                        ps[j] = zr_strdup(m->funcs[i].params[j]);
                    if (m->funcs[i].nparams && !ps) { f[i].nparams = 0; ok = 0; }
                    f[i].params = (const char *const *)ps;
                }
            }
        }
        if (m->format >= 4 && m->nglobals)
        {
            ZcMfGlobal *g = (ZcMfGlobal *)calloc(m->nglobals, sizeof(ZcMfGlobal));
            if (!g) ok = 0;
            else
            {
                c->globals = g;
                c->nglobals = m->nglobals;
                for (unsigned i = 0; i < m->nglobals; i++)
                {
                    g[i] = m->globals[i];
                    g[i].name = zr_strdup(m->globals[i].name);
                    g[i].type = zr_strdup(m->globals[i].type);
                    g[i].init = m->format >= 4 ? zr_strdup(m->globals[i].init) : NULL;
                    if (m->format < 4) { g[i].init_value = NULL; g[i].flags = 0; }
                }
            }
        }
        for (unsigned i = 0; i < m->ntypes; i++)
        {
            const ZcMfType *t = &m->types[i];
            ZcMfType *d = &types[i];
            *d = *t;
            d->c_name = zr_strdup(t->c_name);
            d->zc_name = zr_strdup(t->zc_name);
            d->fields = NULL;
            d->variants = NULL;
            d->nfields = 0;
            d->nvariants = 0;
            c->ntypes = i + 1;
            if (!d->c_name) ok = 0;
            if (t->nfields)
            {
                ZcMfField *f = (ZcMfField *)calloc(t->nfields, sizeof(ZcMfField));
                if (!f) { ok = 0; break; }
                d->fields = f;
                d->nfields = t->nfields;
                for (unsigned j = 0; j < t->nfields; j++)
                {
                    f[j] = t->fields[j];
                    f[j].name = zr_strdup(t->fields[j].name);
                    f[j].type = zr_strdup(t->fields[j].type);
                }
            }
            if (t->nvariants)
            {
                ZcMfVariant *v = (ZcMfVariant *)calloc(t->nvariants, sizeof(ZcMfVariant));
                if (!v) { ok = 0; break; }
                d->variants = v;
                d->nvariants = t->nvariants;
                for (unsigned j = 0; j < t->nvariants; j++)
                {
                    v[j] = t->variants[j];
                    v[j].name = zr_strdup(t->variants[j].name);
                    v[j].payload = zr_strdup(t->variants[j].payload);
                }
            }
        }
        if (!ok)
        {
            zr_mf_free(c);
            return NULL;
        }
        qsort(types, c->ntypes, sizeof(ZcMfType), zr_mf_by_name);
        return c;
    }

    static const ZcMfType *zr_mf_find(const ZcManifest *m, const char *name)
    {
        if (!m || !name) return NULL;
        ZcMfType key;
        memset(&key, 0, sizeof(key));
        key.c_name = name;
        return (const ZcMfType *)bsearch(&key, m->types, m->ntypes, sizeof(ZcMfType), zr_mf_by_name);
    }

    // The two descriptions of a type are the same: kind, size, alignment, and every field
    // and variant, in order.
    static int zr_mf_same(const ZcMfType *a, const ZcMfType *b)
    {
        if (a->kind != b->kind || a->size != b->size || a->align != b->align ||
            a->nfields != b->nfields || a->nvariants != b->nvariants)
            return 0;
        for (unsigned i = 0; i < a->nfields; i++)
        {
            const ZcMfField *x = &a->fields[i], *y = &b->fields[i];
            if (strcmp(zr_s(x->name), zr_s(y->name)) || strcmp(zr_s(x->type), zr_s(y->type)) ||
                x->offset != y->offset || x->size != y->size || x->bits != y->bits)
                return 0;
        }
        for (unsigned i = 0; i < a->nvariants; i++)
        {
            const ZcMfVariant *x = &a->variants[i], *y = &b->variants[i];
            if (strcmp(zr_s(x->name), zr_s(y->name)) || x->value != y->value ||
                strcmp(zr_s(x->payload), zr_s(y->payload)))
                return 0;
        }
        return 1;
    }

    // The type a field or payload holds by value ("Vec2" for "Vec2" or "Vec2[4]"), in
    // `buf`, or NULL for a pointer or function pointer, which holds nothing by value.
    static const char *zr_mf_held(const char *type, char *buf, size_t size)
    {
        if (!type || strchr(type, '*') || strchr(type, '(')) return NULL;
        if (strncmp(type, "struct ", 7) == 0) type += 7;
        size_t n = strcspn(type, "[");
        while (n > 0 && type[n - 1] == ' ') n--;
        if (n == 0 || n >= size) return NULL;
        memcpy(buf, type, n);
        buf[n] = 0;
        return buf;
    }

    // `name` changed between the manifests: it is in only one, its description differs,
    // or a type it holds by value changed. The one it holds is named in `via`, if given.
    static int zr_mf_changed(const ZcManifest *old, const ZcManifest *now, const char *name,
                             int depth, const char **via)
    {
        const ZcMfType *a = zr_mf_find(old, name), *b = zr_mf_find(now, name);
        if (!a && !b) return 0;
        if (!a || !b || !zr_mf_same(a, b)) return 1;
        if (depth > 64) return 0;
        char buf[256];
        for (unsigned i = 0; i < b->nfields + b->nvariants; i++)
        {
            const char *t = i < b->nfields ? b->fields[i].type : b->variants[i - b->nfields].payload;
            const char *held = zr_mf_held(t, buf, sizeof(buf));
            const ZcMfType *h = held ? zr_mf_find(now, held) : NULL;
            if (h && zr_mf_changed(old, now, held, depth + 1, NULL))
            {
                if (via) *via = h->zc_name ? h->zc_name : h->c_name;
                return 1;
            }
        }
        return 0;
    }

    static const char *zr_mf_kind_name(unsigned kind)
    {
        switch (kind)
        {
        case 1: return "struct";
        case 2: return "union";
        case 3: return "enum";
        case 4: return "enum with payloads";
        case 5: return "vector type";
        default: return "type";
        }
    }

    // One ", "-separated item of a type's line in the report.
    static void zr_mf_item(FILE *out, int *first, const char *fmt, ...)
    {
        fputs(*first ? ": " : ", ", out);
        *first = 0;
        va_list ap;
        va_start(ap, fmt);
        vfprintf(out, fmt, ap);
        va_end(ap);
    }

    // What differs between two descriptions of a type, on one line.
    static void zr_mf_report_type(FILE *out, const ZcMfType *a, const ZcMfType *b)
    {
        int first = 1;
        fprintf(out, "reload:   %s", zr_s(b->zc_name ? b->zc_name : b->c_name));
        if (a->kind != b->kind)
            zr_mf_item(out, &first, "now a %s (was a %s)", zr_mf_kind_name(b->kind),
                       zr_mf_kind_name(a->kind));
        if (a->size != b->size)
            zr_mf_item(out, &first, "size %u -> %u bytes", a->size, b->size);
        if (a->align != b->align)
            zr_mf_item(out, &first, "alignment %u -> %u", a->align, b->align);

        // Each field of the new version, in order. A run of fields that only moved, all by
        // the same number of bytes (everything after an added field, say), is one item:
        // shifted down (to higher offsets) or up.
        unsigned run = 0;          // fields in the run so far
        long long run_delta = 0;   // bytes each moved by
        const ZcMfField *run_first = NULL, *run_last = NULL, *run_was = NULL;
        for (unsigned i = 0; i <= b->nfields; i++)
        {
            const ZcMfField *y = i < b->nfields ? &b->fields[i] : NULL, *x = NULL;
            for (unsigned j = 0; y && j < a->nfields && !x; j++)
                if (strcmp(zr_s(a->fields[j].name), zr_s(y->name)) == 0) x = &a->fields[j];
            int only_moved = x && x->offset != y->offset && !strcmp(zr_s(x->type), zr_s(y->type)) &&
                             x->size == y->size && x->bits == y->bits;
            long long delta = only_moved ? (long long)y->offset - (long long)x->offset : 0;
            if (run && !(only_moved && delta == run_delta))
            {
                if (run == 1)
                    zr_mf_item(out, &first, "%s moved from byte %u to %u", zr_s(run_first->name),
                               run_was->offset, run_first->offset);
                else
                    zr_mf_item(out, &first, "%u fields shifted %s %lld bytes (%s to %s)", run,
                               run_delta < 0 ? "up" : "down",
                               run_delta < 0 ? -run_delta : run_delta, zr_s(run_first->name),
                               zr_s(run_last->name));
                run = 0;
            }
            if (!y) break;
            if (only_moved)
            {
                if (!run)
                {
                    run_first = y;
                    run_was = x;
                    run_delta = delta;
                }
                run_last = y;
                run++;
                continue;
            }
            if (!x)
            {
                if (y->bits)
                    zr_mf_item(out, &first, "%s added (%u bits)", zr_s(y->name), y->bits);
                else
                    zr_mf_item(out, &first, "%s added at byte %u", zr_s(y->name), y->offset);
                continue;
            }
            if (strcmp(zr_s(x->type), zr_s(y->type)))
                zr_mf_item(out, &first, "%s retyped from %s to %s", zr_s(y->name), zr_s(x->type),
                           zr_s(y->type));
            else if (x->size != y->size)
                zr_mf_item(out, &first, "%s resized from %u to %u bytes", zr_s(y->name), x->size,
                           y->size);
            if (x->offset != y->offset)
                zr_mf_item(out, &first, "%s moved from byte %u to %u", zr_s(y->name), x->offset,
                           y->offset);
            if (x->bits != y->bits)
                zr_mf_item(out, &first, "%s resized from %u to %u bits", zr_s(y->name), x->bits,
                           y->bits);
        }
        for (unsigned j = 0; j < a->nfields; j++)
        {
            int kept = 0;
            for (unsigned i = 0; i < b->nfields && !kept; i++)
                kept = strcmp(zr_s(a->fields[j].name), zr_s(b->fields[i].name)) == 0;
            if (!kept) zr_mf_item(out, &first, "%s removed", zr_s(a->fields[j].name));
        }
        for (unsigned i = 0; i < b->nvariants; i++)
        {
            const ZcMfVariant *y = &b->variants[i], *x = NULL;
            for (unsigned j = 0; j < a->nvariants && !x; j++)
                if (strcmp(zr_s(a->variants[j].name), zr_s(y->name)) == 0) x = &a->variants[j];
            if (!x)
            {
                zr_mf_item(out, &first, "%s added (= %lld)", zr_s(y->name), y->value);
                continue;
            }
            if (x->value != y->value)
                zr_mf_item(out, &first, "%s renumbered from %lld to %lld", zr_s(y->name), x->value,
                           y->value);
            if (strcmp(zr_s(x->payload), zr_s(y->payload)))
                zr_mf_item(out, &first, "%s carries %s (was %s)", zr_s(y->name),
                           y->payload ? y->payload : "nothing", x->payload ? x->payload : "nothing");
        }
        for (unsigned j = 0; j < a->nvariants; j++)
        {
            int kept = 0;
            for (unsigned i = 0; i < b->nvariants && !kept; i++)
                kept = strcmp(zr_s(a->variants[j].name), zr_s(b->variants[i].name)) == 0;
            if (!kept) zr_mf_item(out, &first, "%s removed", zr_s(a->variants[j].name));
        }
        if (first) fputs(": fields or variants reordered", out);
        fputc('\n', out);
    }

    static const ZcMfGlobal *zr_global_find(const ZcMfGlobal *g, unsigned n, const char *name)
    {
        for (unsigned i = 0; i < n; i++)
            if (strcmp(zr_s(g[i].name), zr_s(name)) == 0) return &g[i];
        return NULL;
    }

    // The type `g` holds by value is in a manifest and changed between the two.
    static int zr_global_type_changed(const ZcManifest *old, const ZcManifest *now,
                                      const ZcMfGlobal *g, const char **type)
    {
        static char buf[256];
        const char *held = zr_mf_held(g->type, buf, sizeof(buf));
        if (!held || !old || !now) return 0;
        if (type) *type = held;
        return zr_mf_changed(old, now, held, 0, NULL);
    }

    // What changed between two versions' types and globals, or nothing if none did.
    static void zr_mf_report(FILE *out, const ZcManifest *old, const ZcManifest *now, int version)
    {
        if (!old || !now) return;
        int header = 0;
#define ZR_MF_HEADER() \
        do { if (!header) { fprintf(out, "reload: changes in version %d:\n", version); header = 1; } } while (0)

        // Types whose own description changed.
        for (unsigned i = 0; i < now->ntypes; i++)
        {
            const ZcMfType *b = &now->types[i], *a = zr_mf_find(old, b->c_name);
            if (a && !zr_mf_same(a, b))
            {
                ZR_MF_HEADER();
                zr_mf_report_type(out, a, b);
            }
        }
        // Types added and removed.
        int any = 0;
        for (unsigned i = 0; i < now->ntypes; i++)
        {
            const ZcMfType *b = &now->types[i];
            if (zr_mf_find(old, b->c_name)) continue;
            ZR_MF_HEADER();
            fprintf(out, any ? ", %s" : "reload:   added: %s", zr_s(b->zc_name ? b->zc_name : b->c_name));
            any = 1;
        }
        if (any) fputc('\n', out);
        any = 0;
        for (unsigned i = 0; i < old->ntypes; i++)
        {
            const ZcMfType *a = &old->types[i];
            if (zr_mf_find(now, a->c_name)) continue;
            ZR_MF_HEADER();
            fprintf(out, any ? ", %s" : "reload:   removed: %s", zr_s(a->zc_name ? a->zc_name : a->c_name));
            any = 1;
        }
        if (any) fputc('\n', out);
        // Types the same themselves, holding by value one that changed.
        any = 0;
        for (unsigned i = 0; i < now->ntypes; i++)
        {
            const ZcMfType *b = &now->types[i], *a = zr_mf_find(old, b->c_name);
            const char *via = NULL;
            if (!a || !zr_mf_same(a, b) || !zr_mf_changed(old, now, b->c_name, 0, &via)) continue;
            ZR_MF_HEADER();
            fprintf(out, any ? ", %s (holds %s)" : "reload:   also changed: %s (holds %s)",
                    zr_s(b->zc_name ? b->zc_name : b->c_name), zr_s(via));
            any = 1;
        }
        if (any) fputc('\n', out);
        // Globals added, removed and retyped. A retyped one starts again from its initial
        // value; the others keep theirs.
        int first = 1;
        for (unsigned i = 0; i < now->nglobals; i++)
        {
            const ZcMfGlobal *b = &now->globals[i];
            if (b->flags & 2) continue; // a vtable: refreshed, not the program's state
            const ZcMfGlobal *a = zr_global_find(old->globals, old->nglobals, b->name);
            const char *held = NULL;
            int same = a && !strcmp(zr_s(a->type), zr_s(b->type)) && a->size == b->size;
            int held_changed = same && zr_global_type_changed(old, now, b, &held);
            if (same && !held_changed) continue;
            ZR_MF_HEADER();
            fputs(first ? "reload:   globals: " : ", ", out);
            first = 0;
            if (held_changed)
                fprintf(out, "%s's type %s changed", zr_s(b->name), held);
            else if (a)
                fprintf(out, "%s retyped from %s to %s", zr_s(b->name), zr_s(a->type),
                        zr_s(b->type));
            else
                fprintf(out, "%s added", zr_s(b->name));
        }
        for (unsigned i = 0; i < old->nglobals; i++)
        {
            const ZcMfGlobal *a = &old->globals[i];
            if ((a->flags & 2) || zr_global_find(now->globals, now->nglobals, a->name)) continue;
            ZR_MF_HEADER();
            fputs(first ? "reload:   globals: " : ", ", out);
            first = 0;
            fprintf(out, "%s removed", zr_s(a->name));
        }
        if (!first) fputc('\n', out);
#undef ZR_MF_HEADER
    }

    static const ZcMfFunc *zr_func_find(const ZcManifest *m, const char *name)
    {
        for (unsigned i = 0; m && i < m->nfuncs; i++)
            if (strcmp(zr_s(m->funcs[i].name), name) == 0) return &m->funcs[i];
        return NULL;
    }

    // ---- Moving state to a new layout -------------------------------------------------
    //
    // When a type the program's state is made of changes, the state's bytes are moved to the
    // new layout using both versions' manifests: fields by name (into nested structs too),
    // arrays element by element, enums by variant name, numbers converted to a new numeric
    // type. A field that is new keeps what the destination already holds (zero, or a
    // global's initial value). What can't be moved is a pointer to a type that changed: the
    // data behind it is in the old layout, and how much of it there is isn't known. A version
    // that would need that is not loaded.

    typedef struct
    {
        int dry;          // only find problems; write nothing
        int problems;     // things that can't be moved
        FILE *notes;      // what was not simply kept, "; "-separated, or NULL
        int nnotes;
        FILE *why;        // the problems, for the refusal message
        const ZcManifest *old;
        const ZcManifest *now;
    } ZrMove;

    static void zr_move_note(ZrMove *mv, const char *path, const char *fmt, ...)
    {
        if (mv->dry || !mv->notes) return;
        fputs(mv->nnotes++ ? ", " : "", mv->notes);
        if (path && *path) fprintf(mv->notes, "%s ", path);
        va_list ap;
        va_start(ap, fmt);
        vfprintf(mv->notes, fmt, ap);
        va_end(ap);
    }

    static void zr_move_problem(ZrMove *mv, const char *path, const char *fmt, ...)
    {
        if (mv->why)
        {
            fputs(mv->problems ? "; " : "", mv->why);
            fprintf(mv->why, "%s ", path && *path ? path : "the state");
            va_list ap;
            va_start(ap, fmt);
            vfprintf(mv->why, fmt, ap);
            va_end(ap);
        }
        mv->problems++;
    }

    // C's numeric types, for converting a value whose type changed.
    typedef struct { const char *name; unsigned size; int is_float; int is_signed; } ZrNum;
    static const ZrNum zr_nums[] = {
        {"int8_t", 1, 0, 1}, {"uint8_t", 1, 0, 0}, {"int16_t", 2, 0, 1}, {"uint16_t", 2, 0, 0},
        {"int32_t", 4, 0, 1}, {"uint32_t", 4, 0, 0}, {"int64_t", 8, 0, 1}, {"uint64_t", 8, 0, 0},
        {"char", sizeof(char), 0, (char)-1 < 0}, {"signed char", 1, 0, 1}, {"unsigned char", 1, 0, 0},
        {"short", sizeof(short), 0, 1}, {"unsigned short", sizeof(short), 0, 0},
        {"int", sizeof(int), 0, 1}, {"unsigned int", sizeof(int), 0, 0}, {"unsigned", sizeof(int), 0, 0},
        {"long", sizeof(long), 0, 1}, {"unsigned long", sizeof(long), 0, 0},
        {"long long", sizeof(long long), 0, 1}, {"unsigned long long", sizeof(long long), 0, 0},
        {"size_t", sizeof(size_t), 0, 0}, {"ptrdiff_t", sizeof(ptrdiff_t), 0, 1},
        {"intptr_t", sizeof(intptr_t), 0, 1}, {"uintptr_t", sizeof(uintptr_t), 0, 0},
        {"bool", sizeof(_Bool), 0, 0}, {"_Bool", sizeof(_Bool), 0, 0},
        {"float", sizeof(float), 1, 1}, {"double", sizeof(double), 1, 1},
    };

    static const ZrNum *zr_num(const char *type)
    {
        for (size_t i = 0; i < sizeof(zr_nums) / sizeof(zr_nums[0]); i++)
            if (strcmp(zr_nums[i].name, type) == 0) return &zr_nums[i];
        return NULL;
    }

    static long double zr_num_read(const ZrNum *n, const unsigned char *p, int *is_int, long long *i,
                                   unsigned long long *u)
    {
        *is_int = !n->is_float;
        if (n->is_float)
        {
            if (n->size == sizeof(float)) { float f; memcpy(&f, p, sizeof f); return f; }
            double d; memcpy(&d, p, sizeof d); return d;
        }
        unsigned long long raw = 0;
        switch (n->size)
        {
        case 1: { uint8_t v; memcpy(&v, p, 1); raw = v; if (n->is_signed) *i = (int8_t)v; break; }
        case 2: { uint16_t v; memcpy(&v, p, 2); raw = v; if (n->is_signed) *i = (int16_t)v; break; }
        case 4: { uint32_t v; memcpy(&v, p, 4); raw = v; if (n->is_signed) *i = (int32_t)v; break; }
        default: { uint64_t v; memcpy(&v, p, 8); raw = v; if (n->is_signed) *i = (int64_t)v; break; }
        }
        if (!n->is_signed) *i = (long long)raw;
        *u = n->is_signed ? (unsigned long long)*i : raw;
        return n->is_signed ? (long double)*i : (long double)raw;
    }

    static void zr_num_write(const ZrNum *n, unsigned char *p, long double f, int is_int, long long i,
                             unsigned long long u)
    {
        if (n->is_float)
        {
            if (n->size == sizeof(float)) { float v = (float)f; memcpy(p, &v, sizeof v); }
            else { double v = (double)f; memcpy(p, &v, sizeof v); }
            return;
        }
        unsigned long long raw = is_int ? (n->is_signed ? (unsigned long long)i : u)
                                        : (unsigned long long)(long long)f;
        switch (n->size)
        {
        case 1: { uint8_t v = (uint8_t)raw; memcpy(p, &v, 1); break; }
        case 2: { uint16_t v = (uint16_t)raw; memcpy(p, &v, 2); break; }
        case 4: { uint32_t v = (uint32_t)raw; memcpy(p, &v, 4); break; }
        default: { uint64_t v = (uint64_t)raw; memcpy(p, &v, 8); break; }
        }
    }

    static long long zr_int_read(const unsigned char *p, unsigned size)
    {
        switch (size)
        {
        case 1: { int8_t v; memcpy(&v, p, 1); return v; }
        case 2: { int16_t v; memcpy(&v, p, 2); return v; }
        case 4: { int32_t v; memcpy(&v, p, 4); return v; }
        default: { int64_t v; memcpy(&v, p, 8); return v; }
        }
    }

    static void zr_int_write(unsigned char *p, unsigned size, long long value)
    {
        switch (size)
        {
        case 1: { int8_t v = (int8_t)value; memcpy(p, &v, 1); break; }
        case 2: { int16_t v = (int16_t)value; memcpy(p, &v, 2); break; }
        case 4: { int32_t v = (int32_t)value; memcpy(p, &v, 4); break; }
        default: { int64_t v = (int64_t)value; memcpy(p, &v, 8); break; }
        }
    }

    // "T[N]...": the element type ("T..." with the first [N] removed) into `elem`, and N.
    static int zr_array_of(const char *type, char *elem, size_t size, unsigned *count)
    {
        const char *lb = strchr(type, '[');
        if (!lb || strchr(type, '(')) return 0;
        const char *rb = strchr(lb, ']');
        if (!rb) return 0;
        *count = (unsigned)strtoul(lb + 1, NULL, 10);
        size_t head = (size_t)(lb - type);
        while (head > 0 && type[head - 1] == ' ') head--;
        if (head + strlen(rb + 1) + 1 > size || *count == 0) return 0;
        memcpy(elem, type, head);
        strcpy(elem + head, rb + 1);
        return 1;
    }

    // The type a pointer type points to ("State" for "State*"), into `buf`, or NULL.
    static const char *zr_pointee(const char *type, char *buf, size_t size)
    {
        if (strchr(type, '(')) return NULL; // a function pointer
        size_t n = strlen(type);
        while (n > 0 && type[n - 1] == ' ') n--;
        if (n == 0 || type[n - 1] != '*') return NULL;
        n--;
        while (n > 0 && type[n - 1] == ' ') n--;
        const char *t = type;
        if (strncmp(t, "const ", 6) == 0) { t += 6; n -= 6; }
        if (strncmp(t, "struct ", 7) == 0) { t += 7; n -= 7; }
        if (n == 0 || n >= size) return NULL;
        memcpy(buf, t, n);
        buf[n] = 0;
        return buf;
    }

    static const ZcMfField *zr_field_find(const ZcMfType *t, const char *name)
    {
        for (unsigned i = 0; i < t->nfields; i++)
            if (strcmp(zr_s(t->fields[i].name), name) == 0) return &t->fields[i];
        return NULL;
    }

    static const ZcMfVariant *zr_variant_by_name(const ZcMfType *t, const char *name)
    {
        for (unsigned i = 0; i < t->nvariants; i++)
            if (strcmp(zr_s(t->variants[i].name), name) == 0) return &t->variants[i];
        return NULL;
    }

    static const ZcMfVariant *zr_variant_by_value(const ZcMfType *t, long long value)
    {
        for (unsigned i = 0; i < t->nvariants; i++)
            if (t->variants[i].value == value) return &t->variants[i];
        return NULL;
    }

    static void zr_move_value(ZrMove *mv, const char *path, const char *otype, unsigned osize,
                              const unsigned char *src, const char *ntype, unsigned nsize,
                              unsigned char *dst, int depth);

    // The size of a value of C type `type`, if the manifests or zr_nums know it, else 0.
    static unsigned zr_type_size(const ZcManifest *m, const char *type)
    {
        const ZcMfType *t = zr_mf_find(m, type);
        if (t) return t->size;
        const ZrNum *n = zr_num(type);
        if (n) return n->size;
        char buf[256];
        if (zr_pointee(type, buf, sizeof buf)) return sizeof(void *);
        return 0;
    }

    // A struct or union described by both manifests, moved field by field.
    static void zr_move_fields(ZrMove *mv, const char *path, const ZcMfType *ot,
                               const unsigned char *src, const ZcMfType *nt, unsigned char *dst,
                               int depth)
    {
        char sub[512];
        for (unsigned i = 0; i < nt->nfields; i++)
        {
            const ZcMfField *nf = &nt->fields[i];
            const ZcMfField *of = zr_field_find(ot, zr_s(nf->name));
            snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(nf->name));
            if (!of)
            {
                zr_move_note(mv, sub, "added");
                continue;
            }
            if (of->bits || nf->bits)
            {
                // A bit-field has no address of its own: it is kept only if nothing about it
                // changed, and the whole struct is copied then (zr_move_value).
                zr_move_note(mv, sub, "(a bit-field) not carried");
                continue;
            }
            zr_move_value(mv, sub, zr_s(of->type), of->size, src + of->offset, zr_s(nf->type),
                          nf->size, dst + nf->offset, depth + 1);
        }
        for (unsigned j = 0; j < ot->nfields; j++)
        {
            if (zr_field_find(nt, zr_s(ot->fields[j].name))) continue;
            snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(ot->fields[j].name));
            zr_move_note(mv, sub, "dropped");
        }
    }

    // One value of type `otype` (osize bytes at src) into `ntype` (nsize bytes at dst).
    static void zr_move_value(ZrMove *mv, const char *path, const char *otype, unsigned osize,
                              const unsigned char *src, const char *ntype, unsigned nsize,
                              unsigned char *dst, int depth)
    {
        if (depth > 64) return;
        const ZcMfType *ot = zr_mf_find(mv->old, otype), *nt = zr_mf_find(mv->now, ntype);
        char obuf[256], nbuf[256];

        // A type the manifests describe.
        if (ot || nt)
        {
            if (!ot || !nt || strcmp(otype, ntype) != 0)
            {
                zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
                return;
            }
            if (!zr_mf_changed(mv->old, mv->now, ntype, 0, NULL))
            {
                if (!mv->dry) memcpy(dst, src, osize < nsize ? osize : nsize);
                return;
            }
            if (ot->kind != nt->kind)
            {
                zr_move_note(mv, path, "is now a different kind of type, not carried");
                return;
            }
            if (nt->kind == 1) // struct
            {
                zr_move_fields(mv, path, ot, src, nt, dst, depth);
                return;
            }
            if (nt->kind == 3) // enum: by variant name
            {
                const ZcMfVariant *ov = zr_variant_by_value(ot, zr_int_read(src, ot->size));
                const ZcMfVariant *nv = ov ? zr_variant_by_name(nt, zr_s(ov->name)) : NULL;
                if (!nv)
                {
                    zr_move_note(mv, path, "was %s, which is gone; not carried",
                                 ov ? zr_s(ov->name) : "an unknown value");
                    return;
                }
                if (!mv->dry) zr_int_write(dst, nt->size, nv->value);
                return;
            }
            if (nt->kind == 4) // enum with payloads: the tag by name, then the payload
            {
                const ZcMfField *otag = zr_field_find(ot, "tag"), *ntag = zr_field_find(nt, "tag");
                const ZcMfField *odat = zr_field_find(ot, "data"), *ndat = zr_field_find(nt, "data");
                if (!otag || !ntag || !odat || !ndat) return;
                const ZcMfVariant *ov = zr_variant_by_value(ot, zr_int_read(src + otag->offset, otag->size));
                const ZcMfVariant *nv = ov ? zr_variant_by_name(nt, zr_s(ov->name)) : NULL;
                if (!nv)
                {
                    zr_move_note(mv, path, "was %s, which is gone; not carried",
                                 ov ? zr_s(ov->name) : "an unknown variant");
                    return;
                }
                if (!mv->dry) zr_int_write(dst + ntag->offset, ntag->size, nv->value);
                if (!ov->payload && !nv->payload) return;
                char sub[512];
                snprintf(sub, sizeof sub, "%s(%s)", path, zr_s(nv->name));
                if (!ov->payload || !nv->payload)
                {
                    zr_move_note(mv, sub, "payload changed, not carried");
                    return;
                }
                unsigned ops = zr_type_size(mv->old, ov->payload), nps = zr_type_size(mv->now, nv->payload);
                if (!ops || !nps || ops > odat->size || nps > ndat->size)
                {
                    zr_move_note(mv, sub, "payload not carried");
                    return;
                }
                zr_move_value(mv, sub, ov->payload, ops, src + odat->offset, nv->payload, nps,
                              dst + ndat->offset, depth + 1);
                return;
            }
            zr_move_note(mv, path, "(a %s) changed, not carried", nt->kind == 2 ? "union" : "vector");
            return;
        }

        // Arrays: element by element.
        unsigned on = 0, nn = 0;
        char oelem[256], nelem[256];
        int oarr = zr_array_of(otype, oelem, sizeof oelem, &on);
        int narr = zr_array_of(ntype, nelem, sizeof nelem, &nn);
        if (oarr || narr)
        {
            if (!oarr || !narr)
            {
                zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
                return;
            }
            unsigned oes = osize / on, nes = nsize / nn;
            unsigned n = on < nn ? on : nn;
            char sub[512];
            // The notes are the first element's, once, as "rocks[]": the others' are the same
            // apart from enum values.
            snprintf(sub, sizeof sub, "%s[]", path);
            for (unsigned i = 0; i < n; i++)
            {
                ZrMove each = *mv;
                if (i > 0) each.notes = NULL;
                zr_move_value(&each, sub, oelem, oes, src + i * oes, nelem, nes, dst + i * nes,
                              depth + 1);
                mv->problems = each.problems;
                mv->nnotes = i == 0 ? each.nnotes : mv->nnotes;
            }
            if (on != nn) zr_move_note(mv, path, "now has %u elements (was %u)", nn, on);
            if (strcmp(oelem, nelem) != 0)
                zr_move_note(mv, path, "elements retyped from %s to %s", oelem, nelem);
            return;
        }

        // Pointers: kept, unless what they point to changed.
        const char *op = zr_pointee(otype, obuf, sizeof obuf);
        const char *np = zr_pointee(ntype, nbuf, sizeof nbuf);
        if (op || np || strchr(otype, '(') || strchr(ntype, '('))
        {
            if (strcmp(otype, ntype) != 0 || osize != nsize)
            {
                zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
                return;
            }
            if (np && zr_mf_find(mv->now, np) && zr_mf_changed(mv->old, mv->now, np, 0, NULL))
            {
                zr_move_problem(mv, path, "points to a %s, whose layout changed", np);
                return;
            }
            if (!mv->dry) memcpy(dst, src, nsize);
            return;
        }

        // Numbers, and C types the manifests don't describe.
        if (strcmp(otype, ntype) == 0 && osize == nsize)
        {
            if (!mv->dry) memcpy(dst, src, nsize);
            return;
        }
        const ZrNum *on_ = zr_num(otype), *nn_ = zr_num(ntype);
        if (on_ && nn_ && on_->size == osize && nn_->size == nsize)
        {
            int is_int = 0;
            long long i = 0;
            unsigned long long u = 0;
            long double f = zr_num_read(on_, src, &is_int, &i, &u);
            if (!mv->dry) zr_num_write(nn_, dst, f, is_int, i, u);
            zr_move_note(mv, path, "converted from %s to %s", otype, ntype);
            return;
        }
        zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
    }

    // Every pointer reachable by value from a value of C type `type` (in fields, array
    // elements and enum payloads), checked: one to a type whose layout changed is a problem,
    // whether or not `type` itself changed.
    static void zr_check_pointers(ZrMove *mv, const char *path, const char *type, int depth)
    {
        if (depth > 64 || !type) return;
        char buf[256], elem[256];
        unsigned n = 0;
        if (zr_array_of(type, elem, sizeof elem, &n))
        {
            char sub[512];
            snprintf(sub, sizeof sub, "%s[]", path);
            zr_check_pointers(mv, sub, elem, depth + 1);
            return;
        }
        const char *p = zr_pointee(type, buf, sizeof buf);
        if (p)
        {
            if (zr_mf_find(mv->now, p) && zr_mf_changed(mv->old, mv->now, p, 0, NULL))
                zr_move_problem(mv, path, "points to a %s, whose layout changed", p);
            return;
        }
        const ZcMfType *t = zr_mf_find(mv->now, type);
        if (!t) return;
        char sub[512];
        for (unsigned i = 0; i < t->nfields; i++)
        {
            if (t->kind == 4) break; // tag and data: the payloads are below
            snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(t->fields[i].name));
            zr_check_pointers(mv, sub, t->fields[i].type, depth + 1);
        }
        for (unsigned i = 0; t->kind == 4 && i < t->nvariants; i++)
        {
            if (!t->variants[i].payload) continue;
            snprintf(sub, sizeof sub, "%s(%s)", path, zr_s(t->variants[i].name));
            zr_check_pointers(mv, sub, t->variants[i].payload, depth + 1);
        }
    }

    // ---- What the host's state is -------------------------------------------------------
    //
    // The state block the host keeps (keep_state) is what the functions it looked up take a
    // pointer to: the one struct, union or enum the manifest describes among their pointer
    // parameters. NULL if there is none; `ambiguous` if there are several.
    static const char *zr_state_type(ZrReloader *r, const ZcManifest *m, int *ambiguous)
    {
        static char found[256];
        char buf[256];
        found[0] = 0;
        *ambiguous = 0;
        if (!m) return NULL;
        for (int i = 0; i < r->fetched_count; i++)
        {
            const ZcMfFunc *f = zr_func_find(m, r->fetched[i]);
            for (unsigned j = 0; f && j < f->nparams; j++)
            {
                const char *t = zr_pointee(zr_s(f->params[j]), buf, sizeof buf);
                if (!t || !zr_mf_find(m, t)) continue;
                if (!found[0]) snprintf(found, sizeof found, "%s", t);
                else if (strcmp(found, t) != 0) *ambiguous = 1;
            }
        }
        return found[0] ? found : NULL;
    }

    // ---- Globals that outlive the code ---------------------------------------------------
    //
    // The module's globals (those `zc transpile --reload` lists in the manifest) are defined
    // when it is compiled with ZC_RELOAD_OWN_GLOBALS and declared extern otherwise. The first
    // version defines them; every later one is compiled to use that version's storage, so
    // the values, and pointers to them, survive the reload. When the globals change (one is
    // added or retyped), the new version defines them again, and the values whose name and
    // type are the same are copied into it. A version that owns globals is never deleted
    // before free(): something may still point into its storage.

    static const ZcManifest *zr_version_manifest(ZrVersion *v)
    {
        const ZcManifest *(*get)(void) =
            (const ZcManifest *(*)(void))tcc_get_symbol(v->tcc, "_zc_manifest");
        const ZcManifest *m = get ? get() : NULL;
        return m && m->format >= 5 ? m : NULL; // the layout this file reads
    }

    static void zr_store_free(ZrReloader *r)
    {
        for (unsigned i = 0; i < r->nstore; i++)
        {
            free((void *)r->store[i].name);
            free((void *)r->store[i].type);
        }
        free(r->store);
        r->store = NULL;
        r->nstore = 0;
    }

    // The globals of `m`, from the version that owns them, as the ones to share from now on.
    static void zr_store_set(ZrReloader *r, const ZcManifest *m)
    {
        zr_store_free(r);
        if (!m || !m->nglobals) return;
        r->store = (ZcMfGlobal *)calloc(m->nglobals, sizeof(ZcMfGlobal));
        if (!r->store) return;
        r->nstore = m->nglobals;
        for (unsigned i = 0; i < m->nglobals; i++)
        {
            r->store[i] = m->globals[i];
            r->store[i].name = zr_strdup(m->globals[i].name);
            r->store[i].type = zr_strdup(m->globals[i].type);
            r->store[i].init = NULL; // the store only needs names, types and addresses
        }
    }

    // Compile the module's C into `v`, defining its globals (`own`) or using the ones in the
    // store. Errors are printed only for a version that defines them: a failure to use the
    // store is retried that way.
    static int zr_compile(ZrReloader *r, ZrVersion *v, int own)
    {
        memset(v, 0, sizeof(*v));
        v->tcc = tcc_new();
        if (!v->tcc) return -1;
        tcc_set_error_func(v->tcc, NULL, own ? zr_on_tcc_error : zr_on_tcc_quiet);
        tcc_set_output_type(v->tcc, TCC_OUTPUT_MEMORY);
        for (int i = 0; i < r->include_count; i++) tcc_add_include_path(v->tcc, r->includes[i]);
        // libtcc can't give code compiled into memory thread-local storage (0.9.27 doesn't
        // know _Thread_local; 0.9.28 refuses it), and std/core.zc and the generated C use it:
        // a thread-local is an ordinary global of the module, shared by its threads.
        tcc_define_symbol(v->tcc, "_Thread_local", "");
        tcc_define_symbol(v->tcc, "__thread", "");
        if (own) tcc_define_symbol(v->tcc, "ZC_RELOAD_OWN_GLOBALS", "1");
        else
            for (unsigned i = 0; i < r->nstore; i++)
                tcc_add_symbol(v->tcc, r->store[i].name, r->store[i].addr);
        if (tcc_add_file(v->tcc, r->c_file) == -1 || zr_relocate(v) < 0)
        {
            zr_version_delete(v);
            return -1;
        }
        // A version owns globals only if it has some.
        const ZcManifest *m = own ? zr_version_manifest(v) : NULL;
        v->owns_globals = m && m->nglobals > 0;
        return 0;
    }

    // `v`, compiled to use the store, really does: each of its globals is one in the store,
    // of the same type, at the store's address (not, say, a variable of the same name that
    // the host exports).
    //
    // Nor may a global's type have changed (a struct it holds rearranged, say): its old bytes
    // can't be read as the new layout.
    static int zr_globals_shared(ZrReloader *r, ZrVersion *v)
    {
        ZcManifest *m = zr_mf_copy(zr_version_manifest(v));
        if (!m) return 0;
        int shared = 1;
        for (unsigned i = 0; i < m->nglobals && shared; i++)
        {
            const ZcMfGlobal *g = &m->globals[i];
            const ZcMfGlobal *s = zr_global_find(r->store, r->nstore, g->name);
            if (!s || strcmp(zr_s(s->type), zr_s(g->type)) || s->size != g->size ||
                s->addr != g->addr || zr_global_type_changed(r->types_now, m, g, NULL))
                shared = 0;
        }
        zr_mf_free(m);
        return shared;
    }

    // What reloading to the version `next` (its manifest `nm`, sorted) would do to the state:
    // the globals (when `next` owns new storage) and the host's block, moved to the new
    // layout. With `dry`, only the problems are found, into `why`; otherwise the state is
    // moved and what was not simply kept is written to `log`, a line per part.
    static int zr_move_state(ZrReloader *r, ZrVersion *next, const ZcManifest *om,
                             const ZcManifest *nm, int dry, FILE *why, FILE *log)
    {
        ZrMove mv;
        memset(&mv, 0, sizeof mv);
        mv.dry = dry;
        mv.why = why;
        mv.old = om;
        mv.now = nm;

        // The functions the host looked up must still take what it passes them.
        for (int i = 0; i < r->fetched_count; i++)
        {
            const ZcMfFunc *a = zr_func_find(om, r->fetched[i]), *b = zr_func_find(nm, r->fetched[i]);
            if (!a || !b) continue;
            int same = !strcmp(zr_s(a->ret), zr_s(b->ret)) && a->nparams == b->nparams;
            for (unsigned j = 0; same && j < a->nparams; j++)
                same = !strcmp(zr_s(a->params[j]), zr_s(b->params[j]));
            if (!same)
                zr_move_problem(&mv, r->fetched[i], "now takes or returns other types, and the "
                                "host calls it the old way");
        }

        // No pointer in the state may lead to a type whose layout changed.
        if (dry)
        {
            for (unsigned i = 0; i < nm->nglobals; i++)
                if (!(nm->globals[i].flags & 2))
                    zr_check_pointers(&mv, zr_s(nm->globals[i].name), nm->globals[i].type, 0);
            int amb = 0;
            const char *st = r->state ? zr_state_type(r, nm, &amb) : NULL;
            char root[256];
            if (st)
            {
                snprintf(root, sizeof root, "%s", st);
                zr_check_pointers(&mv, "state", root, 0);
            }
        }

        // The globals, into the new storage the version defines.
        char *text = NULL;
        size_t len = 0;
        if (next->owns_globals && r->store)
        {
            const ZcManifest *live = zr_version_manifest(next);
            mv.notes = dry ? NULL : open_memstream(&text, &len);
            mv.nnotes = 0;
            for (unsigned i = 0; live && i < live->nglobals; i++)
            {
                const ZcMfGlobal *g = &live->globals[i];
                const ZcMfGlobal *s = zr_global_find(r->store, r->nstore, g->name);
                if (!s || (g->flags & 2)) continue;
                zr_move_value(&mv, zr_s(g->name), zr_s(s->type), s->size,
                              (const unsigned char *)s->addr, zr_s(g->type), g->size,
                              (unsigned char *)g->addr, 0);
            }
            if (mv.notes)
            {
                fclose(mv.notes);
                if (mv.nnotes && log) fprintf(log, "reload: moved the globals: %s\n", text);
                free(text);
                text = NULL;
                mv.notes = NULL;
            }
        }

        // The host's block, in place.
        if (r->state)
        {
            int amb_old = 0, amb_new = 0;
            char was[256] = "", is[256] = "";
            const char *t = zr_state_type(r, om, &amb_old);
            if (t) snprintf(was, sizeof was, "%s", t);
            t = zr_state_type(r, nm, &amb_new);
            if (t) snprintf(is, sizeof is, "%s", t);
            const ZcMfType *nt = is[0] ? zr_mf_find(nm, is) : NULL;
            const ZcMfType *ot = was[0] ? zr_mf_find(om, was) : NULL;
            int changed = was[0] && is[0] &&
                          (strcmp(was, is) != 0 || zr_mf_changed(om, nm, is, 0, NULL));
            if (changed && (amb_old || amb_new))
                zr_move_problem(&mv, "", "can't be moved: the functions the host looked up take "
                                "pointers to more than one type, so which is the state isn't known");
            else if (changed && strcmp(was, is) != 0)
                zr_move_problem(&mv, "", "is now a %s (it was a %s)", is, was);
            else if (changed && nt && nt->size > r->state_size)
                zr_move_problem(&mv, "", "(%s) no longer fits: %u bytes, and the host's block is %zu",
                                is, nt->size, r->state_size);
            else if (changed && nt && ot)
            {
                unsigned char *old = dry ? r->state : (unsigned char *)malloc(ot->size);
                if (!old) return 1;
                if (!dry)
                {
                    memcpy(old, r->state, ot->size);
                    memset(r->state, 0, r->state_size);
                    mv.notes = open_memstream(&text, &len);
                    mv.nnotes = 0;
                }
                zr_move_value(&mv, "", is, ot->size, old, is, nt->size, r->state, 0);
                if (!dry)
                {
                    free(old);
                    fclose(mv.notes);
                    if (log)
                        fprintf(log, "reload: moved the state (%s) to the new layout%s%s\n", is,
                                mv.nnotes ? ": " : "", mv.nnotes ? text : "");
                    free(text);
                    mv.notes = NULL;
                }
            }
        }
        return mv.problems;
    }

    // The vtables in the storage being replaced, to refresh from now on (zr_reset_globals).
    static void zr_keep_old_vtables(ZrReloader *r)
    {
        for (unsigned i = 0; i < r->nstore; i++)
        {
            const ZcMfGlobal *g = &r->store[i];
            if (!(g->flags & 2)) continue;
            ZcMfGlobal *grown = (ZcMfGlobal *)realloc(r->old_vtables, (r->nold_vtables + 1) * sizeof(ZcMfGlobal));
            if (!grown) return;
            r->old_vtables = grown;
            ZcMfGlobal *o = &r->old_vtables[r->nold_vtables++];
            memset(o, 0, sizeof(*o));
            o->name = zr_strdup(g->name);
            o->type = zr_strdup(g->type);
            o->size = g->size;
            o->addr = g->addr;
        }
    }

    // ---- Function pointers that follow the new code ------------------------------------
    //
    // Every loaded version's functions, by address, with their name and C signature. After a
    // reload, a function pointer in the state (a field of a function pointer type, in the
    // host's block or a global, reached by value) that holds one of them is pointed at the
    // new version's function of the same name and signature.

    static char *zr_fn_sig(const ZcMfFunc *f)
    {
        size_t n = strlen(zr_s(f->ret)) + 3;
        for (unsigned j = 0; j < f->nparams; j++) n += strlen(zr_s(f->params[j])) + 2;
        char *sig = (char *)malloc(n);
        if (!sig) return NULL;
        snprintf(sig, n, "%s(", zr_s(f->ret));
        for (unsigned j = 0; j < f->nparams; j++)
        {
            if (j) strcat(sig, ", ");
            strcat(sig, zr_s(f->params[j]));
        }
        strcat(sig, ")");
        return sig;
    }

    static void zr_note_fns(ZrReloader *r, const ZcManifest *m)
    {
        for (unsigned i = 0; m && i < m->nfuncs; i++)
        {
            if (!m->funcs[i].addr) continue;
            if (r->nfns == r->fns_cap)
            {
                unsigned cap = r->fns_cap ? r->fns_cap * 2 : 256;
                struct ZrFn *grown = (struct ZrFn *)realloc(r->fns, cap * sizeof(struct ZrFn));
                if (!grown) return;
                r->fns = grown;
                r->fns_cap = cap;
            }
            r->fns[r->nfns].addr = m->funcs[i].addr;
            r->fns[r->nfns].name = zr_strdup(m->funcs[i].name);
            r->fns[r->nfns].sig = zr_fn_sig(&m->funcs[i]);
            r->nfns++;
        }
    }

    static const struct ZrFn *zr_fn_at(ZrReloader *r, void *addr)
    {
        for (unsigned i = 0; i < r->nfns; i++)
            if (r->fns[i].addr == addr) return &r->fns[i];
        return NULL;
    }

    // Through the value of C type `type` at `p`, every function pointer to an old function,
    // pointed at the new version's (manifest `m`). Each one moved, or kept, is noted in `log`.
    static void zr_repoint(ZrReloader *r, const ZcManifest *m, const char *path, const char *type,
                           unsigned char *p, unsigned size, FILE *log, int *n, int depth)
    {
        if (depth > 64 || !type) return;
        char elem[256], sub[512];
        unsigned count = 0;
        if (zr_array_of(type, elem, sizeof elem, &count))
        {
            unsigned es = size / count;
            for (unsigned i = 0; i < count; i++)
            {
                snprintf(sub, sizeof sub, "%s[%u]", path, i);
                zr_repoint(r, m, sub, elem, p + i * es, es, log, n, depth + 1);
            }
            return;
        }
        if (strstr(type, "(*") && size == sizeof(void *))
        {
            void *fn;
            memcpy(&fn, p, sizeof fn);
            const struct ZrFn *was = fn ? zr_fn_at(r, fn) : NULL;
            const ZcMfFunc *now = was ? zr_func_find(m, was->name) : NULL;
            if (!was || (now && now->addr == fn)) return;
            char *sig = now ? zr_fn_sig(now) : NULL;
            int same = sig && was->sig && !strcmp(sig, was->sig);
            free(sig);
            fputs((*n)++ ? ", " : "reload: function pointers in the state: ", log);
            if (same)
            {
                memcpy(p, &now->addr, sizeof fn);
                fprintf(log, "%s now calls the new %s", path, was->name);
            }
            else
                fprintf(log, "%s still calls the old %s (%s)", path, was->name,
                        now ? "its signature changed" : "it's gone");
            return;
        }
        const ZcMfType *t = zr_mf_find(m, type);
        if (!t) return;
        if (t->kind == 1)
        {
            for (unsigned i = 0; i < t->nfields; i++)
            {
                const ZcMfField *f = &t->fields[i];
                if (f->bits) continue;
                snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(f->name));
                zr_repoint(r, m, sub, f->type, p + f->offset, f->size, log, n, depth + 1);
            }
        }
        else if (t->kind == 4)
        {
            const ZcMfField *tag = zr_field_find(t, "tag"), *data = zr_field_find(t, "data");
            const ZcMfVariant *v = tag ? zr_variant_by_value(t, zr_int_read(p + tag->offset, tag->size)) : NULL;
            unsigned ps = v && v->payload ? zr_type_size(m, v->payload) : 0;
            if (v && ps && data && ps <= data->size)
            {
                snprintf(sub, sizeof sub, "%s(%s)", path, zr_s(v->name));
                zr_repoint(r, m, sub, v->payload, p + data->offset, ps, log, n, depth + 1);
            }
        }
    }

    // After a reload: the function pointers in the host's block and the globals.
    static void zr_repoint_state(ZrReloader *r, FILE *log)
    {
        const ZcManifest *m = r->types_now;
        int n = 0;
        int amb = 0;
        const char *st = r->state ? zr_state_type(r, m, &amb) : NULL;
        const ZcMfType *t = st && !amb ? zr_mf_find(m, st) : NULL;
        if (t && t->size <= r->state_size)
        {
            char root[256];
            snprintf(root, sizeof root, "%s", st);
            zr_repoint(r, m, "state", root, r->state, t->size, log, &n, 0);
        }
        const ZcManifest *live = zr_version_manifest(&r->current);
        for (unsigned i = 0; live && i < live->nglobals; i++)
        {
            const ZcMfGlobal *g = &live->globals[i];
            if (g->flags & 2) continue;
            zr_repoint(r, m, zr_s(g->name), g->type, (unsigned char *)g->addr, g->size, log, &n, 0);
        }
        if (n) fputc('\n', log);
    }

    // Globals back to their initial value: those marked @reset_on_reload, on every reload,
    // and those whose initial value was edited (as hotreload-hx does: an edited initial value
    // is taken to be what was meant). Each is listed in `log`.
    static void zr_reset_globals(ZrReloader *r, FILE *log)
    {
        const ZcManifest *live = zr_version_manifest(&r->current);
        int n = 0;
        for (unsigned i = 0; live && i < live->nglobals; i++)
        {
            const ZcMfGlobal *g = &live->globals[i];
            if (g->flags & 2)
            {
                // A vtable: this version's functions, here and in any old storage of it, so
                // a trait object made by any version calls the newest code.
                if (g->init_value) memcpy(g->addr, g->init_value, g->size);
                for (unsigned j = 0; g->init_value && j < r->nold_vtables; j++)
                {
                    const ZcMfGlobal *o = &r->old_vtables[j];
                    if (!strcmp(zr_s(o->name), zr_s(g->name)) && !strcmp(zr_s(o->type), zr_s(g->type)) &&
                        o->size == g->size)
                        memcpy(o->addr, g->init_value, g->size);
                }
                continue;
            }
            const ZcMfGlobal *was = zr_global_find(r->types_prev->globals, r->types_prev->nglobals, g->name);
            int marked = g->flags & 1;
            int edited = was && strcmp(zr_s(was->init), zr_s(g->init)) != 0;
            if (!marked && !edited) continue;
            if (g->init_value) memcpy(g->addr, g->init_value, g->size);
            else memset(g->addr, 0, g->size);
            fputs(n++ ? ", " : "reload: back to their initial values: ", log);
            if (marked) fprintf(log, "%s (@reset_on_reload)", zr_s(g->name));
            else
                fprintf(log, "%s (initial value edited: %s to %s)", zr_s(g->name),
                        was->init ? was->init : "zero", g->init ? g->init : "zero");
        }
        if (n) fputc('\n', log);
    }

    static int zr_build(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        r->seen = zr_newest(r);
        double t0 = zr_now_ms();

        size_t len = strlen(r->zc) + strlen(r->source) + strlen(r->c_file) +
                     (r->zc_flags ? strlen(r->zc_flags) : 0) + 64;
        char *cmd = (char *)malloc(len);
        if (!cmd) return 0;
        snprintf(cmd, len, "\"%s\" transpile --reload -q %s \"%s\" -o \"%s\" 1>&2", r->zc,
                 r->zc_flags ? r->zc_flags : "", r->source, r->c_file);
        int rc = system(cmd);
        free(cmd);
        if (rc != 0)
        {
            fprintf(stderr, "reload: %s did not build%s\n", r->source,
                    r->current.tcc ? "; still running the previous version" : "");
            return 0;
        }
        double t1 = zr_now_ms();

        // Using the globals already there if it can; defining them again if they changed.
        ZrVersion next;
        int compiled = -1;
        if (r->current.tcc && r->store)
        {
            compiled = zr_compile(r, &next, 0);
            if (compiled == 0 && !zr_globals_shared(r, &next))
            {
                zr_version_delete(&next);
                compiled = -1;
            }
        }
        if (compiled != 0) compiled = zr_compile(r, &next, 1);
        if (compiled != 0)
        {
            fprintf(stderr, "reload: %s did not compile%s\n", r->c_file,
                    r->current.tcc ? "; still running the previous version" : "");
            return 0;
        }

        // Room to keep the version being replaced, before anything about it changes.
        // A version that changes a type the host requires the same is not loaded.
        if (r->current.tcc && r->required_count && r->types_now)
        {
            ZcManifest *m = zr_mf_copy(zr_version_manifest(&next));
            int refused = -1;
            for (int i = 0; m && i < r->required_count && refused < 0; i++)
                if (zr_mf_changed(r->types_now, m, r->required[i], 0, NULL)) refused = i;
            if (refused >= 0)
            {
                zr_mf_report(stderr, r->types_now, m, r->version + 1);
                fprintf(stderr,
                        "reload: %s changed, so this version is not loaded: the running state "
                        "can't be read as the new layout. Restart the program to use it; still "
                        "running version %d\n",
                        r->required[refused], r->version);
                r->refused++;
            }
            zr_mf_free(m);
            if (refused >= 0)
            {
                zr_version_delete(&next);
                return 0;
            }
        }

        // State the new version would have to move: everything must be movable, or it isn't
        // loaded.
        ZcManifest *nm = zr_mf_copy(zr_version_manifest(&next));
        if (r->current.tcc && nm && r->types_now)
        {
            char *why = NULL;
            size_t why_len = 0;
            FILE *wf = open_memstream(&why, &why_len);
            int problems = zr_move_state(r, &next, r->types_now, nm, 1, wf, NULL);
            if (wf) fclose(wf);
            if (problems)
            {
                zr_mf_report(stderr, r->types_now, nm, r->version + 1);
                fprintf(stderr,
                        "reload: this version is not loaded: %s. Restart the program to use it; "
                        "still running version %d\n",
                        why ? why : "the state can't be moved", r->version);
                free(why);
                zr_mf_free(nm);
                zr_version_delete(&next);
                r->refused++;
                return 0;
            }
            free(why);
        }

        int keep_current = r->current.tcc && (r->keep_old || r->current.owns_globals);
        if (keep_current && r->old_count == r->old_cap)
        {
            int cap = r->old_cap ? r->old_cap * 2 : 8;
            ZrVersion *grown = (ZrVersion *)realloc(r->old, (size_t)cap * sizeof(ZrVersion));
            if (!grown)
            {
                zr_version_delete(&next);
                fprintf(stderr, "reload: out of memory; still running the previous version\n");
                return 0;
            }
            r->old = grown;
            r->old_cap = cap;
        }

        // The version being replaced stops being the program's code here, though it may stay
        // loaded. Its @before_reload functions run first; its destructors don't (they run once,
        // at free(), on the version current then), and the new version's constructors don't
        // either (they ran when the first version loaded): a reload doesn't start the program
        // again. The new version's @after_reload functions run once the state has moved.
        int first = !r->current.tcc;
        if (r->current.tcc)
        {
            zr_version_call(&r->current, "_zc_module_before_reload");
            if (keep_current)
            {
                r->old[r->old_count++] = r->current;
            }
            else
            {
                zr_version_delete(&r->current);
            }
        }
        r->current = next;
        r->version++;

        // The new version's types, to compare with the one it replaces.
        zr_mf_free(r->types_prev);
        r->types_prev = r->types_now;
        r->types_now = nm;

        // The state, moved to the new layout: the globals into the storage the new version
        // defines (if it does), and the host's block in place.
        free(r->moved);
        r->moved = NULL;
        size_t moved_len = 0;
        FILE *log = open_memstream(&r->moved, &moved_len);
        if (r->types_prev && r->types_now)
            zr_move_state(r, &r->current, r->types_prev, r->types_now, 0, NULL, log);
        if (r->current.owns_globals && r->store) zr_keep_old_vtables(r);
        if (r->types_prev && r->types_now && log) zr_reset_globals(r, log);
        zr_note_fns(r, r->types_now);
        if (r->types_prev && r->types_now && log) zr_repoint_state(r, log);
        if (log) fclose(log);
        if (r->current.owns_globals) zr_store_set(r, zr_version_manifest(&r->current));

        zr_version_call(&r->current, first ? "_zc_module_init" : "_zc_module_after_reload");
        if (r->verbose)
        {
            fprintf(stderr, "reload: version %d of %s loaded (zc %.0f ms, tcc %.0f ms)\n",
                    r->version, r->source, t1 - t0, zr_now_ms() - t1);
            zr_report_kept(r);
            zr_mf_report(stderr, r->types_prev, r->types_now, r->version);
            if (r->moved) fputs(r->moved, stderr);
        }
        return 1;
    }

    static int zr_poll(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        int64_t newest = zr_newest(r);
        if (newest == r->seen) return 0;
        if (r->verbose) fprintf(stderr, "reload: %s changed, rebuilding\n", r->source);
        return zr_build(h);
    }

    // A name the host looks up is a function it will call, with the state it keeps.
    static void *zr_symbol(void *h, const char *name)
    {
        ZrReloader *r = (ZrReloader *)h;
        int known = 0;
        for (int i = 0; i < r->fetched_count && !known; i++) known = !strcmp(r->fetched[i], name);
        if (!known && r->fetched_count == r->fetched_cap)
        {
            int cap = r->fetched_cap ? r->fetched_cap * 2 : 8;
            char **grown = (char **)realloc(r->fetched, (size_t)cap * sizeof(char *));
            if (grown) { r->fetched = grown; r->fetched_cap = cap; }
        }
        if (!known && r->fetched_count < r->fetched_cap) r->fetched[r->fetched_count++] = zr_strdup(name);
        if (!r->current.tcc) return NULL;
        return tcc_get_symbol(r->current.tcc, name);
    }

    static const void *zr_manifest(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        const ZcManifest *(*get)(void) =
            r->current.tcc ? (const ZcManifest *(*)(void))tcc_get_symbol(r->current.tcc, "_zc_manifest") : NULL;
        return get ? get() : NULL;
    }

    static void zr_keep_state(void *h, void *state, size_t size)
    {
        ZrReloader *r = (ZrReloader *)h;
        r->state = (unsigned char *)state;
        r->state_size = size;
    }

    static void zr_print_changes(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        zr_mf_report(stdout, r->types_prev, r->types_now, r->version);
        if (r->moved) fputs(r->moved, stdout);
    }

    static int zr_type_changed(void *h, const char *name)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (r->version < 2) return 0;
        // Without both manifests nothing can be ruled out.
        if (!r->types_prev || !r->types_now) return 1;
        return zr_mf_changed(r->types_prev, r->types_now, name, 0, NULL);
    }

    static int zr_version(void *h) { return ((ZrReloader *)h)->version; }
    static int zr_refused(void *h) { return ((ZrReloader *)h)->refused; }
    static int zr_kept(void *h) { return ((ZrReloader *)h)->old_count; }

    static void zr_free(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (!r) return;
        zr_version_call(&r->current, "_zc_module_fini");
        for (int i = 0; i < r->old_count; i++) zr_version_delete(&r->old[i]);
        free(r->old);
        zr_version_delete(&r->current);
        zr_mf_free(r->types_now);
        zr_mf_free(r->types_prev);
        zr_store_free(r);
        for (int i = 0; i < r->include_count; i++) free(r->includes[i]);
        for (int i = 0; i < r->required_count; i++) free(r->required[i]);
        for (int i = 0; i < r->fetched_count; i++) free(r->fetched[i]);
        free(r->fetched);
        free(r->moved);
        for (unsigned i = 0; i < r->nold_vtables; i++)
        {
            free((void *)r->old_vtables[i].name);
            free((void *)r->old_vtables[i].type);
        }
        free(r->old_vtables);
        for (unsigned i = 0; i < r->nfns; i++)
        {
            free(r->fns[i].name);
            free(r->fns[i].sig);
        }
        free(r->fns);
        free(r->zc);
        free(r->zc_flags);
        free(r->source);
        free(r->c_file);
        free(r->watch_dir);
        free(r);
    }
}

extern fn zr_new(source: const char*, c_file: const char*) -> void*;
extern fn zr_set_zc(h: void*, zc: const char*);
extern fn zr_set_zc_flags(h: void*, flags: const char*);
extern fn zr_set_source(h: void*, source: const char*);
extern fn zr_set_watch(h: void*, dir: const char*);
extern fn zr_set_keep_old(h: void*, keep: c_int);
extern fn zr_set_verbose(h: void*, verbose: c_int);
extern fn zr_add_include(h: void*, dir: const char*) -> c_int;
extern fn zr_require_same(h: void*, type_name: const char*) -> c_int;
extern fn zr_refused(h: void*) -> c_int;
extern fn zr_keep_state(h: void*, state: void*, size: usize);
extern fn zr_build(h: void*) -> c_int;
extern fn zr_poll(h: void*) -> c_int;
extern fn zr_symbol(h: void*, name: const char*) -> void*;
extern fn zr_manifest(h: void*) -> const void*;
extern fn zr_print_changes(h: void*);
extern fn zr_type_changed(h: void*, name: const char*) -> c_int;
extern fn zr_version(h: void*) -> c_int;
extern fn zr_kept(h: void*) -> c_int;
extern fn zr_free(h: void*);

/// A module rebuilt from Zen C source and reloaded into this process. See the top of
/// std/reload.zc.
struct Reloader {
    handle: void*;
}

impl Reloader {
    /// A reloader for the module whose root file is `source`; its C goes to `c_file`.
    /// Nothing is built until build() or poll().
    fn new(source: const char*, c_file: const char*) -> Reloader {
        return Reloader { handle: zr_new(source, c_file) };
    }

    /// The zc to run (default "zc", found on PATH).
    fn set_zc(self, zc: const char*) { zr_set_zc(self.handle, zc); }

    /// More flags for `zc transpile`, as one string (for example "-D DEV").
    fn set_zc_flags(self, flags: const char*) { zr_set_zc_flags(self.handle, flags); }

    /// Build a different root file from now on.
    fn set_source(self, source: const char*) { zr_set_source(self.handle, source); }

    /// The directory whose .zc files (searched recursively) are watched by poll(). By
    /// default, the source's directory.
    fn watch(self, dir: const char*) { zr_set_watch(self.handle, dir); }

    /// Keep old versions loaded until free() (the default), or delete each when the next
    /// one loads.
    fn keep_old(self, keep: bool) { zr_set_keep_old(self.handle, keep ? 1 : 0); }

    /// Print a line for each version loaded (the default) or not. Errors are always printed.
    fn verbose(self, on: bool) { zr_set_verbose(self.handle, on ? 1 : 0); }

    /// A directory for the C compiler to search for the module's #includes.
    fn add_include(self, dir: const char*) -> bool { return zr_add_include(self.handle, dir) != 0; }

    /// The block of `size` bytes the host passes to the module's functions, the same one
    /// every time. Its type is what the functions the host looked up (symbol()) take a
    /// pointer to. When a reload changes that type, the block's contents are moved to the
    /// new layout in place: fields by name, enums by variant name, numbers converted, a new
    /// field zero. A version whose state can't be moved (a pointer to a type that changed,
    /// a type that no longer fits in `size`) is not loaded, and the reload says why.
    fn keep_state(self, state: void*, size: usize) { zr_keep_state(self.handle, state, size); }

    /// Don't load a version in which the type `type_name` (its C name) changed, itself or
    /// through a type it holds by value: for state the host keeps across reloads and can't
    /// rebuild. The running version stays in use, and the reload prints what changed and
    /// that the program must be restarted. A host that can rebuild its state instead asks
    /// type_changed() after a reload, and resets it.
    fn require_same(self, type_name: const char*) -> bool {
        return zr_require_same(self.handle, type_name) != 0;
    }

    /// How many builds were not loaded because of require_same().
    fn refused(self) -> int { return (int)zr_refused(self.handle); }

    /// Build now. True if a new version was loaded; on failure, the errors are printed and
    /// the version already loaded, if any, stays in use.
    fn build(self) -> bool { return zr_build(self.handle) != 0; }

    /// Build if any watched .zc file changed since the last build. True if a new version
    /// was loaded. Call it when none of the module's code is running.
    fn poll(self) -> bool { return zr_poll(self.handle) != 0; }

    /// The address of `name` in the version loaded now, or NULL. Look again after a
    /// build() or poll() that returned true.
    fn symbol(self, name: const char*) -> void* { return zr_symbol(self.handle, name); }

    /// The version loaded now's description of its types (a `const ZcManifest*`, declared
    /// in this file's C), or NULL.
    fn manifest(self) -> const void* { return zr_manifest(self.handle); }

    /// Print what changed in the types of the version loaded now, compared with the one
    /// before it: structs and enums whose layout or values changed, types added and
    /// removed, and types that hold one that changed by value. Nothing if no type changed.
    /// With verbose() on (the default), each reload prints this to stderr.
    fn print_changes(self) { zr_print_changes(self.handle); }

    /// True if the type `name` (its C name: "State", "Box__int32_t") is not the same in the
    /// version loaded now as in the one before: its layout or values changed, it was added
    /// or removed, or a type it holds by value changed. Memory laid out as the old type
    /// can't be read as the new one. False after the first build.
    fn type_changed(self, name: const char*) -> bool { return zr_type_changed(self.handle, name) != 0; }

    /// How many versions have been loaded.
    fn version(self) -> int { return (int)zr_version(self.handle); }

    /// How many old versions are kept loaded.
    fn kept(self) -> int { return (int)zr_kept(self.handle); }

    /// Delete every version and the reloader.
    fn free(self) {
        zr_free(self.handle);
        self.handle = NULL;
    }
}
