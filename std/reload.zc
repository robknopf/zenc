// Hot reload: a module of Zen C, rebuilt from source and loaded into this process through
// libtcc, for a development host that keeps running while the module's code changes.
//
//     let code = Reloader::new("src/game/game.zc", "build/game.c");
//     code.add_include("third_party/include");   (where the module's #includes are)
//     if !code.build() { /* the errors are printed; fix and save */ }
//     let frame: fn*(void*) = code.symbol("game_frame");
//     ...
//     // between frames, when none of the module's code is running:
//     if code.poll() { frame = code.symbol("game_frame"); }
//     ...
//     code.free();
//
// A build runs `zc transpile --reload` on the source, then compiles the C in memory. If
// either fails, the errors are printed and the version already loaded stays in use.
//
// The module's @constructor functions run when the first version loads, and the current
// version's @destructor functions at free(), as at the start and end of a program: a reload
// doesn't start the program again. Work to redo on each reload goes in @before_reload
// functions (run on the old version, just before it's replaced) and @after_reload ones (run
// on the new version, once the state has moved to it). A global marked @reset_on_reload goes
// back to its initial value on every reload, and one whose initial value was edited takes
// the new value.
//
// State survives reloads, and follows the code when its layout changes. The module's
// globals keep their values: each version uses the storage of the one that defined them, so
// a pointer to a global stays valid too. The host's own block, if it gives it to the
// Reloader (keep_state), keeps its contents. When an edit changes the layout of a type the
// state is made of, the state is moved to the new layout: fields by name (in nested structs
// and arrays too), enums by variant name, numbers converted to a new numeric type; a field
// that is new is zero (a global, its initial value), and one that is gone is dropped. When
// the globals themselves change (one added, or retyped), the new version gets new storage
// with the old values moved into it; a pointer to an old global then points at the old
// storage, which stays loaded.
//
// What can't be moved is data behind a pointer to a type whose layout changed: it is in the
// old layout, and how much of it there is isn't known. A version that would need that, or
// whose functions that the host looked up take other parameters, is not loaded: the running
// version stays in use, and the reload says why and to restart. Each reload says what
// changed in the module's types and globals, and what was done to the state (see
// print_changes()).
//
// Code kept from an old version follows the new code where the Reloader can find it. A trait
// object calls the newest code: its vtable's storage is kept like a global's, and refilled
// with the new version's functions on every reload. A function pointer in the state (a
// field of a function pointer type, in the host's block or a global, reached by value) is
// pointed at the new version's function of the same name, unless its signature changed;
// the reload says which. What it can't find keeps running the old code: a function pointer
// behind another pointer, or handed to a library; a lambda (it keeps the body it was made
// with, as in hotreload-hx); a string literal still points into the old version. So old
// versions stay loaded, by default until free(); keep_old(false) deletes each old version
// when the next one loads instead, for programs that keep nothing like that.
//
// The module's code can call the host's own functions, and any library linked into the
// host, if the host exports its symbols (link it with -rdynamic).
//
// libtcc can't give code compiled into memory thread-local storage, so the module's
// thread-locals are ordinary globals, shared by its threads (a release build keeps them per
// thread).
//
// Needs libtcc (0.9.27 or 0.9.28). `zc build` and `zc run` link it, from the line below; a
// C compiler given the generated C needs `-ltcc -ldl -lpthread -lm`, and either needs `-L`
// for a libtcc outside the system's library path. Not available on Windows yet. It is for
// development hosts, and not written for --misra builds.

//> link: -ltcc -ldl -lpthread -lm

include <libtcc.h>

raw {
    #include <dirent.h>
    #include <stdarg.h>
    #include <stdint.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <sys/stat.h>
    #include <time.h>
    #include <unistd.h>
    #include <setjmp.h>
    #include <signal.h>
    #include <sys/mman.h>
    #include <dlfcn.h>
    #ifdef __linux__
    #include <sys/inotify.h>
    #include <elf.h>
    #include <link.h>
    #include <sys/sysmacros.h>
    #endif
    #if defined(__x86_64__) && !defined(_WIN32)
    #define ZR_FORWARD 1 // old functions can be made to jump to new ones (zr_forward)
    #endif
    #if defined(__x86_64__) && defined(__linux__)
    #define ZR_LOADER 1 // the Reloader loads each version itself (zl_load)
    #endif

    enum { ZR_MAX_INCLUDES = 32, ZR_MAX_REQUIRED = 32 };

    // What `zc transpile --reload` writes about a module's types, returned by its
    // `_zc_manifest()`. The same definitions are in the module's C (codegen_main.c,
    // emit_reload_manifest); a change to them is a change of `format`.
    #ifndef ZC_MANIFEST_TYPES
    #define ZC_MANIFEST_TYPES
    typedef struct { const char *name; const char *type; unsigned offset; unsigned size; unsigned bits; } ZcMfField;
    typedef struct { const char *name; long long value; const char *payload; } ZcMfVariant;
    typedef struct { const char *c_name; const char *zc_name; unsigned kind; unsigned size; unsigned align; unsigned nfields; const ZcMfField *fields; unsigned nvariants; const ZcMfVariant *variants; } ZcMfType;
    typedef struct { const char *name; const char *type; unsigned size; void *addr; const char *init; const void *init_value; unsigned flags; } ZcMfGlobal;
    typedef struct { const char *name; const char *ret; unsigned nparams; const char *const *params; void *addr; } ZcMfFunc;
    typedef struct { unsigned format; const char *zc_version; unsigned ntypes; const ZcMfType *types; unsigned nglobals; const ZcMfGlobal *globals; unsigned nfuncs; const ZcMfFunc *funcs; } ZcManifest;
    #endif

    typedef struct
    {
        TCCState *tcc;
        void *mem;       // the code's memory, ours with libtcc 0.9.27; NULL with 0.9.28
        size_t mem_size; // 0 when not known (0.9.28)
        int owns_globals; // compiled with ZC_RELOAD_OWN_GLOBALS: the globals' storage is here
        struct ZlImage *im; // loaded by the Reloader itself (zl_load), or NULL: by libtcc
        int loaded;       // compiled and loaded (tcc is freed once the Reloader loads it)
    } ZrVersion;

    typedef struct
    {
        char *zc;
        char *zc_flags;
        char *source;
        char *c_file;
        char *watch_dir;
        char *includes[ZR_MAX_INCLUDES];
        char *required[ZR_MAX_REQUIRED]; // types a new version must not change (require_same)
        int required_count;
        int include_count;
        int keep_old;
        int verbose;

        ZrVersion current;
        ZrVersion *old;
        int old_count;
        int old_cap;
        int version;
        int64_t seen; // newest .zc modification time at the last build, or -1
        ZcManifest *types_now;  // a copy of the current version's manifest, or NULL
        ZcManifest *types_prev; // the same for the version before it
        ZcMfGlobal *store;      // the module's globals: in the version that owns them
        ZcMfGlobal *store_prev; // the store before this reload's zr_store_extend, or NULL
        unsigned nstore_prev;
        void **blocks;          // storage made by zr_store_extend, freed at free()
        unsigned nblocks;
        int refused;            // builds not loaded: require_same(), or state that can't move
        char **fetched;         // the names the host looked up with symbol()
        int fetched_count;
        int fetched_cap;
        unsigned char *state;   // the block the host passes to the module (keep_state), or NULL
        size_t state_size;
        char *moved;            // what the last reload did to move state, for print_changes()
        ZcMfGlobal *old_vtables; // vtables in storage no longer the current one (old owners)
        unsigned nold_vtables;
        // Every version's functions: names and signatures shared (strs: one copy of each, as
        // most are the same from one version to the next), found by address (fn_slot).
        struct ZrFn { void *addr; const char *name; const char *sig; } *fns;
        unsigned nfns, fns_cap;
        char **strs;
        unsigned strs_cap, strs_used;
        unsigned *fn_slot; // index + 1 into fns, by address; 0: empty
        unsigned fn_slot_cap;
        unsigned nstore;
        int ino_fd;     // inotify on the watched directory and those under it (Linux), or -1
        int ino_failed; // it couldn't be set up for ino_root: poll() scans instead
        int force_scan; // ZC_RELOAD_SCAN set: scan, never inotify (to test the scanning)
        double last_scan; // when poll() last scanned the files (without inotify), or 0
        int in_memory;    // libtcc loads the versions, not the Reloader (ZC_RELOAD_MEMORY, or
                          // the Reloader couldn't load one)
        char *ino_root; // the directory ino_fd watches
        // Old functions made to jump to the new code (zr_forward): where, the bytes the jump
        // replaced, the name, and whether it still follows the newest version of that name.
        // (its page is left writable once made so: a later jump there needs no mprotect)
        struct ZrFwd { unsigned char *at; unsigned char orig[5]; int next; unsigned char *stub; } *fwd;
        unsigned nfwd, fwd_cap;
        // The names followed: each with its followers (fwd entries, linked by `next`).
        struct ZrFwdName { char *name; int head; } *fwd_names;
        unsigned fwd_names_cap, fwd_names_used;
        // Crash recovery (zr_call): what going back to the version before the last reload
        // needs, and what happened.
        int can_roll_back;           // the last reload can be undone: its version is kept
        unsigned char *state_before; // the host's block before the last reload moved it
        unsigned nfwd_before;        // r->nfwd then: later entries are the replaced version's
        int broken;                  // crashed with nothing to go back to: calls are skipped
        int crashes;
        struct ZrStubs { unsigned char *page; size_t used, size; } *stubs; // far jumps
        unsigned nstubs;
        // What a function's address is (zr_stub_new): each stub, found by its name (the
        // newest of that name) and by its address.
        struct ZrStub
        {
            const char *name;   // interned
            const char *sig;    // its C signature (interned), or NULL: not in a manifest
            unsigned char *code; // in kept memory: jmp *8(%rip), then the target
            const char *why;    // pinned: why it stays where it is (interned)
            int pinned;         // stays on the function it holds (no longer follows its name)
            int changed_in;     // the version whose reload last moved or pinned it
            int made_in;        // the version it was made for
            void *before;       // its target before that reload (to undo it)
        } *fs;
        unsigned nfs, fs_cap;
        unsigned *fs_by_name, *fs_by_addr; // index + 1, or 0
        unsigned fs_name_cap, fs_addr_cap;
    } ZrReloader;

    static char *zr_strdup(const char *s)
    {
        if (!s) return NULL;
        size_t n = strlen(s) + 1;
        char *d = (char *)malloc(n);
        if (d) memcpy(d, s, n);
        return d;
    }

    static double zr_now_ms(void)
    {
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
    }

    static int64_t zr_mtime_ns(const struct stat *st)
    {
    #if defined(__APPLE__)
        return (int64_t)st->st_mtimespec.tv_sec * 1000000000LL + st->st_mtimespec.tv_nsec;
    #else
        return (int64_t)st->st_mtim.tv_sec * 1000000000LL + st->st_mtim.tv_nsec;
    #endif
    }

    // The newest modification time of the .zc files under `dir`, searched recursively, or
    // -1 if there are none.
    static int64_t zr_newest_zc(const char *dir_path, int depth)
    {
        int64_t newest = -1;
        if (depth > 16) return newest;
        DIR *dir = opendir(dir_path);
        if (!dir) return newest;
        struct dirent *entry;
        while ((entry = readdir(dir)) != NULL)
        {
            const char *name = entry->d_name;
            if (name[0] == '.') continue;
            size_t len = strlen(dir_path) + strlen(name) + 2;
            char *path = (char *)malloc(len);
            if (!path) break;
            snprintf(path, len, "%s/%s", dir_path, name);
            struct stat st;
            if (stat(path, &st) == 0)
            {
                int64_t m = -1;
                if (S_ISDIR(st.st_mode))
                {
                    m = zr_newest_zc(path, depth + 1);
                }
                else
                {
                    size_t n = strlen(name);
                    if (n > 3 && strcmp(name + n - 3, ".zc") == 0) m = zr_mtime_ns(&st);
                }
                if (m > newest) newest = m;
            }
            free(path);
        }
        closedir(dir);
        return newest;
    }

    static void zr_on_tcc_error(void *opaque, const char *msg)
    {
        (void)opaque;
        fprintf(stderr, "reload: tcc: %s\n", msg);
    }

    static void zr_on_tcc_quiet(void *opaque, const char *msg)
    {
        (void)opaque;
        (void)msg;
    }

    // libtcc 0.9.27 compiles into memory the caller gives it; 0.9.28 always allocates it.
    static int zr_relocate(ZrVersion *v)
    {
    #ifdef TCC_RELOCATE_AUTO
        int size = tcc_relocate(v->tcc, NULL);
        if (size < 0) return -1;
        long page = sysconf(_SC_PAGESIZE);
        v->mem_size = ((size_t)size + (size_t)page - 1) / (size_t)page * (size_t)page;
        // Mapped, not malloc'd: every version then sits in the mmap region, near the others,
        // so an old function's jump to a new one fits in 32 bits (zr_forward). (malloc puts
        // a block this size in the mmap region or the heap, depending on what was freed.)
        v->mem = mmap(NULL, v->mem_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
        if (v->mem == MAP_FAILED)
        {
            v->mem = NULL;
            v->mem_size = 0;
            return -1;
        }
        return tcc_relocate(v->tcc, v->mem);
    #else
        return tcc_relocate(v->tcc);
    #endif
    }

    // The address of `name` in a version: where the Reloader loaded it, or in tcc's memory.
    struct ZlImage;
    static void *zl_sym(struct ZlImage *im, const char *name);
    static void zl_free(struct ZlImage *im);

    static void *zr_sym(ZrVersion *v, const char *name)
    {
        if (v->im) return zl_sym(v->im, name);
        return v->tcc ? tcc_get_symbol(v->tcc, name) : NULL;
    }

    static void zr_version_call(ZrVersion *v, const char *name)
    {
        if (!v->loaded) return;
        void (*fn)(void) = (void (*)(void))zr_sym(v, name);
        if (fn) fn();
    }

    static void zr_version_delete(ZrVersion *v)
    {
        if (v->im) zl_free(v->im);
        if (v->tcc) tcc_delete(v->tcc);
        if (v->mem)
        {
            munmap(v->mem, v->mem_size);
        }
        memset(v, 0, sizeof(*v));
    }

    // ---- Loading a version ----------------------------------------------------------------
    //
    // tcc compiles each version to an object file, and the Reloader loads it itself, as a
    // linker would: its sections into memory of the Reloader's, its symbols resolved (the
    // store's globals, then the host's and its libraries', then libtcc's runtime helpers), its
    // relocations applied. tcc's object files are ELF on every system it runs on, so this is
    // the same code everywhere; only the relocations are the processor's (x86-64 for now).
    //
    // Loading it ourselves is what lets a version go whole: nothing of it is in a library the
    // system loaded, no file of it is left (the object file is read, then removed), and its
    // memory is ours to release. And it is what lets a debugger see it without a file: each
    // version is registered with the JIT interface gdb and lldb read (the object file, its
    // sections given the addresses they were loaded at), so breakpoints by .zc file and line
    // bind in it, and backtraces and variables read through it.
    //
    // Every version, and everything that outlives one, is in one reservation of address
    // space (zl_space), so a 32-bit PC-relative reference between any two of them reaches.
    // Its first part is kept memory, never released: the stubs, and what old pointers need
    // (zr_stub_new, zr_pool). The rest holds the versions, each where the last one ended, around
    // and around: a released version's addresses aren't given to another until the space has
    // gone round once, so a pointer nothing caught still faults there for a long while
    // instead of running someone else's code.

    #ifdef ZR_LOADER
    // The parts of ELF this reads (not <elf.h>: not every system has it).
    typedef struct { unsigned char e_ident[16]; uint16_t e_type, e_machine; uint32_t e_version; uint64_t e_entry, e_phoff, e_shoff; uint32_t e_flags; uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx; } ZlEhdr;
    typedef struct { uint32_t sh_name, sh_type; uint64_t sh_flags, sh_addr, sh_offset, sh_size; uint32_t sh_link, sh_info; uint64_t sh_addralign, sh_entsize; } ZlShdr;
    typedef struct { uint32_t st_name; unsigned char st_info, st_other; uint16_t st_shndx; uint64_t st_value, st_size; } ZlSym;
    typedef struct { uint64_t r_offset, r_info; int64_t r_addend; } ZlRela;
    enum { ZL_SHT_SYMTAB = 2, ZL_SHT_RELA = 4, ZL_SHT_NOBITS = 8 };
    enum { ZL_SHF_WRITE = 1, ZL_SHF_ALLOC = 2 };
    enum { ZL_SHN_UNDEF = 0, ZL_SHN_LORESERVE = 0xff00, ZL_SHN_ABS = 0xfff1, ZL_SHN_COMMON = 0xfff2 };
    enum { ZL_STT_OBJECT = 1, ZL_STT_FUNC = 2, ZL_STT_SECTION = 3, ZL_STT_FILE = 4 };
    enum { ZL_STB_LOCAL = 0, ZL_STB_WEAK = 2 };
    #define ZL_BIND(info) ((unsigned)(info) >> 4)
    #define ZL_TYPE(info) ((unsigned)(info) & 0xf)
    enum { ZL_R_64 = 1, ZL_R_PC32 = 2, ZL_R_PLT32 = 4, ZL_R_GOTPCREL = 9, ZL_R_32 = 10, ZL_R_32S = 11,
           ZL_R_PC64 = 24, ZL_R_GOTPCRELX = 41, ZL_R_REX_GOTPCRELX = 42 };

    // gdb's JIT interface (gdb/jit.h), which lldb reads too. Weak: a host with a JIT of its
    // own (LLVM) defines them, and then both register in its list.
    typedef struct zr_jit_entry { struct zr_jit_entry *next_entry, *prev_entry; const char *symfile_addr; uint64_t symfile_size; } zr_jit_entry;
    struct zr_jit_descriptor { uint32_t version; uint32_t action_flag; zr_jit_entry *relevant_entry, *first_entry; };
    __attribute__((weak, noinline, used)) void __jit_debug_register_code(void) { __asm__ volatile("" ::: "memory"); }
    __attribute__((weak, used)) struct zr_jit_descriptor __jit_debug_descriptor = {1, 0, 0, 0};

    static void zl_jit_add(zr_jit_entry *e)
    {
        e->prev_entry = NULL;
        e->next_entry = __jit_debug_descriptor.first_entry;
        if (e->next_entry) e->next_entry->prev_entry = e;
        __jit_debug_descriptor.first_entry = e;
        __jit_debug_descriptor.relevant_entry = e;
        __jit_debug_descriptor.action_flag = 1; // JIT_REGISTER_FN
        __jit_debug_register_code();
    }

    static void zl_jit_remove(zr_jit_entry *e)
    {
        if (e->prev_entry) e->prev_entry->next_entry = e->next_entry;
        else __jit_debug_descriptor.first_entry = e->next_entry;
        if (e->next_entry) e->next_entry->prev_entry = e->prev_entry;
        __jit_debug_descriptor.relevant_entry = e;
        __jit_debug_descriptor.action_flag = 2; // JIT_UNREGISTER_FN
        __jit_debug_register_code();
    }

    // The space: kept memory from the start of it, versions in the rest.
    static struct
    {
        unsigned char *base;
        size_t size;      // reserved
        size_t keep_end;  // kept memory is [base, base + keep_end)
        size_t keep_used; // of which in use
        size_t keep_committed;
        size_t ring_next; // where the next version goes (an offset from base)
        struct ZlRange { size_t start, end; } *live; // versions' ranges in use
        unsigned nlive, live_cap;
        int failed; // couldn't be reserved
    } zl_space;

    enum { ZL_SPACE_SIZE = 1536u << 20, ZL_KEEP_SIZE = 256u << 20, ZL_CHUNK = 64u << 10 };

    static int zl_space_ready(void)
    {
        if (zl_space.base) return 1;
        if (zl_space.failed) return 0;
        void *p = mmap(NULL, ZL_SPACE_SIZE, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
        if (p == MAP_FAILED)
        {
            zl_space.failed = 1;
            return 0;
        }
        zl_space.base = (unsigned char *)p;
        zl_space.size = ZL_SPACE_SIZE;
        zl_space.keep_end = ZL_KEEP_SIZE;
        zl_space.ring_next = ZL_KEEP_SIZE;
        return 1;
    }

    static int zl_commit(size_t start, size_t end)
    {
        return mprotect(zl_space.base + start, end - start, PROT_READ | PROT_WRITE | PROT_EXEC) == 0;
    }

    // Kept memory: `size` bytes, zeroed, aligned to `align` (a power of two), never released.
    static void *zl_keep(size_t size, size_t align)
    {
        if (!zl_space_ready()) return NULL;
        if (align < 16) align = 16;
        size_t at = (zl_space.keep_used + align - 1) & ~(align - 1);
        if (at + size > zl_space.keep_end) return NULL;
        size_t need = (at + size + ZL_CHUNK - 1) & ~(size_t)(ZL_CHUNK - 1);
        if (need > zl_space.keep_committed)
        {
            if (!zl_commit(zl_space.keep_committed, need)) return NULL;
            zl_space.keep_committed = need;
        }
        zl_space.keep_used = at + size;
        return zl_space.base + at;
    }

    static int zl_overlaps(size_t start, size_t end)
    {
        for (unsigned i = 0; i < zl_space.nlive; i++)
            if (start < zl_space.live[i].end && zl_space.live[i].start < end) return (int)i;
        return -1;
    }

    // A version's memory: `size` bytes, zeroed, after the last one given out, or NULL.
    static unsigned char *zl_ring_take(size_t size)
    {
        if (!zl_space_ready()) return NULL;
        size = (size + ZL_CHUNK - 1) & ~(size_t)(ZL_CHUNK - 1);
        if (zl_space.nlive == zl_space.live_cap)
        {
            unsigned cap = zl_space.live_cap ? zl_space.live_cap * 2 : 16;
            struct ZlRange *grown = (struct ZlRange *)realloc(zl_space.live, cap * sizeof(*grown));
            if (!grown) return NULL;
            zl_space.live = grown;
            zl_space.live_cap = cap;
        }
        size_t at = zl_space.ring_next;
        int wrapped = 0;
        for (;;)
        {
            if (at + size > zl_space.size)
            {
                if (wrapped) return NULL;
                wrapped = 1;
                at = zl_space.keep_end;
                continue;
            }
            int o = zl_overlaps(at, at + size);
            if (o < 0) break;
            at = zl_space.live[o].end;
            if (wrapped && at >= zl_space.ring_next) return NULL;
        }
        if (!zl_commit(at, at + size)) return NULL;
        zl_space.live[zl_space.nlive++] = (struct ZlRange){at, at + size};
        zl_space.ring_next = at + size;
        return zl_space.base + at;
    }

    // Gives a version's memory back: released, and left reserved (a stray access faults).
    static void zl_ring_give(unsigned char *mem)
    {
        size_t start = (size_t)(mem - zl_space.base);
        for (unsigned i = 0; i < zl_space.nlive; i++)
        {
            if (zl_space.live[i].start != start) continue;
            size_t len = zl_space.live[i].end - start;
            madvise(mem, len, MADV_DONTNEED);
            mprotect(mem, len, PROT_NONE);
            zl_space.live[i] = zl_space.live[--zl_space.nlive];
            return;
        }
    }

    // libtcc's runtime helpers (__va_arg, conversions between floats and 64-bit integers),
    // which tcc's code calls and an object file leaves to the linker: each one found by
    // linking a reference to it in memory, kept for the process.
    static struct ZlHelper { char *name; void *addr; TCCState *tcc; void *mem; } *zl_helpers;
    static unsigned zl_nhelpers;

    static void *zl_helper(const char *name)
    {
        for (unsigned i = 0; i < zl_nhelpers; i++)
            if (!strcmp(zl_helpers[i].name, name)) return zl_helpers[i].addr;
        struct ZlHelper *grown = (struct ZlHelper *)realloc(zl_helpers, (zl_nhelpers + 1) * sizeof(*grown));
        if (!grown) return NULL;
        zl_helpers = grown;
        struct ZlHelper *h = &zl_helpers[zl_nhelpers];
        memset(h, 0, sizeof(*h));
        if (strlen(name) > 200) return NULL;
        // Declared, or (one tcc declares itself, as __va_arg) not.
        char src[320];
        ZrVersion v;
        for (int declared = 1; declared >= 0; declared--)
        {
            memset(&v, 0, sizeof v);
            v.tcc = h->tcc = tcc_new();
            if (!h->tcc) return NULL;
            tcc_set_error_func(h->tcc, NULL, zr_on_tcc_quiet);
            tcc_set_output_type(h->tcc, TCC_OUTPUT_MEMORY);
            snprintf(src, sizeof src, "%s%s%svoid *_zr_helper_ref(void) { return (void *)%s; }\n",
                     declared ? "extern char " : "", declared ? name : "", declared ? "[];\n" : "", name);
            if (tcc_compile_string(h->tcc, src) != -1 && zr_relocate(&v) >= 0 &&
                (h->addr = tcc_get_symbol(h->tcc, name)))
                break;
            tcc_delete(h->tcc);
            if (v.mem) munmap(v.mem, v.mem_size);
            h->tcc = NULL;
        }
        if (!h->tcc) return NULL;
        h->mem = v.mem;
        h->name = zr_strdup(name);
        zl_nhelpers++;
        return h->addr;
    }

    static unsigned zl_name_hash(const char *s)
    {
        unsigned h = 2166136261u;
        for (; *s; s++) h = (h ^ (unsigned char)*s) * 16777619u;
        return h;
    }

    static int zl_fits32(int64_t d) { return d == (int64_t)(int32_t)d; }

    // The pool: read-only objects with no relocation in them (string literals, numbers, a
    // const table of them), in kept memory, one copy of each by its bytes (and its name, if it
    // has one: two const globals are two objects even with the same bytes). A version's code
    // refers to the pool's copy, not its own, so a pointer to a literal kept past a reload
    // doesn't keep the version, and most of a new version's literals are the old one's
    // copies. It grows with what is new: an edited literal, a new one.
    static struct ZlPooled { unsigned hash; unsigned size; const char *name; unsigned char *at; } *zl_pool_tab;
    static unsigned zl_pool_cap, zl_pool_used;
    static size_t zl_pool_bytes;

    static unsigned zl_bytes_hash(const unsigned char *p, size_t n, const char *name)
    {
        unsigned h = 2166136261u;
        for (size_t i = 0; i < n; i++) h = (h ^ p[i]) * 16777619u;
        for (; name && *name; name++) h = (h ^ (unsigned char)*name) * 16777619u;
        return h ^ (unsigned)n;
    }

    // The pool's copy of `n` bytes at `p` (named `name`, or NULL), aligned to `align`.
    static unsigned char *zl_pool(const unsigned char *p, size_t n, const char *name, size_t align)
    {
        if ((zl_pool_used + 1) * 2 > zl_pool_cap)
        {
            unsigned cap = zl_pool_cap ? zl_pool_cap * 2 : 4096;
            struct ZlPooled *t = (struct ZlPooled *)calloc(cap, sizeof(*t));
            if (!t) return NULL;
            for (unsigned i = 0; i < zl_pool_cap; i++)
            {
                if (!zl_pool_tab[i].at) continue;
                unsigned k = zl_pool_tab[i].hash & (cap - 1);
                while (t[k].at) k = (k + 1) & (cap - 1);
                t[k] = zl_pool_tab[i];
            }
            free(zl_pool_tab);
            zl_pool_tab = t;
            zl_pool_cap = cap;
        }
        unsigned h = zl_bytes_hash(p, n, name);
        unsigned k = h & (zl_pool_cap - 1);
        for (; zl_pool_tab[k].at; k = (k + 1) & (zl_pool_cap - 1))
        {
            struct ZlPooled *e = &zl_pool_tab[k];
            if (e->hash == h && e->size == n && ((uintptr_t)e->at & (align - 1)) == 0 &&
                (e->name == name || (e->name && name && !strcmp(e->name, name))) && !memcmp(e->at, p, n))
                return e->at;
        }
        char *nm = name ? zr_strdup(name) : NULL;
        unsigned char *at = (unsigned char *)zl_keep(n, align);
        if (!at || (name && !nm))
        {
            free(nm);
            return NULL;
        }
        memcpy(at, p, n);
        zl_pool_tab[k] = (struct ZlPooled){h, (unsigned)n, nm, at};
        zl_pool_used++;
        zl_pool_bytes += n;
        return at;
    }

    // Where an undefined name of a version is: given by the caller, else the host's.
    typedef void *(*ZlResolve)(void *ctx, const char *name);

    // A version loaded: its object file (kept while it is: a debugger reads it), where each
    // section and symbol is, and its memory.
    typedef struct ZlImage
    {
        unsigned char *img;
        size_t img_size;
        ZlShdr *sh;
        unsigned nsh;
        ZlSym *syms;
        unsigned nsyms;
        const char *strtab;
        uint64_t *sec;     // each section's address, or 0 if it isn't loaded
        uint64_t *addr;    // each symbol's
        unsigned *by_name; // defined symbols by name: index + 1, or 0
        unsigned by_name_cap;
        unsigned char *mem; // in the ring
        size_t mem_size;
        unsigned char *data; // its writable sections, apart (keep_data): they can outlive it
        size_t data_size;
        // Each place it takes the address of one of its own functions (not a call): a pointer
        // in its data (but the manifest's), a GOT entry, a `lea`. They hold the function's
        // address once loaded; the Reloader points them at the function's stub (zl_bind).
        struct ZlFnRef { uint64_t at; unsigned sym; int pc; int64_t addend; } *refs;
        unsigned nrefs, refs_cap;
        zr_jit_entry jit;
        int registered;
    } ZlImage;

    static int zl_note_ref(ZlImage *im, uint64_t at, unsigned sym, int pc, int64_t addend)
    {
        if (im->nrefs == im->refs_cap)
        {
            unsigned cap = im->refs_cap ? im->refs_cap * 2 : 256;
            struct ZlFnRef *grown = (struct ZlFnRef *)realloc(im->refs, cap * sizeof(*grown));
            if (!grown) return 0;
            im->refs = grown;
            im->refs_cap = cap;
        }
        im->refs[im->nrefs++] = (struct ZlFnRef){at, sym, pc, addend};
        return 1;
    }

    // Reference `i` of `im` made to hold `to` (a stub) instead.
    static void zl_bind(ZlImage *im, unsigned i, uint64_t to)
    {
        const struct ZlFnRef *f = &im->refs[i];
        if (f->pc)
        {
            int64_t d = (int64_t)(to + (uint64_t)f->addend - f->at);
            if (zl_fits32(d)) memcpy((void *)(uintptr_t)f->at, &(int32_t){(int32_t)d}, 4);
        }
        else
            memcpy((void *)(uintptr_t)f->at, &(uint64_t){to + (uint64_t)f->addend}, 8);
    }

    // The name of symbol `sym` of `im`.
    static const char *zl_name(const ZlImage *im, unsigned sym) { return im->strtab + im->syms[sym].st_name; }

    // Whether `name` is a function `im` defines.
    static int zl_is_func(ZlImage *im, const char *name)
    {
        if (!im || !im->by_name_cap) return 0;
        unsigned k = zl_name_hash(name) & (im->by_name_cap - 1);
        for (; im->by_name[k]; k = (k + 1) & (im->by_name_cap - 1))
        {
            unsigned s = im->by_name[k] - 1;
            if (!strcmp(im->strtab + im->syms[s].st_name, name)) return ZL_TYPE(im->syms[s].st_info) == ZL_STT_FUNC;
        }
        return 0;
    }

    static int zl_range_cmp(const void *a, const void *b)
    {
        uint64_t x = ((const uint64_t *)a)[0], y = ((const uint64_t *)b)[0];
        return x < y ? -1 : x > y;
    }

    static int zl_err(char *err, size_t n, const char *fmt, ...)
    {
        va_list ap;
        va_start(ap, fmt);
        if (err && n) vsnprintf(err, n, fmt, ap);
        va_end(ap);
        return 0;
    }

    static void zl_free(ZlImage *im)
    {
        if (!im) return;
        if (im->registered) zl_jit_remove(&im->jit);
        if (im->mem) zl_ring_give(im->mem);
        if (im->data) zl_ring_give(im->data);
        free(im->img);
        free(im->sec);
        free(im->addr);
        free(im->by_name);
        free(im->refs);
        free(im);
    }

    // The address of the symbol `name` defined in `im` (a global one before a local one of
    // the same name), or NULL.
    static void *zl_sym(ZlImage *im, const char *name)
    {
        if (!im || !im->by_name_cap) return NULL;
        unsigned k = zl_name_hash(name) & (im->by_name_cap - 1);
        for (; im->by_name[k]; k = (k + 1) & (im->by_name_cap - 1))
        {
            unsigned s = im->by_name[k] - 1;
            if (!strcmp(im->strtab + im->syms[s].st_name, name)) return (void *)(uintptr_t)im->addr[s];
        }
        return NULL;
    }

    // Loads the object file `img` (taken: freed with the image, or on failure). Its writable
    // sections are apart from the rest if `keep_data` (a version that defines the globals:
    // the store may keep them when the rest goes). NULL, with why in `err`, if it can't be;
    // `module_fault` set if that is the module's C's doing (a name nothing defines).
    static ZlImage *zl_load(unsigned char *img, size_t img_size, ZlResolve resolve, void *ctx,
                            int keep_data, int *module_fault, char *err, size_t errn)
    {
        ZlImage *im = (ZlImage *)calloc(1, sizeof(ZlImage));
        unsigned char *need_got = NULL, *need_plt = NULL;
        uint64_t *gslot = NULL, *pslot = NULL; // each symbol's GOT entry and jump, once made
        uint64_t *mf = NULL;
        if (!im)
        {
            free(img);
            zl_err(err, errn, "out of memory");
            return NULL;
        }
        im->img = img;
        im->img_size = img_size;
        ZlEhdr *eh = (ZlEhdr *)img;
        if (img_size < sizeof(ZlEhdr) || memcmp(eh->e_ident, "\177ELF", 4) != 0 || eh->e_ident[4] != 2 ||
            eh->e_type != 1 || eh->e_machine != 62 || eh->e_shentsize != sizeof(ZlShdr) ||
            eh->e_shoff + (uint64_t)eh->e_shnum * sizeof(ZlShdr) > img_size)
        {
            zl_err(err, errn, "not an x86-64 object file");
            goto fail;
        }
        im->sh = (ZlShdr *)(img + eh->e_shoff);
        im->nsh = eh->e_shnum;
        for (unsigned i = 0; i < im->nsh; i++)
        {
            if (im->sh[i].sh_type != ZL_SHT_NOBITS && im->sh[i].sh_offset + im->sh[i].sh_size > img_size)
            {
                zl_err(err, errn, "a section past the end of the file");
                goto fail;
            }
            if (im->sh[i].sh_type == ZL_SHT_SYMTAB && im->sh[i].sh_link < im->nsh)
            {
                im->syms = (ZlSym *)(img + im->sh[i].sh_offset);
                im->nsyms = (unsigned)(im->sh[i].sh_size / sizeof(ZlSym));
                im->strtab = (const char *)img + im->sh[im->sh[i].sh_link].sh_offset;
            }
        }
        if (!im->syms)
        {
            zl_err(err, errn, "no symbol table");
            goto fail;
        }
        im->sec = (uint64_t *)calloc(im->nsh, sizeof(uint64_t));
        im->addr = (uint64_t *)calloc(im->nsyms, sizeof(uint64_t));
        need_got = (unsigned char *)calloc(im->nsyms, 1);
        need_plt = (unsigned char *)calloc(im->nsyms, 1);
        gslot = (uint64_t *)calloc(im->nsyms, sizeof(uint64_t));
        pslot = (uint64_t *)calloc(im->nsyms, sizeof(uint64_t));
        if (!im->sec || !im->addr || !need_got || !need_plt || !gslot || !pslot)
        {
            zl_err(err, errn, "out of memory");
            goto fail;
        }

        // The names it uses and doesn't define.
        for (unsigned s = 1; s < im->nsyms; s++)
        {
            ZlSym *y = &im->syms[s];
            if (y->st_shndx != ZL_SHN_UNDEF) continue;
            const char *name = im->strtab + y->st_name;
            if (!*name) continue;
            void *p = resolve ? resolve(ctx, name) : NULL;
            if (!p) p = dlsym(RTLD_DEFAULT, name);
            if (!p) p = zl_helper(name);
            if (!p && ZL_BIND(y->st_info) != ZL_STB_WEAK)
            {
                *module_fault = 1;
                zl_err(err, errn, "undefined symbol '%s'", name);
                goto fail;
            }
            im->addr[s] = (uint64_t)(uintptr_t)p;
        }
        // GOT entries, and jumps for calls that may not reach (to what the host defines).
        unsigned ngot = 0, nplt = 0;
        for (unsigned i = 0; i < im->nsh; i++)
        {
            ZlShdr *rs = &im->sh[i];
            if (rs->sh_type != ZL_SHT_RELA || rs->sh_info >= im->nsh || !(im->sh[rs->sh_info].sh_flags & ZL_SHF_ALLOC)) continue;
            ZlRela *ra = (ZlRela *)(img + rs->sh_offset);
            for (size_t k = 0; k < rs->sh_size / sizeof(ZlRela); k++)
            {
                unsigned s = (unsigned)(ra[k].r_info >> 32), t = (unsigned)ra[k].r_info;
                if (s >= im->nsyms) continue;
                if ((t == ZL_R_GOTPCREL || t == ZL_R_GOTPCRELX || t == ZL_R_REX_GOTPCRELX) && !need_got[s])
                {
                    need_got[s] = 1;
                    ngot++;
                }
                if (t == ZL_R_PLT32 && im->syms[s].st_shndx == ZL_SHN_UNDEF && !need_plt[s])
                {
                    need_plt[s] = 1;
                    nplt++;
                }
            }
        }

        // Layout: the sections (the writable ones elsewhere if keep_data), common symbols,
        // the GOT, the jumps.
        size_t size = 0, kept = 0;
        for (unsigned i = 0; i < im->nsh; i++)
        {
            ZlShdr *s = &im->sh[i];
            if (!(s->sh_flags & ZL_SHF_ALLOC) || !s->sh_size) continue;
            size_t a = s->sh_addralign > 1 ? (size_t)s->sh_addralign : 1;
            size_t *at = keep_data && (s->sh_flags & ZL_SHF_WRITE) ? &kept : &size;
            *at = (*at + a - 1) & ~(a - 1);
            im->sec[i] = *at + 1; // an offset + 1 for now
            *at += s->sh_size;
        }
        size_t *common_at = keep_data ? &kept : &size;
        for (unsigned s = 1; s < im->nsyms; s++)
        {
            ZlSym *y = &im->syms[s];
            if (y->st_shndx != ZL_SHN_COMMON) continue;
            size_t a = y->st_value > 1 ? (size_t)y->st_value : 1; // a common symbol's alignment
            *common_at = (*common_at + a - 1) & ~(a - 1);
            im->addr[s] = *common_at + 1;
            *common_at += y->st_size;
        }
        size = (size + 15) & ~(size_t)15;
        size_t got_at = size;
        size += (size_t)ngot * 8;
        size_t plt_at = size;
        size += (size_t)nplt * 16;
        im->mem = zl_ring_take(size ? size : 16);
        unsigned char *kmem = kept ? (im->data = zl_ring_take(kept)) : NULL;
        if (!im->mem || (kept && !kmem))
        {
            zl_err(err, errn, "no room left for it in the Reloader's address space");
            goto fail;
        }
        im->mem_size = size;
        im->data_size = kept;
        for (unsigned i = 0; i < im->nsh; i++)
        {
            ZlShdr *s = &im->sh[i];
            if (!im->sec[i]) continue;
            unsigned char *base = keep_data && (s->sh_flags & ZL_SHF_WRITE) ? kmem : im->mem;
            im->sec[i] = (uint64_t)(uintptr_t)(base + im->sec[i] - 1);
            if (s->sh_type != ZL_SHT_NOBITS)
                memcpy((void *)(uintptr_t)im->sec[i], img + s->sh_offset, s->sh_size);
        }
        // Where each defined symbol is, and an index of them by name.
        unsigned named = 0;
        for (unsigned s = 1; s < im->nsyms; s++)
        {
            ZlSym *y = &im->syms[s];
            if (y->st_shndx == ZL_SHN_COMMON)
                im->addr[s] = (uint64_t)(uintptr_t)((keep_data ? kmem : im->mem) + im->addr[s] - 1);
            else if (y->st_shndx == ZL_SHN_ABS)
                im->addr[s] = y->st_value;
            else if (y->st_shndx != ZL_SHN_UNDEF && y->st_shndx < im->nsh && im->sec[y->st_shndx])
                im->addr[s] = im->sec[y->st_shndx] + y->st_value;
            else
                continue;
            unsigned ty = ZL_TYPE(y->st_info);
            if (y->st_name && ty != ZL_STT_SECTION && ty != ZL_STT_FILE) named++;
        }
        im->by_name_cap = 16;
        while (im->by_name_cap < named * 2) im->by_name_cap *= 2;
        im->by_name = (unsigned *)calloc(im->by_name_cap, sizeof(unsigned));
        if (!im->by_name)
        {
            zl_err(err, errn, "out of memory");
            goto fail;
        }
        for (int pass = 0; pass < 2; pass++) // globals first, so a lookup finds them first
            for (unsigned s = 1; s < im->nsyms; s++)
            {
                ZlSym *y = &im->syms[s];
                unsigned ty = ZL_TYPE(y->st_info);
                int local = ZL_BIND(y->st_info) == ZL_STB_LOCAL;
                if (!y->st_name || ty == ZL_STT_SECTION || ty == ZL_STT_FILE || local != pass) continue;
                if (y->st_shndx == ZL_SHN_UNDEF) continue;
                unsigned k = zl_name_hash(im->strtab + y->st_name) & (im->by_name_cap - 1);
                while (im->by_name[k]) k = (k + 1) & (im->by_name_cap - 1);
                im->by_name[k] = s + 1;
            }

        // Read-only objects with no relocation in them: the pool's copies (zl_pool). (The
        // manifest is the version's own: the Reloader reads it, and copies what it keeps.)
        {
            unsigned ncand = 0;
            uint64_t *cand = NULL; // start, end, symbol, has a relocation
            for (int pass = 0; pass < 2; pass++)
            {
                for (unsigned s = 1; s < im->nsyms; s++)
                {
                    ZlSym *y = &im->syms[s];
                    if (ZL_TYPE(y->st_info) != ZL_STT_OBJECT || !y->st_size || y->st_shndx >= im->nsh ||
                        y->st_shndx == ZL_SHN_UNDEF || !im->sec[y->st_shndx])
                        continue;
                    ZlShdr *ys = &im->sh[y->st_shndx];
                    // libtcc 0.9.27 puts string literals with the writable data: there, an
                    // anonymous object ending in a zero byte is taken to be one.
                    int literal = !strncmp(zl_name(im, s), "L.", 2) &&
                                  ((const unsigned char *)(uintptr_t)im->addr[s])[y->st_size - 1] == 0;
                    if ((ys->sh_flags & 4) || ((ys->sh_flags & ZL_SHF_WRITE) && !literal) ||
                        ys->sh_type == ZL_SHT_NOBITS || !strncmp(zl_name(im, s), "_zc_mf", 6))
                        continue;
                    if (pass)
                    {
                        cand[4 * ncand] = im->addr[s];
                        cand[4 * ncand + 1] = im->addr[s] + y->st_size;
                        cand[4 * ncand + 2] = s;
                        cand[4 * ncand + 3] = 0;
                    }
                    ncand++;
                }
                if (!pass)
                {
                    if (!ncand) break;
                    if (!(cand = (uint64_t *)malloc(ncand * 4 * sizeof(uint64_t))))
                    {
                        zl_err(err, errn, "out of memory");
                        goto fail;
                    }
                    ncand = 0;
                }
            }
            if (ncand)
            {
                qsort(cand, ncand, 4 * sizeof(uint64_t), zl_range_cmp);
                for (unsigned i = 0; i < im->nsh; i++)
                {
                    ZlShdr *rs = &im->sh[i];
                    if (rs->sh_type != ZL_SHT_RELA || rs->sh_info >= im->nsh || !im->sec[rs->sh_info] ||
                        (im->sh[rs->sh_info].sh_flags & 4))
                        continue;
                    ZlRela *ra = (ZlRela *)(img + rs->sh_offset);
                    for (size_t k = 0; k < rs->sh_size / sizeof(ZlRela); k++)
                    {
                        uint64_t at = im->sec[rs->sh_info] + ra[k].r_offset;
                        unsigned lo = 0, hi = ncand;
                        while (lo < hi)
                        {
                            unsigned mid = (lo + hi) / 2;
                            if (cand[4 * mid] <= at) lo = mid + 1;
                            else hi = mid;
                        }
                        if (lo && at < cand[4 * (lo - 1) + 1]) cand[4 * (lo - 1) + 3] = 1;
                    }
                }
                for (unsigned c = 0; c < ncand; c++)
                {
                    if (cand[4 * c + 3]) continue;
                    unsigned s = (unsigned)cand[4 * c + 2];
                    ZlSym *y = &im->syms[s];
                    const char *nm = zl_name(im, s);
                    // As aligned as it was in its section (where tcc put it at its alignment).
                    size_t align = 16;
                    while (align > 1 && (y->st_value & (align - 1))) align >>= 1;
                    unsigned char *at = zl_pool((const unsigned char *)(uintptr_t)im->addr[s], (size_t)y->st_size,
                                                !strncmp(nm, "L.", 2) ? NULL : nm, align);
                    if (at) im->addr[s] = (uint64_t)(uintptr_t)at;
                }
            }
            free(cand);
        }

        // The manifest's objects (its functions' addresses there are the functions' own).
        unsigned nmf = 0;
        for (unsigned s = 1; s < im->nsyms; s++)
            if (ZL_TYPE(im->syms[s].st_info) == ZL_STT_OBJECT && im->addr[s] && !strncmp(zl_name(im, s), "_zc_mf", 6)) nmf++;
        if (nmf && !(mf = (uint64_t *)malloc(nmf * 2 * sizeof(uint64_t))))
        {
            zl_err(err, errn, "out of memory");
            goto fail;
        }
        nmf = 0;
        for (unsigned s = 1; s < im->nsyms; s++)
            if (ZL_TYPE(im->syms[s].st_info) == ZL_STT_OBJECT && im->addr[s] && !strncmp(zl_name(im, s), "_zc_mf", 6))
            {
                mf[2 * nmf] = im->addr[s];
                mf[2 * nmf + 1] = im->addr[s] + im->syms[s].st_size;
                nmf++;
            }
        if (nmf) qsort(mf, nmf, 2 * sizeof(uint64_t), zl_range_cmp);

        // The relocations of what is loaded (the debug sections' are the debugger's to apply).
        unsigned ngot_used = 0, nplt_used = 0;
        for (unsigned i = 0; i < im->nsh; i++)
        {
            ZlShdr *rs = &im->sh[i];
            if (rs->sh_type != ZL_SHT_RELA || rs->sh_info >= im->nsh || !im->sec[rs->sh_info]) continue;
            ZlShdr *ts = &im->sh[rs->sh_info];
            ZlRela *ra = (ZlRela *)(img + rs->sh_offset);
            for (size_t k = 0; k < rs->sh_size / sizeof(ZlRela); k++)
            {
                unsigned s = (unsigned)(ra[k].r_info >> 32), t = (unsigned)ra[k].r_info;
                if (s >= im->nsyms || ra[k].r_offset + 4 > ts->sh_size) continue;
                unsigned char *P = (unsigned char *)(uintptr_t)(im->sec[rs->sh_info] + ra[k].r_offset);
                uint64_t S = im->addr[s];
                int64_t A = ra[k].r_addend;
                uint64_t Pa = (uint64_t)(uintptr_t)P;
                int64_t d;
                const ZlSym *ty = &im->syms[s];
                int own_fn = ZL_TYPE(ty->st_info) == ZL_STT_FUNC && ty->st_shndx != ZL_SHN_UNDEF &&
                             ty->st_shndx < im->nsh && im->sec[ty->st_shndx];
                if (own_fn && t == ZL_R_64)
                {
                    // In the manifest? (the last object starting at or before it)
                    unsigned lo = 0, hi = nmf;
                    while (lo < hi)
                    {
                        unsigned mid = (lo + hi) / 2;
                        if (mf[2 * mid] <= Pa) lo = mid + 1;
                        else hi = mid;
                    }
                    if ((!lo || Pa >= mf[2 * (lo - 1) + 1]) && !zl_note_ref(im, Pa, s, 0, A)) goto oom;
                }
                // A PC-relative reference that isn't a call or jump takes the address (a lea).
                if (own_fn && t == ZL_R_PC32 && !(ra[k].r_offset >= 1 && (P[-1] == 0xE8 || P[-1] == 0xE9)) &&
                    !zl_note_ref(im, Pa, s, 1, A))
                    goto oom;
                switch (t)
                {
                case ZL_R_64:
                    memcpy(P, &(uint64_t){S + (uint64_t)A}, 8);
                    break;
                case ZL_R_PC64:
                    memcpy(P, &(uint64_t){S + (uint64_t)A - Pa}, 8);
                    break;
                case ZL_R_PC32:
                case ZL_R_PLT32:
                    d = (int64_t)(S + (uint64_t)A - Pa);
                    if (!zl_fits32(d) && need_plt[s])
                    {
                        if (!pslot[s])
                        {
                            unsigned char *st = im->mem + plt_at + 16 * nplt_used++;
                            static const unsigned char jmp[6] = {0xFF, 0x25, 0, 0, 0, 0}; // jmp *0(%rip)
                            memcpy(st, jmp, 6);
                            memcpy(st + 6, &S, 8);
                            pslot[s] = (uint64_t)(uintptr_t)st;
                        }
                        d = (int64_t)(pslot[s] + (uint64_t)A - Pa);
                    }
                    if (!zl_fits32(d))
                    {
                        zl_err(err, errn, "'%s' is out of reach of a 32-bit reference",
                               im->strtab + im->syms[s].st_name);
                        goto fail;
                    }
                    memcpy(P, &(int32_t){(int32_t)d}, 4);
                    break;
                case ZL_R_GOTPCREL:
                case ZL_R_GOTPCRELX:
                case ZL_R_REX_GOTPCRELX:
                {
                    if (!gslot[s])
                    {
                        uint64_t *g = (uint64_t *)(im->mem + got_at) + ngot_used++;
                        *g = S;
                        gslot[s] = (uint64_t)(uintptr_t)g;
                        if (own_fn && !zl_note_ref(im, gslot[s], s, 0, 0)) goto oom;
                    }
                    d = (int64_t)(gslot[s] + (uint64_t)A - Pa);
                    memcpy(P, &(int32_t){(int32_t)d}, 4);
                    break;
                }
                case ZL_R_32:
                    if (S + (uint64_t)A > 0xffffffffu) goto out_of_reach;
                    memcpy(P, &(uint32_t){(uint32_t)(S + (uint64_t)A)}, 4);
                    break;
                case ZL_R_32S:
                    if (!zl_fits32((int64_t)(S + (uint64_t)A))) goto out_of_reach;
                    memcpy(P, &(int32_t){(int32_t)(S + (uint64_t)A)}, 4);
                    break;
                default:
                    zl_err(err, errn, "a relocation of type %u, which the Reloader doesn't know", t);
                    goto fail;
                oom:
                    zl_err(err, errn, "out of memory");
                    goto fail;
                out_of_reach:
                    zl_err(err, errn, "an absolute 32-bit reference to '%s'", im->strtab + im->syms[s].st_name);
                    goto fail;
                }
            }
        }
        free(need_got);
        free(need_plt);
        free(gslot);
        free(pslot);
        free(mf);
        need_got = need_plt = NULL;
        gslot = pslot = NULL;
        mf = NULL;

        // The debugger's view: the object file with each loaded section at its address, and
        // each name it took from elsewhere (the store's globals, the host's) at that address.
        // The debug sections' relocations are applied here: tcc writes them as ELF's REL kind
        // (the offset in the field, none in the entry, against a section's symbol), which gdb,
        // reading them as RELA (the field replaced), would put every function at the start of
        // .text. Their entries are then hidden from it.
        for (unsigned i = 0; i < im->nsh; i++)
        {
            ZlShdr *rs = &im->sh[i];
            if (rs->sh_type != ZL_SHT_RELA || rs->sh_info >= im->nsh || im->sec[rs->sh_info]) continue;
            ZlShdr *ts = &im->sh[rs->sh_info];
            if (ts->sh_type == ZL_SHT_NOBITS) continue;
            unsigned char *data = img + ts->sh_offset;
            ZlRela *ra = (ZlRela *)(img + rs->sh_offset);
            for (size_t k = 0; k < rs->sh_size / sizeof(ZlRela); k++)
            {
                unsigned sym = (unsigned)(ra[k].r_info >> 32), t = (unsigned)ra[k].r_info;
                if (sym >= im->nsyms) continue;
                uint64_t v = im->addr[sym] + (uint64_t)ra[k].r_addend;
                if (t == ZL_R_64 && ra[k].r_offset + 8 <= ts->sh_size)
                {
                    uint64_t f;
                    memcpy(&f, data + ra[k].r_offset, 8);
                    f += v;
                    memcpy(data + ra[k].r_offset, &f, 8);
                }
                else if ((t == ZL_R_32 || t == ZL_R_32S) && ra[k].r_offset + 4 <= ts->sh_size)
                {
                    uint32_t f;
                    memcpy(&f, data + ra[k].r_offset, 4);
                    f += (uint32_t)v;
                    memcpy(data + ra[k].r_offset, &f, 4);
                }
            }
            rs->sh_type = 0; // SHT_NULL
        }
        for (unsigned i = 0; i < im->nsh; i++)
            if (im->sec[i]) im->sh[i].sh_addr = im->sec[i];
        for (unsigned s = 1; s < im->nsyms; s++)
        {
            ZlSym *y = &im->syms[s];
            int moved = y->st_shndx != ZL_SHN_UNDEF && y->st_shndx < im->nsh && im->sec[y->st_shndx] &&
                        ZL_TYPE(y->st_info) == ZL_STT_OBJECT && im->addr[s] != im->sec[y->st_shndx] + y->st_value;
            if ((y->st_shndx == ZL_SHN_UNDEF && im->addr[s]) || y->st_shndx == ZL_SHN_COMMON || moved)
            {
                y->st_shndx = ZL_SHN_ABS;
                y->st_value = im->addr[s];
            }
        }
        im->jit.symfile_addr = (const char *)img;
        im->jit.symfile_size = img_size;
        zl_jit_add(&im->jit);
        im->registered = 1;
        return im;

    fail:
        free(need_got);
        free(need_plt);
        free(gslot);
        free(pslot);
        free(mf);
        zl_free(im);
        return NULL;
    }

    static unsigned char *zl_read_file(const char *path, size_t *size)
    {
        FILE *f = fopen(path, "rb");
        if (!f) return NULL;
        unsigned char *buf = NULL;
        long n = -1;
        if (fseek(f, 0, SEEK_END) == 0) n = ftell(f);
        if (n > 0 && fseek(f, 0, SEEK_SET) == 0 && (buf = (unsigned char *)malloc((size_t)n)) &&
            fread(buf, 1, (size_t)n, f) != (size_t)n)
        {
            free(buf);
            buf = NULL;
        }
        fclose(f);
        *size = buf ? (size_t)n : 0;
        return buf;
    }

    static size_t zr_version_bytes(const ZrVersion *v)
    {
        return v->im ? v->im->mem_size + v->im->data_size + v->im->img_size : v->mem_size;
    }
    #else
    static size_t zr_version_bytes(const ZrVersion *v) { return v->mem_size; }
    static void *zl_sym(struct ZlImage *im, const char *name) { (void)im; (void)name; return NULL; }
    static void zl_free(struct ZlImage *im) { (void)im; }
    #endif

    static void *zr_new(const char *source, const char *c_file)
    {
        ZrReloader *r = (ZrReloader *)calloc(1, sizeof(ZrReloader));
        if (!r) return NULL;
        r->zc = zr_strdup("zc");
        r->source = zr_strdup(source);
        r->c_file = zr_strdup(c_file);
        r->keep_old = 1;
        r->verbose = 1;
        r->seen = -1;
        r->ino_fd = -1;
        const char *scan = getenv("ZC_RELOAD_SCAN");
        r->force_scan = scan && *scan && strcmp(scan, "0") != 0;
        const char *mem = getenv("ZC_RELOAD_MEMORY");
        r->in_memory = mem && *mem && strcmp(mem, "0") != 0;
        return r;
    }

    static void zr_set(char **field, const char *value)
    {
        free(*field);
        *field = zr_strdup(value);
    }

    static void zr_set_zc(void *h, const char *zc) { zr_set(&((ZrReloader *)h)->zc, zc); }
    static void zr_set_zc_flags(void *h, const char *f) { zr_set(&((ZrReloader *)h)->zc_flags, f); }
    static void zr_set_source(void *h, const char *s) { zr_set(&((ZrReloader *)h)->source, s); }
    static void zr_set_watch(void *h, const char *d) { zr_set(&((ZrReloader *)h)->watch_dir, d); }
    static void zr_set_keep_old(void *h, int keep) { ((ZrReloader *)h)->keep_old = keep; }
    static void zr_set_verbose(void *h, int verbose) { ((ZrReloader *)h)->verbose = verbose; }

    static int zr_add_include(void *h, const char *dir)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (r->include_count >= ZR_MAX_INCLUDES) return 0;
        r->includes[r->include_count++] = zr_strdup(dir);
        return 1;
    }

    static int zr_require_same(void *h, const char *type)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (r->required_count >= ZR_MAX_REQUIRED) return 0;
        r->required[r->required_count++] = zr_strdup(type);
        return 1;
    }

    // The directory watched for changes: the one set, else the source's directory.
    static char *zr_watch_dir(ZrReloader *r)
    {
        if (r->watch_dir) return zr_strdup(r->watch_dir);
        char *dir = zr_strdup(r->source);
        char *slash = strrchr(dir, '/');
        if (slash) *slash = 0;
        else zr_set(&dir, ".");
        return dir;
    }

    static int64_t zr_newest(ZrReloader *r)
    {
        char *dir = zr_watch_dir(r);
        int64_t newest = zr_newest_zc(dir, 0);
        free(dir);
        return newest;
    }

    // Whether poll() can skip scanning the files: nothing under the watched directory has
    // changed since the last call, as far as it can tell. On Linux, inotify says so; it
    // watches every directory under it (to the depth zr_newest_zc searches) and is set up
    // again when one is added or removed. Elsewhere, or if it can't be set up, poll() scans
    // (a stat of every file: about 1.7 ms at 3000 files), but at most every ZR_SCAN_MS, so
    // a save is seen up to that much later.
    enum { ZR_SCAN_MS = 200 };

    static int zr_scan_due(ZrReloader *r)
    {
        double now = zr_now_ms();
        if (r->last_scan > 0 && now - r->last_scan < ZR_SCAN_MS) return 0;
        r->last_scan = now;
        return 1;
    }

    #ifdef __linux__
    static int zr_ino_add(int fd, const char *dir_path, int depth)
    {
        if (depth > 16) return 1;
        if (inotify_add_watch(fd, dir_path, IN_MODIFY | IN_CLOSE_WRITE | IN_ATTRIB | IN_CREATE |
                                                IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO |
                                                IN_DELETE_SELF | IN_MOVE_SELF) < 0)
            return 0;
        DIR *dir = opendir(dir_path);
        if (!dir) return 0;
        int ok = 1;
        struct dirent *entry;
        while (ok && (entry = readdir(dir)) != NULL)
        {
            if (entry->d_name[0] == '.') continue;
            size_t len = strlen(dir_path) + strlen(entry->d_name) + 2;
            char *path = (char *)malloc(len);
            if (!path) { ok = 0; break; }
            snprintf(path, len, "%s/%s", dir_path, entry->d_name);
            struct stat st;
            if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) ok = zr_ino_add(fd, path, depth + 1);
            free(path);
        }
        closedir(dir);
        return ok;
    }

    static void zr_ino_close(ZrReloader *r)
    {
        if (r->ino_fd >= 0) close(r->ino_fd);
        r->ino_fd = -1;
        r->ino_failed = 0;
        free(r->ino_root);
        r->ino_root = NULL;
    }

    static void zr_ino_setup(ZrReloader *r, char *root)
    {
        zr_ino_close(r);
        r->ino_root = root;
        r->ino_fd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
        if (r->ino_fd >= 0 && zr_ino_add(r->ino_fd, root, 0)) return;
        if (r->ino_fd >= 0) close(r->ino_fd);
        r->ino_fd = -1;
        r->ino_failed = 1;
    }
    #endif

    static int zr_unchanged(ZrReloader *r)
    {
    #ifdef __linux__
        if (r->force_scan) return !zr_scan_due(r);
        char *root = zr_watch_dir(r);
        if (!r->ino_root || strcmp(root, r->ino_root) != 0)
        {
            zr_ino_setup(r, root); // and scan this time, for what changed before it
            return 0;
        }
        free(root);
        if (r->ino_failed) return !zr_scan_due(r);
        int changed = 0, again = 0;
        char buf[8192] __attribute__((aligned(__alignof__(struct inotify_event))));
        ssize_t n;
        while ((n = read(r->ino_fd, buf, sizeof buf)) > 0)
        {
            for (char *p = buf; p < buf + n;)
            {
                const struct inotify_event *e = (const struct inotify_event *)p;
                changed = 1;
                if (((e->mask & IN_ISDIR) &&
                     (e->mask & (IN_CREATE | IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO))) ||
                    (e->mask & (IN_Q_OVERFLOW | IN_IGNORED | IN_DELETE_SELF | IN_MOVE_SELF)))
                    again = 1; // a directory added or gone: watch them all again
                p += sizeof(struct inotify_event) + e->len;
            }
        }
        if (again) zr_ino_setup(r, zr_strdup(r->ino_root));
        return !changed;
    #else
        return !zr_scan_due(r);
    #endif
    }

    // The old versions kept, and their memory when known.
    static size_t zr_version_bytes(const ZrVersion *v);
    static void zr_report_kept(ZrReloader *r)
    {
        if (r->old_count == 0) return;
        size_t bytes = 0;
        int known = 1;
        for (int i = 0; i < r->old_count; i++)
        {
            size_t b = zr_version_bytes(&r->old[i]);
            if (!b) known = 0;
            bytes += b;
        }
        if (known)
            fprintf(stderr, "reload: %d old version%s kept loaded (%zu KB)\n", r->old_count,
                    r->old_count == 1 ? "" : "s", bytes / 1024);
        else
            fprintf(stderr, "reload: %d old version%s kept loaded\n", r->old_count,
                    r->old_count == 1 ? "" : "s");
    }

    // ---- Comparing versions' manifests ------------------------------------------------
    //
    // The Reloader keeps a copy of each version's manifest, its types sorted by name, so the
    // next version can be compared with it after the old code is gone.

    static const char *zr_s(const char *s) { return s ? s : ""; }

    // Globals by name. A module has a few globals per file, so thousands in a big one, and
    // finding each by walking all of them made a reload O(globals²): about 0.9 s at 15,000.
    // Each array searched (a manifest's copy, or the store; both owned here and never
    // changed once made) gets a hash of its names on first use, kept until the array is
    // freed (zr_gidx_forget). The arrays keep their order, so reports print as before.
    typedef struct { const ZcMfGlobal *arr; unsigned n; unsigned cap; unsigned *slot; } ZrGIdx;
    enum { ZR_GIDX_KEPT = 8, ZR_GIDX_MIN = 16 }; // arrays indexed at once; smaller ones are walked
    static ZrGIdx zr_gidx[ZR_GIDX_KEPT];
    static unsigned zr_gidx_next;

    static unsigned zr_hash(const char *s)
    {
        unsigned h = 2166136261u;
        for (; *s; s++) h = (h ^ (unsigned char)*s) * 16777619u;
        return h;
    }

    static void zr_gidx_drop(ZrGIdx *x)
    {
        free(x->slot);
        memset(x, 0, sizeof(*x));
    }

    // `arr` is about to be freed: its index, if any, goes too.
    static void zr_gidx_forget(const ZcMfGlobal *arr)
    {
        for (unsigned i = 0; arr && i < ZR_GIDX_KEPT; i++)
            if (zr_gidx[i].arr == arr) zr_gidx_drop(&zr_gidx[i]);
    }

    // The index of `g` (n entries), made if needed; NULL if out of memory.
    static ZrGIdx *zr_gidx_of(const ZcMfGlobal *g, unsigned n)
    {
        for (unsigned i = 0; i < ZR_GIDX_KEPT; i++)
            if (zr_gidx[i].arr == g && zr_gidx[i].n == n) return &zr_gidx[i];
        unsigned cap = 32;
        while (cap < n * 2) cap *= 2;
        unsigned *slot = (unsigned *)calloc(cap, sizeof(unsigned)); // entry + 1, or 0 if empty
        if (!slot) return NULL;
        for (unsigned i = 0; i < n; i++)
        {
            const char *name = zr_s(g[i].name);
            unsigned k = zr_hash(name) & (cap - 1);
            while (slot[k] && strcmp(zr_s(g[slot[k] - 1].name), name) != 0) k = (k + 1) & (cap - 1);
            if (!slot[k]) slot[k] = i + 1; // the first of a name, as a walk would find
        }
        ZrGIdx *x = &zr_gidx[zr_gidx_next];
        zr_gidx_next = (zr_gidx_next + 1) % ZR_GIDX_KEPT;
        zr_gidx_drop(x);
        x->arr = g;
        x->n = n;
        x->cap = cap;
        x->slot = slot;
        return x;
    }

    static const ZcMfGlobal *zr_global_find(const ZcMfGlobal *g, unsigned n, const char *name)
    {
        name = zr_s(name);
        ZrGIdx *x = n >= ZR_GIDX_MIN ? zr_gidx_of(g, n) : NULL;
        if (x)
        {
            unsigned k = zr_hash(name) & (x->cap - 1);
            for (; x->slot[k]; k = (k + 1) & (x->cap - 1))
                if (strcmp(zr_s(g[x->slot[k] - 1].name), name) == 0) return &g[x->slot[k] - 1];
            return NULL;
        }
        for (unsigned i = 0; i < n; i++)
            if (strcmp(zr_s(g[i].name), name) == 0) return &g[i];
        return NULL;
    }

    static int zr_mf_by_name(const void *a, const void *b)
    {
        return strcmp(zr_s(((const ZcMfType *)a)->c_name), zr_s(((const ZcMfType *)b)->c_name));
    }

    static void zr_mf_free(ZcManifest *m)
    {
        if (!m) return;
        for (unsigned i = 0; i < m->ntypes; i++)
        {
            const ZcMfType *t = &m->types[i];
            free((void *)t->c_name);
            free((void *)t->zc_name);
            for (unsigned j = 0; j < t->nfields; j++)
            {
                free((void *)t->fields[j].name);
                free((void *)t->fields[j].type);
            }
            for (unsigned j = 0; j < t->nvariants; j++)
            {
                free((void *)t->variants[j].name);
                free((void *)t->variants[j].payload);
            }
            free((void *)t->fields);
            free((void *)t->variants);
        }
        for (unsigned i = 0; i < m->nglobals; i++)
        {
            free((void *)m->globals[i].name);
            free((void *)m->globals[i].type);
            free((void *)m->globals[i].init);
        }
        zr_gidx_forget(m->globals);
        free((void *)m->globals);
        for (unsigned i = 0; i < m->nfuncs; i++)
        {
            free((void *)m->funcs[i].name);
            free((void *)m->funcs[i].ret);
            for (unsigned j = 0; j < m->funcs[i].nparams; j++) free((void *)m->funcs[i].params[j]);
            free((void *)m->funcs[i].params);
        }
        free((void *)m->funcs);
        free((void *)m->types);
        free((void *)m->zc_version);
        free(m);
    }

    // A copy of `m` that owns all its memory, or NULL (no manifest, a format this file
    // doesn't know, or out of memory).
    static ZcManifest *zr_mf_copy(const ZcManifest *m)
    {
        if (!m || m->format < 1 || m->format > 5) return NULL;
        ZcManifest *c = (ZcManifest *)calloc(1, sizeof(ZcManifest));
        ZcMfType *types = (ZcMfType *)calloc(m->ntypes ? m->ntypes : 1, sizeof(ZcMfType));
        if (!c || !types)
        {
            free(c);
            free(types);
            return NULL;
        }
        c->format = m->format;
        c->zc_version = zr_strdup(m->zc_version);
        c->types = types;
        int ok = 1;
        if (m->format >= 5 && m->nfuncs)
        {
            ZcMfFunc *f = (ZcMfFunc *)calloc(m->nfuncs, sizeof(ZcMfFunc));
            if (!f) ok = 0;
            else
            {
                c->funcs = f;
                c->nfuncs = m->nfuncs;
                for (unsigned i = 0; i < m->nfuncs; i++)
                {
                    f[i].name = zr_strdup(m->funcs[i].name);
                    f[i].ret = zr_strdup(m->funcs[i].ret);
                    f[i].nparams = m->funcs[i].nparams;
                    f[i].addr = m->funcs[i].addr;
                    char **ps = m->funcs[i].nparams ? (char **)calloc(m->funcs[i].nparams, sizeof(char *)) : NULL;
                    for (unsigned j = 0; ps && j < m->funcs[i].nparams; j++)
                        ps[j] = zr_strdup(m->funcs[i].params[j]);
                    if (m->funcs[i].nparams && !ps) { f[i].nparams = 0; ok = 0; }
                    f[i].params = (const char *const *)ps;
                }
            }
        }
        if (m->format >= 4 && m->nglobals)
        {
            ZcMfGlobal *g = (ZcMfGlobal *)calloc(m->nglobals, sizeof(ZcMfGlobal));
            if (!g) ok = 0;
            else
            {
                c->globals = g;
                c->nglobals = m->nglobals;
                for (unsigned i = 0; i < m->nglobals; i++)
                {
                    g[i] = m->globals[i];
                    g[i].name = zr_strdup(m->globals[i].name);
                    g[i].type = zr_strdup(m->globals[i].type);
                    g[i].init = m->format >= 4 ? zr_strdup(m->globals[i].init) : NULL;
                    if (m->format < 4) { g[i].init_value = NULL; g[i].flags = 0; }
                }
            }
        }
        for (unsigned i = 0; i < m->ntypes; i++)
        {
            const ZcMfType *t = &m->types[i];
            ZcMfType *d = &types[i];
            *d = *t;
            d->c_name = zr_strdup(t->c_name);
            d->zc_name = zr_strdup(t->zc_name);
            d->fields = NULL;
            d->variants = NULL;
            d->nfields = 0;
            d->nvariants = 0;
            c->ntypes = i + 1;
            if (!d->c_name) ok = 0;
            if (t->nfields)
            {
                ZcMfField *f = (ZcMfField *)calloc(t->nfields, sizeof(ZcMfField));
                if (!f) { ok = 0; break; }
                d->fields = f;
                d->nfields = t->nfields;
                for (unsigned j = 0; j < t->nfields; j++)
                {
                    f[j] = t->fields[j];
                    f[j].name = zr_strdup(t->fields[j].name);
                    f[j].type = zr_strdup(t->fields[j].type);
                }
            }
            if (t->nvariants)
            {
                ZcMfVariant *v = (ZcMfVariant *)calloc(t->nvariants, sizeof(ZcMfVariant));
                if (!v) { ok = 0; break; }
                d->variants = v;
                d->nvariants = t->nvariants;
                for (unsigned j = 0; j < t->nvariants; j++)
                {
                    v[j] = t->variants[j];
                    v[j].name = zr_strdup(t->variants[j].name);
                    v[j].payload = zr_strdup(t->variants[j].payload);
                }
            }
        }
        if (!ok)
        {
            zr_mf_free(c);
            return NULL;
        }
        qsort(types, c->ntypes, sizeof(ZcMfType), zr_mf_by_name);
        return c;
    }

    static const ZcMfType *zr_mf_find(const ZcManifest *m, const char *name)
    {
        if (!m || !name) return NULL;
        ZcMfType key;
        memset(&key, 0, sizeof(key));
        key.c_name = name;
        return (const ZcMfType *)bsearch(&key, m->types, m->ntypes, sizeof(ZcMfType), zr_mf_by_name);
    }

    // The two descriptions of a type are the same: kind, size, alignment, and every field
    // and variant, in order.
    static int zr_mf_same(const ZcMfType *a, const ZcMfType *b)
    {
        if (a->kind != b->kind || a->size != b->size || a->align != b->align ||
            a->nfields != b->nfields || a->nvariants != b->nvariants)
            return 0;
        for (unsigned i = 0; i < a->nfields; i++)
        {
            const ZcMfField *x = &a->fields[i], *y = &b->fields[i];
            if (strcmp(zr_s(x->name), zr_s(y->name)) || strcmp(zr_s(x->type), zr_s(y->type)) ||
                x->offset != y->offset || x->size != y->size || x->bits != y->bits)
                return 0;
        }
        for (unsigned i = 0; i < a->nvariants; i++)
        {
            const ZcMfVariant *x = &a->variants[i], *y = &b->variants[i];
            if (strcmp(zr_s(x->name), zr_s(y->name)) || x->value != y->value ||
                strcmp(zr_s(x->payload), zr_s(y->payload)))
                return 0;
        }
        return 1;
    }

    // The type a field or payload holds by value ("Vec2" for "Vec2" or "Vec2[4]"), in
    // `buf`, or NULL for a pointer or function pointer, which holds nothing by value.
    static const char *zr_mf_held(const char *type, char *buf, size_t size)
    {
        if (!type || strchr(type, '*') || strchr(type, '(')) return NULL;
        if (strncmp(type, "struct ", 7) == 0) type += 7;
        size_t n = strcspn(type, "[");
        while (n > 0 && type[n - 1] == ' ') n--;
        if (n == 0 || n >= size) return NULL;
        memcpy(buf, type, n);
        buf[n] = 0;
        return buf;
    }

    static const char *zr_pointee(const char *type, char *buf, size_t size);

    // std containers that hold their elements in a buffer of their own: Vec<T> and
    // Stack<T> (data, len, cap: [0, len) of cap), Queue<T> (data, cap, head, count: a ring),
    // Map<V> (vals, cap, occupied, deleted: the occupied, not deleted, slots) and Box<T>
    // (ptr: one). When the element type changes, the buffer is moved like an array
    // (zr_move_container).
    enum { ZR_VEC = 1, ZR_QUEUE, ZR_MAP, ZR_BOX };

    static const ZcMfField *zr_field_named(const ZcMfType *t, const char *name)
    {
        for (unsigned i = 0; i < t->nfields; i++)
            if (!strcmp(zr_s(t->fields[i].name), name)) return &t->fields[i];
        return NULL;
    }

    // Which container `t` is (0: none), and its element type, into `buf`.
    static int zr_container(const ZcMfType *t, char *buf, size_t size, const char **elem)
    {
        *elem = NULL;
        if (!t || t->kind != 1) return 0;
        const char *zn = zr_s(t->zc_name);
        int kind = !strncmp(zn, "Vec<", 4) || !strncmp(zn, "Stack<", 6) ? ZR_VEC
                   : !strncmp(zn, "Queue<", 6)                           ? ZR_QUEUE
                   : !strncmp(zn, "Map<", 4)                             ? ZR_MAP
                   : !strncmp(zn, "Box<", 4)                             ? ZR_BOX
                                                                         : 0;
        static const char *const need[][5] = {
            {0}, {"data", "len", "cap"}, {"data", "cap", "head", "count"},
            {"vals", "cap", "occupied", "deleted"}, {"ptr"}};
        if (!kind) return 0;
        for (int i = 0; i < 5 && need[kind][i]; i++)
            if (!zr_field_named(t, need[kind][i])) return 0;
        const ZcMfField *buffer = zr_field_named(t, need[kind][0]);
        if (buffer->size != sizeof(void *)) return 0;
        *elem = zr_pointee(zr_s(buffer->type), buf, size);
        return *elem ? kind : 0;
    }

    static const char *zr_vec_elem(const ZcMfType *t, char *buf, size_t size)
    {
        const char *elem;
        return zr_container(t, buf, size, &elem) ? elem : NULL;
    }

    // `name` changed between the manifests: it is in only one, its description differs,
    // or a type it holds by value changed (or a Vec's element type). The one it holds is
    // named in `via`, if given.
    static int zr_mf_changed(const ZcManifest *old, const ZcManifest *now, const char *name,
                             int depth, const char **via)
    {
        const ZcMfType *a = zr_mf_find(old, name), *b = zr_mf_find(now, name);
        if (!a && !b) return 0;
        if (!a || !b || !zr_mf_same(a, b)) return 1;
        if (depth > 64) return 0;
        char buf[256];
        for (unsigned i = 0; i < b->nfields + b->nvariants; i++)
        {
            const char *t = i < b->nfields ? b->fields[i].type : b->variants[i - b->nfields].payload;
            const char *held = zr_mf_held(t, buf, sizeof(buf));
            const ZcMfType *h = held ? zr_mf_find(now, held) : NULL;
            if (h && zr_mf_changed(old, now, held, depth + 1, NULL))
            {
                if (via) *via = h->zc_name ? h->zc_name : h->c_name;
                return 1;
            }
        }
        const char *elem = zr_vec_elem(b, buf, sizeof(buf));
        const ZcMfType *e = elem ? zr_mf_find(now, elem) : NULL;
        if (e && zr_mf_changed(old, now, elem, depth + 1, NULL))
        {
            if (via) *via = e->zc_name ? e->zc_name : e->c_name;
            return 1;
        }
        return 0;
    }

    static const char *zr_mf_kind_name(unsigned kind)
    {
        switch (kind)
        {
        case 1: return "struct";
        case 2: return "union";
        case 3: return "enum";
        case 4: return "enum with payloads";
        case 5: return "vector type";
        default: return "type";
        }
    }

    // One ", "-separated item of a type's line in the report.
    static void zr_mf_item(FILE *out, int *first, const char *fmt, ...)
    {
        fputs(*first ? ": " : ", ", out);
        *first = 0;
        va_list ap;
        va_start(ap, fmt);
        vfprintf(out, fmt, ap);
        va_end(ap);
    }

    // What differs between two descriptions of a type, on one line.
    static void zr_mf_report_type(FILE *out, const ZcMfType *a, const ZcMfType *b)
    {
        int first = 1;
        fprintf(out, "reload:   %s", zr_s(b->zc_name ? b->zc_name : b->c_name));
        if (a->kind != b->kind)
            zr_mf_item(out, &first, "now a %s (was a %s)", zr_mf_kind_name(b->kind),
                       zr_mf_kind_name(a->kind));
        if (a->size != b->size)
            zr_mf_item(out, &first, "size %u -> %u bytes", a->size, b->size);
        if (a->align != b->align)
            zr_mf_item(out, &first, "alignment %u -> %u", a->align, b->align);

        // Each field of the new version, in order. A run of fields that only moved, all by
        // the same number of bytes (everything after an added field, say), is one item:
        // shifted down (to higher offsets) or up.
        unsigned run = 0;          // fields in the run so far
        long long run_delta = 0;   // bytes each moved by
        const ZcMfField *run_first = NULL, *run_last = NULL, *run_was = NULL;
        for (unsigned i = 0; i <= b->nfields; i++)
        {
            const ZcMfField *y = i < b->nfields ? &b->fields[i] : NULL, *x = NULL;
            for (unsigned j = 0; y && j < a->nfields && !x; j++)
                if (strcmp(zr_s(a->fields[j].name), zr_s(y->name)) == 0) x = &a->fields[j];
            int only_moved = x && x->offset != y->offset && !strcmp(zr_s(x->type), zr_s(y->type)) &&
                             x->size == y->size && x->bits == y->bits;
            long long delta = only_moved ? (long long)y->offset - (long long)x->offset : 0;
            if (run && !(only_moved && delta == run_delta))
            {
                if (run == 1)
                    zr_mf_item(out, &first, "%s moved from byte %u to %u", zr_s(run_first->name),
                               run_was->offset, run_first->offset);
                else
                    zr_mf_item(out, &first, "%u fields shifted %s %lld bytes (%s to %s)", run,
                               run_delta < 0 ? "up" : "down",
                               run_delta < 0 ? -run_delta : run_delta, zr_s(run_first->name),
                               zr_s(run_last->name));
                run = 0;
            }
            if (!y) break;
            if (only_moved)
            {
                if (!run)
                {
                    run_first = y;
                    run_was = x;
                    run_delta = delta;
                }
                run_last = y;
                run++;
                continue;
            }
            if (!x)
            {
                if (y->bits)
                    zr_mf_item(out, &first, "%s added (%u bits)", zr_s(y->name), y->bits);
                else
                    zr_mf_item(out, &first, "%s added at byte %u", zr_s(y->name), y->offset);
                continue;
            }
            if (strcmp(zr_s(x->type), zr_s(y->type)))
                zr_mf_item(out, &first, "%s retyped from %s to %s", zr_s(y->name), zr_s(x->type),
                           zr_s(y->type));
            else if (x->size != y->size)
                zr_mf_item(out, &first, "%s resized from %u to %u bytes", zr_s(y->name), x->size,
                           y->size);
            if (x->offset != y->offset)
                zr_mf_item(out, &first, "%s moved from byte %u to %u", zr_s(y->name), x->offset,
                           y->offset);
            if (x->bits != y->bits)
                zr_mf_item(out, &first, "%s resized from %u to %u bits", zr_s(y->name), x->bits,
                           y->bits);
        }
        for (unsigned j = 0; j < a->nfields; j++)
        {
            int kept = 0;
            for (unsigned i = 0; i < b->nfields && !kept; i++)
                kept = strcmp(zr_s(a->fields[j].name), zr_s(b->fields[i].name)) == 0;
            if (!kept) zr_mf_item(out, &first, "%s removed", zr_s(a->fields[j].name));
        }
        for (unsigned i = 0; i < b->nvariants; i++)
        {
            const ZcMfVariant *y = &b->variants[i], *x = NULL;
            for (unsigned j = 0; j < a->nvariants && !x; j++)
                if (strcmp(zr_s(a->variants[j].name), zr_s(y->name)) == 0) x = &a->variants[j];
            if (!x)
            {
                zr_mf_item(out, &first, "%s added (= %lld)", zr_s(y->name), y->value);
                continue;
            }
            if (x->value != y->value)
                zr_mf_item(out, &first, "%s renumbered from %lld to %lld", zr_s(y->name), x->value,
                           y->value);
            if (strcmp(zr_s(x->payload), zr_s(y->payload)))
                zr_mf_item(out, &first, "%s carries %s (was %s)", zr_s(y->name),
                           y->payload ? y->payload : "nothing", x->payload ? x->payload : "nothing");
        }
        for (unsigned j = 0; j < a->nvariants; j++)
        {
            int kept = 0;
            for (unsigned i = 0; i < b->nvariants && !kept; i++)
                kept = strcmp(zr_s(a->variants[j].name), zr_s(b->variants[i].name)) == 0;
            if (!kept) zr_mf_item(out, &first, "%s removed", zr_s(a->variants[j].name));
        }
        if (first) fputs(": fields or variants reordered", out);
        fputc('\n', out);
    }

    // The type `g` holds by value is in a manifest and changed between the two.
    static int zr_global_type_changed(const ZcManifest *old, const ZcManifest *now,
                                      const ZcMfGlobal *g, const char **type)
    {
        static char buf[256];
        const char *held = zr_mf_held(g->type, buf, sizeof(buf));
        if (!held || !old || !now) return 0;
        if (type) *type = held;
        return zr_mf_changed(old, now, held, 0, NULL);
    }

    // What changed between two versions' types and globals, or nothing if none did.
    static void zr_mf_report(FILE *out, const ZcManifest *old, const ZcManifest *now, int version)
    {
        if (!old || !now) return;
        int header = 0;
#define ZR_MF_HEADER() \
        do { if (!header) { fprintf(out, "reload: changes in version %d:\n", version); header = 1; } } while (0)

        // Types whose own description changed.
        for (unsigned i = 0; i < now->ntypes; i++)
        {
            const ZcMfType *b = &now->types[i], *a = zr_mf_find(old, b->c_name);
            if (a && !zr_mf_same(a, b))
            {
                ZR_MF_HEADER();
                zr_mf_report_type(out, a, b);
            }
        }
        // Types added and removed.
        int any = 0;
        for (unsigned i = 0; i < now->ntypes; i++)
        {
            const ZcMfType *b = &now->types[i];
            if (zr_mf_find(old, b->c_name)) continue;
            ZR_MF_HEADER();
            fprintf(out, any ? ", %s" : "reload:   added: %s", zr_s(b->zc_name ? b->zc_name : b->c_name));
            any = 1;
        }
        if (any) fputc('\n', out);
        any = 0;
        for (unsigned i = 0; i < old->ntypes; i++)
        {
            const ZcMfType *a = &old->types[i];
            if (zr_mf_find(now, a->c_name)) continue;
            ZR_MF_HEADER();
            fprintf(out, any ? ", %s" : "reload:   removed: %s", zr_s(a->zc_name ? a->zc_name : a->c_name));
            any = 1;
        }
        if (any) fputc('\n', out);
        // Types the same themselves, holding by value one that changed.
        any = 0;
        for (unsigned i = 0; i < now->ntypes; i++)
        {
            const ZcMfType *b = &now->types[i], *a = zr_mf_find(old, b->c_name);
            const char *via = NULL;
            if (!a || !zr_mf_same(a, b) || !zr_mf_changed(old, now, b->c_name, 0, &via)) continue;
            ZR_MF_HEADER();
            fprintf(out, any ? ", %s (holds %s)" : "reload:   also changed: %s (holds %s)",
                    zr_s(b->zc_name ? b->zc_name : b->c_name), zr_s(via));
            any = 1;
        }
        if (any) fputc('\n', out);
        // Globals added, removed and retyped. A retyped one starts again from its initial
        // value; the others keep theirs.
        int first = 1;
        for (unsigned i = 0; i < now->nglobals; i++)
        {
            const ZcMfGlobal *b = &now->globals[i];
            if (b->flags & 2) continue; // a vtable: refreshed, not the program's state
            const ZcMfGlobal *a = zr_global_find(old->globals, old->nglobals, b->name);
            const char *held = NULL;
            // The same type name, but its layout (and so maybe its size) changed: that's the
            // type changing, not the global being retyped.
            int same_name = a && !strcmp(zr_s(a->type), zr_s(b->type));
            int same = same_name && a->size == b->size;
            int held_changed = same_name && zr_global_type_changed(old, now, b, &held);
            if (same && !held_changed) continue;
            ZR_MF_HEADER();
            fputs(first ? "reload:   globals: " : ", ", out);
            first = 0;
            if (held_changed)
                fprintf(out, "%s's type %s changed", zr_s(b->name), held);
            else if (a)
                fprintf(out, "%s retyped from %s to %s", zr_s(b->name), zr_s(a->type),
                        zr_s(b->type));
            else
                fprintf(out, "%s added", zr_s(b->name));
        }
        for (unsigned i = 0; i < old->nglobals; i++)
        {
            const ZcMfGlobal *a = &old->globals[i];
            if ((a->flags & 2) || zr_global_find(now->globals, now->nglobals, a->name)) continue;
            ZR_MF_HEADER();
            fputs(first ? "reload:   globals: " : ", ", out);
            first = 0;
            fprintf(out, "%s removed", zr_s(a->name));
        }
        if (!first) fputc('\n', out);
#undef ZR_MF_HEADER
    }

    static const ZcMfFunc *zr_func_find(const ZcManifest *m, const char *name)
    {
        for (unsigned i = 0; m && i < m->nfuncs; i++)
            if (strcmp(zr_s(m->funcs[i].name), name) == 0) return &m->funcs[i];
        return NULL;
    }

    // ---- Moving state to a new layout -------------------------------------------------
    //
    // When a type the program's state is made of changes, the state's bytes are moved to the
    // new layout using both versions' manifests: fields by name (into nested structs too),
    // arrays element by element, enums by variant name, numbers converted to a new numeric
    // type. A field that is new keeps what the destination already holds (zero, or a
    // global's initial value). What can't be moved is a pointer to a type that changed: the
    // data behind it is in the old layout, and how much of it there is isn't known. A version
    // that would need that is not loaded.

    typedef struct
    {
        int dry;          // only find problems; write nothing
        int problems;     // things that can't be moved
        FILE *notes;      // what was not simply kept, "; "-separated, or NULL
        int nnotes;
        FILE *why;        // the problems, for the refusal message
        const ZcManifest *old;
        const ZcManifest *now;
    } ZrMove;

    static void zr_move_note(ZrMove *mv, const char *path, const char *fmt, ...)
    {
        if (mv->dry || !mv->notes) return;
        fputs(mv->nnotes++ ? ", " : "", mv->notes);
        if (path && *path) fprintf(mv->notes, "%s ", path);
        va_list ap;
        va_start(ap, fmt);
        vfprintf(mv->notes, fmt, ap);
        va_end(ap);
    }

    static void zr_move_problem(ZrMove *mv, const char *path, const char *fmt, ...)
    {
        if (mv->why)
        {
            fputs(mv->problems ? "; " : "", mv->why);
            fprintf(mv->why, "%s ", path && *path ? path : "the state");
            va_list ap;
            va_start(ap, fmt);
            vfprintf(mv->why, fmt, ap);
            va_end(ap);
        }
        mv->problems++;
    }

    // C's numeric types, for converting a value whose type changed.
    typedef struct { const char *name; unsigned size; int is_float; int is_signed; } ZrNum;
    static const ZrNum zr_nums[] = {
        {"int8_t", 1, 0, 1}, {"uint8_t", 1, 0, 0}, {"int16_t", 2, 0, 1}, {"uint16_t", 2, 0, 0},
        {"int32_t", 4, 0, 1}, {"uint32_t", 4, 0, 0}, {"int64_t", 8, 0, 1}, {"uint64_t", 8, 0, 0},
        {"char", sizeof(char), 0, (char)-1 < 0}, {"signed char", 1, 0, 1}, {"unsigned char", 1, 0, 0},
        {"short", sizeof(short), 0, 1}, {"unsigned short", sizeof(short), 0, 0},
        {"int", sizeof(int), 0, 1}, {"unsigned int", sizeof(int), 0, 0}, {"unsigned", sizeof(int), 0, 0},
        {"long", sizeof(long), 0, 1}, {"unsigned long", sizeof(long), 0, 0},
        {"long long", sizeof(long long), 0, 1}, {"unsigned long long", sizeof(long long), 0, 0},
        {"size_t", sizeof(size_t), 0, 0}, {"ptrdiff_t", sizeof(ptrdiff_t), 0, 1},
        {"intptr_t", sizeof(intptr_t), 0, 1}, {"uintptr_t", sizeof(uintptr_t), 0, 0},
        {"bool", sizeof(_Bool), 0, 0}, {"_Bool", sizeof(_Bool), 0, 0},
        {"float", sizeof(float), 1, 1}, {"double", sizeof(double), 1, 1},
    };

    static const ZrNum *zr_num(const char *type)
    {
        for (size_t i = 0; i < sizeof(zr_nums) / sizeof(zr_nums[0]); i++)
            if (strcmp(zr_nums[i].name, type) == 0) return &zr_nums[i];
        return NULL;
    }

    static long double zr_num_read(const ZrNum *n, const unsigned char *p, int *is_int, long long *i,
                                   unsigned long long *u)
    {
        *is_int = !n->is_float;
        if (n->is_float)
        {
            if (n->size == sizeof(float)) { float f; memcpy(&f, p, sizeof f); return f; }
            double d; memcpy(&d, p, sizeof d); return d;
        }
        unsigned long long raw = 0;
        switch (n->size)
        {
        case 1: { uint8_t v; memcpy(&v, p, 1); raw = v; if (n->is_signed) *i = (int8_t)v; break; }
        case 2: { uint16_t v; memcpy(&v, p, 2); raw = v; if (n->is_signed) *i = (int16_t)v; break; }
        case 4: { uint32_t v; memcpy(&v, p, 4); raw = v; if (n->is_signed) *i = (int32_t)v; break; }
        default: { uint64_t v; memcpy(&v, p, 8); raw = v; if (n->is_signed) *i = (int64_t)v; break; }
        }
        if (!n->is_signed) *i = (long long)raw;
        *u = n->is_signed ? (unsigned long long)*i : raw;
        return n->is_signed ? (long double)*i : (long double)raw;
    }

    static void zr_num_write(const ZrNum *n, unsigned char *p, long double f, int is_int, long long i,
                             unsigned long long u)
    {
        if (n->is_float)
        {
            if (n->size == sizeof(float)) { float v = (float)f; memcpy(p, &v, sizeof v); }
            else { double v = (double)f; memcpy(p, &v, sizeof v); }
            return;
        }
        unsigned long long raw = is_int ? (n->is_signed ? (unsigned long long)i : u)
                                        : (unsigned long long)(long long)f;
        switch (n->size)
        {
        case 1: { uint8_t v = (uint8_t)raw; memcpy(p, &v, 1); break; }
        case 2: { uint16_t v = (uint16_t)raw; memcpy(p, &v, 2); break; }
        case 4: { uint32_t v = (uint32_t)raw; memcpy(p, &v, 4); break; }
        default: { uint64_t v = (uint64_t)raw; memcpy(p, &v, 8); break; }
        }
    }

    static long long zr_int_read(const unsigned char *p, unsigned size)
    {
        switch (size)
        {
        case 1: { int8_t v; memcpy(&v, p, 1); return v; }
        case 2: { int16_t v; memcpy(&v, p, 2); return v; }
        case 4: { int32_t v; memcpy(&v, p, 4); return v; }
        default: { int64_t v; memcpy(&v, p, 8); return v; }
        }
    }

    static void zr_int_write(unsigned char *p, unsigned size, long long value)
    {
        switch (size)
        {
        case 1: { int8_t v = (int8_t)value; memcpy(p, &v, 1); break; }
        case 2: { int16_t v = (int16_t)value; memcpy(p, &v, 2); break; }
        case 4: { int32_t v = (int32_t)value; memcpy(p, &v, 4); break; }
        default: { int64_t v = (int64_t)value; memcpy(p, &v, 8); break; }
        }
    }

    // "T[N]...": the element type ("T..." with the first [N] removed) into `elem`, and N.
    static int zr_array_of(const char *type, char *elem, size_t size, unsigned *count)
    {
        const char *lb = strchr(type, '[');
        if (!lb || strchr(type, '(')) return 0;
        const char *rb = strchr(lb, ']');
        if (!rb) return 0;
        *count = (unsigned)strtoul(lb + 1, NULL, 10);
        size_t head = (size_t)(lb - type);
        while (head > 0 && type[head - 1] == ' ') head--;
        if (head + strlen(rb + 1) + 1 > size || *count == 0) return 0;
        memcpy(elem, type, head);
        strcpy(elem + head, rb + 1);
        return 1;
    }

    // The type a pointer type points to ("State" for "State*"), into `buf`, or NULL.
    static const char *zr_pointee(const char *type, char *buf, size_t size)
    {
        if (strchr(type, '(')) return NULL; // a function pointer
        size_t n = strlen(type);
        while (n > 0 && type[n - 1] == ' ') n--;
        if (n == 0 || type[n - 1] != '*') return NULL;
        n--;
        while (n > 0 && type[n - 1] == ' ') n--;
        const char *t = type;
        if (strncmp(t, "const ", 6) == 0) { t += 6; n -= 6; }
        if (strncmp(t, "struct ", 7) == 0) { t += 7; n -= 7; }
        if (n == 0 || n >= size) return NULL;
        memcpy(buf, t, n);
        buf[n] = 0;
        return buf;
    }

    static const ZcMfField *zr_field_find(const ZcMfType *t, const char *name)
    {
        for (unsigned i = 0; i < t->nfields; i++)
            if (strcmp(zr_s(t->fields[i].name), name) == 0) return &t->fields[i];
        return NULL;
    }

    static const ZcMfVariant *zr_variant_by_name(const ZcMfType *t, const char *name)
    {
        for (unsigned i = 0; i < t->nvariants; i++)
            if (strcmp(zr_s(t->variants[i].name), name) == 0) return &t->variants[i];
        return NULL;
    }

    static const ZcMfVariant *zr_variant_by_value(const ZcMfType *t, long long value)
    {
        for (unsigned i = 0; i < t->nvariants; i++)
            if (t->variants[i].value == value) return &t->variants[i];
        return NULL;
    }

    static void zr_move_value(ZrMove *mv, const char *path, const char *otype, unsigned osize,
                              const unsigned char *src, const char *ntype, unsigned nsize,
                              unsigned char *dst, int depth);

    // The size of a value of C type `type`, if the manifests or zr_nums know it, else 0.
    static unsigned zr_type_size(const ZcManifest *m, const char *type)
    {
        const ZcMfType *t = zr_mf_find(m, type);
        if (t) return t->size;
        const ZrNum *n = zr_num(type);
        if (n) return n->size;
        char buf[256];
        if (zr_pointee(type, buf, sizeof buf)) return sizeof(void *);
        return 0;
    }

    // A struct or union described by both manifests, moved field by field.
    static void zr_move_fields(ZrMove *mv, const char *path, const ZcMfType *ot,
                               const unsigned char *src, const ZcMfType *nt, unsigned char *dst,
                               int depth)
    {
        char sub[512];
        for (unsigned i = 0; i < nt->nfields; i++)
        {
            const ZcMfField *nf = &nt->fields[i];
            const ZcMfField *of = zr_field_find(ot, zr_s(nf->name));
            snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(nf->name));
            if (!of)
            {
                zr_move_note(mv, sub, "added");
                continue;
            }
            if (of->bits || nf->bits)
            {
                // A bit-field has no address of its own: it is kept only if nothing about it
                // changed, and the whole struct is copied then (zr_move_value).
                zr_move_note(mv, sub, "(a bit-field) not carried");
                continue;
            }
            zr_move_value(mv, sub, zr_s(of->type), of->size, src + of->offset, zr_s(nf->type),
                          nf->size, dst + nf->offset, depth + 1);
        }
        for (unsigned j = 0; j < ot->nfields; j++)
        {
            if (zr_field_find(nt, zr_s(ot->fields[j].name))) continue;
            snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(ot->fields[j].name));
            zr_move_note(mv, sub, "dropped");
        }
    }

    // Two descriptions of a container whose own fields are laid out alike (only what they
    // point to differs).
    static int zr_mf_same_shape(const ZcMfType *a, const ZcMfType *b)
    {
        if (a->size != b->size || a->nfields != b->nfields) return 0;
        for (unsigned i = 0; i < a->nfields; i++)
            if (strcmp(zr_s(a->fields[i].name), zr_s(b->fields[i].name)) ||
                a->fields[i].offset != b->fields[i].offset || a->fields[i].size != b->fields[i].size)
                return 0;
        return 1;
    }

    static unsigned long long zr_field_int(const ZcMfType *t, const unsigned char *p, const char *name)
    {
        const ZcMfField *f = zr_field_named(t, name);
        return f ? (unsigned long long)zr_int_read(p + f->offset, f->size) : 0;
    }

    static void *zr_field_ptr(const ZcMfType *t, const unsigned char *p, const char *name)
    {
        const ZcMfField *f = zr_field_named(t, name);
        void *v = NULL;
        if (f && f->size == sizeof v) memcpy(&v, p + f->offset, sizeof v);
        return v;
    }

    // A std container (zr_container) whose element type changed: a new buffer, of the same
    // capacity, holding each element it holds moved to the new layout, at the same place
    // in it; the container is pointed at it, the rest of it as it was. The old buffer is
    // left as it is (going back after a crash puts back a container pointing to it).
    static void zr_move_container(ZrMove *mv, const char *path, const ZcMfType *ot,
                                  const unsigned char *src, const ZcMfType *nt, unsigned char *dst,
                                  int kind, const char *elem, int depth)
    {
        char obuf[256];
        const char *oelem = NULL;
        int okind = zr_container(ot, obuf, sizeof obuf, &oelem);
        unsigned oes = oelem ? zr_type_size(mv->old, oelem) : 0, nes = zr_type_size(mv->now, elem);
        if (okind != kind || !oes || !nes || !zr_mf_same_shape(ot, nt))
        {
            zr_move_note(mv, path, "(a %s) not carried", zr_s(nt->zc_name));
            return;
        }
        if (mv->dry) return;
        static const char *const buffer_field[] = {0, "data", "data", "vals", "ptr"};
        const unsigned char *odata = (const unsigned char *)zr_field_ptr(ot, src, buffer_field[kind]);
        unsigned long long cap = kind == ZR_BOX ? 1 : zr_field_int(ot, src, "cap");
        unsigned long long held = 0;
        unsigned char *ndata = NULL;
        memcpy(dst, src, nt->size < ot->size ? nt->size : ot->size); // what isn't the buffer
        if (cap && odata)
        {
            ndata = (unsigned char *)calloc((size_t)cap, nes);
            if (!ndata)
            {
                zr_move_note(mv, path, "(a %s) not carried: out of memory", zr_s(nt->zc_name));
                return;
            }
            unsigned long long len = kind == ZR_VEC ? zr_field_int(ot, src, "len")
                                     : kind == ZR_QUEUE ? zr_field_int(ot, src, "count")
                                     : kind == ZR_BOX   ? 1
                                                        : cap;
            unsigned long long head = kind == ZR_QUEUE ? zr_field_int(ot, src, "head") : 0;
            const unsigned char *occ = kind == ZR_MAP ? (const unsigned char *)zr_field_ptr(ot, src, "occupied") : NULL;
            const unsigned char *del = kind == ZR_MAP ? (const unsigned char *)zr_field_ptr(ot, src, "deleted") : NULL;
            if (len > cap) len = cap;
            // The notes of the first element only: the others say the same.
            FILE *notes = mv->notes;
            char sub[512];
            snprintf(sub, sizeof sub, "%s%s%s[]", path, *path ? "." : "", buffer_field[kind]);
            for (unsigned long long i = 0; i < len; i++)
            {
                unsigned long long at = kind == ZR_QUEUE ? (head + i) % cap : i;
                if (kind == ZR_MAP && (!occ || !occ[at] || (del && del[at]))) continue;
                if (held++ == 1) mv->notes = NULL;
                zr_move_value(mv, sub, oelem, oes, odata + at * oes, elem, nes, ndata + at * nes, depth + 1);
            }
            mv->notes = notes;
        }
        const ZcMfField *nb = zr_field_named(nt, buffer_field[kind]);
        memcpy(dst + nb->offset, &ndata, sizeof ndata);
        const ZcMfType *et = zr_mf_find(mv->now, elem);
        zr_move_note(mv, path, "(a %s) %llu element%s moved to the new layout",
                     zr_s(nt->zc_name), held, held == 1 ? "" : "s");
        (void)et;
    }

    // One value of type `otype` (osize bytes at src) into `ntype` (nsize bytes at dst).
    static void zr_move_value(ZrMove *mv, const char *path, const char *otype, unsigned osize,
                              const unsigned char *src, const char *ntype, unsigned nsize,
                              unsigned char *dst, int depth)
    {
        if (depth > 64) return;
        const ZcMfType *ot = zr_mf_find(mv->old, otype), *nt = zr_mf_find(mv->now, ntype);
        char obuf[256], nbuf[256];

        // A type the manifests describe.
        if (ot || nt)
        {
            if (!ot || !nt || strcmp(otype, ntype) != 0)
            {
                zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
                return;
            }
            if (!zr_mf_changed(mv->old, mv->now, ntype, 0, NULL))
            {
                if (!mv->dry) memcpy(dst, src, osize < nsize ? osize : nsize);
                return;
            }
            if (ot->kind != nt->kind)
            {
                zr_move_note(mv, path, "is now a different kind of type, not carried");
                return;
            }
            char eb[256];
            const char *celem = NULL;
            int ckind = nt->kind == 1 ? zr_container(nt, eb, sizeof eb, &celem) : 0;
            if (ckind)
            {
                zr_move_container(mv, path, ot, src, nt, dst, ckind, celem, depth);
                return;
            }
            if (nt->kind == 1) // struct
            {
                zr_move_fields(mv, path, ot, src, nt, dst, depth);
                return;
            }
            if (nt->kind == 3) // enum: by variant name
            {
                const ZcMfVariant *ov = zr_variant_by_value(ot, zr_int_read(src, ot->size));
                const ZcMfVariant *nv = ov ? zr_variant_by_name(nt, zr_s(ov->name)) : NULL;
                if (!nv)
                {
                    zr_move_note(mv, path, "was %s, which is gone; not carried",
                                 ov ? zr_s(ov->name) : "an unknown value");
                    return;
                }
                if (!mv->dry) zr_int_write(dst, nt->size, nv->value);
                return;
            }
            if (nt->kind == 4) // enum with payloads: the tag by name, then the payload
            {
                const ZcMfField *otag = zr_field_find(ot, "tag"), *ntag = zr_field_find(nt, "tag");
                const ZcMfField *odat = zr_field_find(ot, "data"), *ndat = zr_field_find(nt, "data");
                if (!otag || !ntag || !odat || !ndat) return;
                const ZcMfVariant *ov = zr_variant_by_value(ot, zr_int_read(src + otag->offset, otag->size));
                const ZcMfVariant *nv = ov ? zr_variant_by_name(nt, zr_s(ov->name)) : NULL;
                if (!nv)
                {
                    zr_move_note(mv, path, "was %s, which is gone; not carried",
                                 ov ? zr_s(ov->name) : "an unknown variant");
                    return;
                }
                if (!mv->dry) zr_int_write(dst + ntag->offset, ntag->size, nv->value);
                if (!ov->payload && !nv->payload) return;
                char sub[512];
                snprintf(sub, sizeof sub, "%s(%s)", path, zr_s(nv->name));
                if (!ov->payload || !nv->payload)
                {
                    zr_move_note(mv, sub, "payload changed, not carried");
                    return;
                }
                unsigned ops = zr_type_size(mv->old, ov->payload), nps = zr_type_size(mv->now, nv->payload);
                if (!ops || !nps || ops > odat->size || nps > ndat->size)
                {
                    zr_move_note(mv, sub, "payload not carried");
                    return;
                }
                zr_move_value(mv, sub, ov->payload, ops, src + odat->offset, nv->payload, nps,
                              dst + ndat->offset, depth + 1);
                return;
            }
            zr_move_note(mv, path, "(a %s) changed, not carried", nt->kind == 2 ? "union" : "vector");
            return;
        }

        // Arrays: element by element.
        unsigned on = 0, nn = 0;
        char oelem[256], nelem[256];
        int oarr = zr_array_of(otype, oelem, sizeof oelem, &on);
        int narr = zr_array_of(ntype, nelem, sizeof nelem, &nn);
        if (oarr || narr)
        {
            if (!oarr || !narr)
            {
                zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
                return;
            }
            unsigned oes = osize / on, nes = nsize / nn;
            unsigned n = on < nn ? on : nn;
            char sub[512];
            // The notes are the first element's, once, as "rocks[]": the others' are the same
            // apart from enum values.
            snprintf(sub, sizeof sub, "%s[]", path);
            for (unsigned i = 0; i < n; i++)
            {
                ZrMove each = *mv;
                if (i > 0) each.notes = NULL;
                zr_move_value(&each, sub, oelem, oes, src + i * oes, nelem, nes, dst + i * nes,
                              depth + 1);
                mv->problems = each.problems;
                mv->nnotes = i == 0 ? each.nnotes : mv->nnotes;
            }
            if (on != nn) zr_move_note(mv, path, "now has %u elements (was %u)", nn, on);
            if (strcmp(oelem, nelem) != 0)
                zr_move_note(mv, path, "elements retyped from %s to %s", oelem, nelem);
            return;
        }

        // Pointers: kept, unless what they point to changed.
        const char *op = zr_pointee(otype, obuf, sizeof obuf);
        const char *np = zr_pointee(ntype, nbuf, sizeof nbuf);
        if (op || np || strchr(otype, '(') || strchr(ntype, '('))
        {
            if (strcmp(otype, ntype) != 0 || osize != nsize)
            {
                zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
                return;
            }
            if (np && zr_mf_find(mv->now, np) && zr_mf_changed(mv->old, mv->now, np, 0, NULL))
            {
                zr_move_problem(mv, path, "points to a %s, whose layout changed", np);
                return;
            }
            if (!mv->dry) memcpy(dst, src, nsize);
            return;
        }

        // Numbers, and C types the manifests don't describe.
        if (strcmp(otype, ntype) == 0 && osize == nsize)
        {
            if (!mv->dry) memcpy(dst, src, nsize);
            return;
        }
        const ZrNum *on_ = zr_num(otype), *nn_ = zr_num(ntype);
        if (on_ && nn_ && on_->size == osize && nn_->size == nsize)
        {
            int is_int = 0;
            long long i = 0;
            unsigned long long u = 0;
            long double f = zr_num_read(on_, src, &is_int, &i, &u);
            if (!mv->dry) zr_num_write(nn_, dst, f, is_int, i, u);
            zr_move_note(mv, path, "converted from %s to %s", otype, ntype);
            return;
        }
        zr_move_note(mv, path, "retyped from %s to %s, not carried", otype, ntype);
    }

    // Every pointer reachable by value from a value of C type `type` (in fields, array
    // elements and enum payloads), checked: one to a type whose layout changed is a problem,
    // whether or not `type` itself changed.
    static void zr_check_pointers(ZrMove *mv, const char *path, const char *type, int depth)
    {
        if (depth > 64 || !type) return;
        char buf[256], elem[256];
        unsigned n = 0;
        if (zr_array_of(type, elem, sizeof elem, &n))
        {
            char sub[512];
            snprintf(sub, sizeof sub, "%s[]", path);
            zr_check_pointers(mv, sub, elem, depth + 1);
            return;
        }
        const char *p = zr_pointee(type, buf, sizeof buf);
        if (p)
        {
            if (zr_mf_find(mv->now, p) && zr_mf_changed(mv->old, mv->now, p, 0, NULL))
                zr_move_problem(mv, path, "points to a %s, whose layout changed", p);
            return;
        }
        const ZcMfType *t = zr_mf_find(mv->now, type);
        if (!t) return;
        char sub[512];
        char ebuf[256];
        const char *vec_elem = zr_vec_elem(t, ebuf, sizeof ebuf);
        if (vec_elem) // its buffer is moved: what its elements point to is what matters
        {
            snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", "[]");
            zr_check_pointers(mv, sub, vec_elem, depth + 1);
            return;
        }
        for (unsigned i = 0; i < t->nfields; i++)
        {
            if (t->kind == 4) break; // tag and data: the payloads are below
            snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(t->fields[i].name));
            zr_check_pointers(mv, sub, t->fields[i].type, depth + 1);
        }
        for (unsigned i = 0; t->kind == 4 && i < t->nvariants; i++)
        {
            if (!t->variants[i].payload) continue;
            snprintf(sub, sizeof sub, "%s(%s)", path, zr_s(t->variants[i].name));
            zr_check_pointers(mv, sub, t->variants[i].payload, depth + 1);
        }
    }

    // ---- What the host's state is -------------------------------------------------------
    //
    // The state block the host keeps (keep_state) is what the functions it looked up take a
    // pointer to: the one struct, union or enum the manifest describes among their pointer
    // parameters. NULL if there is none; `ambiguous` if there are several.
    static const char *zr_state_type(ZrReloader *r, const ZcManifest *m, int *ambiguous)
    {
        static char found[256];
        char buf[256];
        found[0] = 0;
        *ambiguous = 0;
        if (!m) return NULL;
        for (int i = 0; i < r->fetched_count; i++)
        {
            const ZcMfFunc *f = zr_func_find(m, r->fetched[i]);
            for (unsigned j = 0; f && j < f->nparams; j++)
            {
                const char *t = zr_pointee(zr_s(f->params[j]), buf, sizeof buf);
                if (!t || !zr_mf_find(m, t)) continue;
                if (!found[0]) snprintf(found, sizeof found, "%s", t);
                else if (strcmp(found, t) != 0) *ambiguous = 1;
            }
        }
        return found[0] ? found : NULL;
    }

    // ---- Globals that outlive the code ---------------------------------------------------
    //
    // The module's globals (those `zc transpile --reload` lists in the manifest) are defined
    // when it is compiled with ZC_RELOAD_OWN_GLOBALS and declared extern otherwise. The first
    // version defines them; every later one is compiled to use the store: storage that
    // outlives the code, so the values, and pointers to them, survive the reload. When the
    // globals change (one is added, retyped, or holds a type whose layout changed), a
    // version that defines them shows what they are now; the ones that changed get storage
    // of their own, holding their initial value (zr_store_extend), and the new version is
    // compiled against the store again. Every other global keeps its storage, and pointers
    // to it stay good. A version that owns globals is never deleted before free():
    // something may still point into its storage.

    static const ZcManifest *zr_version_manifest(ZrVersion *v)
    {
        const ZcManifest *(*get)(void) =
            (const ZcManifest *(*)(void))zr_sym(v, "_zc_manifest");
        const ZcManifest *m = get ? get() : NULL;
        return m && m->format >= 5 ? m : NULL; // the layout this file reads
    }

    enum { ZR_FRESH = 0x100 }; // a store entry given storage of its own by this reload

    static void zr_globals_free(ZcMfGlobal *g, unsigned n)
    {
        for (unsigned i = 0; i < n; i++)
        {
            free((void *)g[i].name);
            free((void *)g[i].type);
        }
        zr_gidx_forget(g);
        free(g);
    }

    // A copy of n globals, with their names and types, holding room for `extra` more.
    static ZcMfGlobal *zr_globals_dup(const ZcMfGlobal *g, unsigned n, unsigned extra)
    {
        ZcMfGlobal *d = (ZcMfGlobal *)calloc(n + extra ? n + extra : 1, sizeof(ZcMfGlobal));
        for (unsigned i = 0; d && i < n; i++)
        {
            d[i] = g[i];
            d[i].name = zr_strdup(g[i].name);
            d[i].type = zr_strdup(g[i].type);
            d[i].init = NULL; // the store only needs names, types and addresses
        }
        return d;
    }

    static void zr_store_free(ZrReloader *r)
    {
        zr_globals_free(r->store, r->nstore);
        r->store = NULL;
        r->nstore = 0;
    }

    // The store as it was before zr_store_extend: dropped (`keep`), or put back.
    static void zr_store_settle(ZrReloader *r, int keep)
    {
        if (!r->store_prev) return;
        if (keep)
        {
            zr_globals_free(r->store_prev, r->nstore_prev);
            for (unsigned i = 0; i < r->nstore; i++) r->store[i].flags &= ~(unsigned)ZR_FRESH;
        }
        else
        {
            zr_store_free(r);
            r->store = r->store_prev;
            r->nstore = r->nstore_prev;
        }
        r->store_prev = NULL;
        r->nstore_prev = 0;
    }

    // `probe` is the new version compiled to define its globals: what they are now. Each one
    // the store has, of the same type and layout, keeps its storage. The others (added,
    // retyped, or holding a type whose layout changed) get storage of their own, holding
    // the probe's initial value, marked ZR_FRESH; values are moved into it like into a new
    // version's (zr_move_state). Globals gone stay in the store: something may point there.
    // The store as it was is kept in store_prev until zr_store_settle.
    static int zr_store_extend(ZrReloader *r, ZrVersion *probe)
    {
        ZcManifest *m = zr_mf_copy(zr_version_manifest(probe));
        if (!m || !r->store) { zr_mf_free(m); return 0; }
        ZcMfGlobal *st = zr_globals_dup(r->store, r->nstore, m->nglobals);
        void **blocks = (void **)realloc(r->blocks, (r->nblocks + m->nglobals + 1) * sizeof(void *));
        if (!st || !blocks)
        {
            if (blocks) r->blocks = blocks;
            zr_globals_free(st, r->nstore);
            zr_mf_free(m);
            return 0;
        }
        r->blocks = blocks;
        unsigned n = r->nstore;
        for (unsigned i = 0; i < m->nglobals; i++)
        {
            const ZcMfGlobal *g = &m->globals[i];
            const ZcMfGlobal *old = zr_global_find(r->store, r->nstore, g->name);
            if (old && !strcmp(zr_s(old->type), zr_s(g->type)) && old->size == g->size &&
                !zr_global_type_changed(r->types_now, m, g, NULL))
                continue;
            size_t size = ((size_t)g->size + 63) & ~(size_t)63;
            void *mem = aligned_alloc(64, size ? size : 64); // aligned for any type
            if (!mem) continue;
            memset(mem, 0, size ? size : 64);
            if (g->addr && g->size) memcpy(mem, g->addr, g->size);
            r->blocks[r->nblocks++] = mem;
            ZcMfGlobal *e = old ? &st[old - r->store] : &st[n++];
            if (old)
            {
                if (old->flags & 2) // an old vtable still read by old trait objects
                {
                    ZcMfGlobal *grown = (ZcMfGlobal *)realloc(r->old_vtables, (r->nold_vtables + 1) * sizeof(ZcMfGlobal));
                    if (grown)
                    {
                        r->old_vtables = grown;
                        ZcMfGlobal *o = &r->old_vtables[r->nold_vtables++];
                        memset(o, 0, sizeof(*o));
                        o->name = zr_strdup(old->name);
                        o->type = zr_strdup(old->type);
                        o->size = old->size;
                        o->addr = old->addr;
                    }
                }
                free((void *)e->type);
            }
            else
                e->name = zr_strdup(g->name);
            e->type = zr_strdup(g->type);
            e->size = g->size;
            e->addr = mem;
            e->flags = g->flags | ZR_FRESH;
        }
        zr_mf_free(m);
        r->store_prev = r->store;
        r->nstore_prev = r->nstore;
        r->store = st;
        r->nstore = n;
        return 1;
    }

    // The globals of `m`, from the version that owns them, as the ones to share from now on.
    static void zr_store_set(ZrReloader *r, const ZcManifest *m)
    {
        zr_store_free(r);
        if (!m || !m->nglobals) return;
        r->store = (ZcMfGlobal *)calloc(m->nglobals, sizeof(ZcMfGlobal));
        if (!r->store) return;
        r->nstore = m->nglobals;
        for (unsigned i = 0; i < m->nglobals; i++)
        {
            r->store[i] = m->globals[i];
            r->store[i].name = zr_strdup(m->globals[i].name);
            r->store[i].type = zr_strdup(m->globals[i].type);
            r->store[i].init = NULL; // the store only needs names, types and addresses
        }
    }

    // Compile the module's C into `v`, defining its globals (`own`) or using the ones in the
    // store. Errors are printed only for a version that defines them: a failure to use the
    // store is retried that way.
    // tcc writes an object file with debug information (beside the C file, removed once read),
    // and the Reloader loads it (zl_load), registered with debuggers: breakpoints by .zc file
    // and line (the C's #line directives) bind in every version as it loads, and backtraces
    // and variables read through it. DWARF with libtcc 0.9.28 (-gdwarf); 0.9.27 writes stabs,
    // which gdb no longer binds breakpoints in. If the Reloader can't load it, or with
    // ZC_RELOAD_MEMORY=1, libtcc compiles it into memory instead, where a debugger sees no
    // symbols.
    static int zr_compile_memory(ZrReloader *r, ZrVersion *v, int own);

    #ifdef ZR_LOADER
    // Where a version that uses the store finds each global: there (zl_load's resolver).
    static void *zr_resolve_store(void *ctx, const char *name)
    {
        ZrReloader *r = (ZrReloader *)ctx;
        const ZcMfGlobal *g = zr_global_find(r->store, r->nstore, name);
        return g ? g->addr : NULL;
    }
    #endif

    static int zr_compile(ZrReloader *r, ZrVersion *v, int own)
    {
    #ifdef ZR_LOADER
        if (r->in_memory) return zr_compile_memory(r, v, own);
        memset(v, 0, sizeof(*v));
        v->tcc = tcc_new();
        if (!v->tcc) return -1;
        tcc_set_error_func(v->tcc, NULL, own ? zr_on_tcc_error : zr_on_tcc_quiet);
    #ifdef TCC_RELOCATE_AUTO
        tcc_set_options(v->tcc, "-g");
    #else
        tcc_set_options(v->tcc, "-gdwarf");
    #endif
        tcc_set_output_type(v->tcc, TCC_OUTPUT_OBJ);
        for (int i = 0; i < r->include_count; i++) tcc_add_include_path(v->tcc, r->includes[i]);
        // A thread-local is an ordinary global of the module, shared by its threads (see
        // zr_compile_memory).
        tcc_define_symbol(v->tcc, "_Thread_local", "");
        tcc_define_symbol(v->tcc, "__thread", "");
        if (own) tcc_define_symbol(v->tcc, "ZC_RELOAD_OWN_GLOBALS", "1");
        if (tcc_add_file(v->tcc, r->c_file) == -1)
        {
            zr_version_delete(v);
            return -1; // the C doesn't compile: not a reason to change how it's loaded
        }
        size_t len = strlen(r->c_file) + 64;
        char *obj = (char *)malloc(len);
        unsigned char *img = NULL;
        size_t img_size = 0;
        if (obj)
        {
            snprintf(obj, len, "%s.%d.o", r->c_file, (int)getpid());
            if (tcc_output_file(v->tcc, obj) == 0) img = zl_read_file(obj, &img_size);
            remove(obj);
            free(obj);
        }
        tcc_delete(v->tcc);
        v->tcc = NULL;
        char err[512] = "the object file couldn't be written or read";
        int module_fault = 0;
        if (img)
            v->im = zl_load(img, img_size, own ? NULL : zr_resolve_store, r, own, &module_fault,
                            err, sizeof err);
        if (!v->im && module_fault)
        {
            // What the module's C itself got wrong (a name nothing defines): as tcc reports it.
            if (own) fprintf(stderr, "reload: tcc: %s\n", err);
            zr_version_delete(v);
            return -1;
        }
        if (!v->im)
        {
            if (r->verbose)
                fprintf(stderr, "reload: the module can't be loaded by the Reloader (%s); "
                                "libtcc loads it instead, where a debugger sees no symbols\n",
                        err);
            zr_version_delete(v);
            r->in_memory = 1;
            return zr_compile_memory(r, v, own);
        }
        v->loaded = 1;
        const ZcManifest *m = own ? zr_version_manifest(v) : NULL;
        v->owns_globals = m && m->nglobals > 0;
        return 0;
    #else
        return zr_compile_memory(r, v, own);
    #endif
    }

    static int zr_compile_memory(ZrReloader *r, ZrVersion *v, int own)
    {
        memset(v, 0, sizeof(*v));
        v->tcc = tcc_new();
        if (!v->tcc) return -1;
        tcc_set_error_func(v->tcc, NULL, own ? zr_on_tcc_error : zr_on_tcc_quiet);
        tcc_set_output_type(v->tcc, TCC_OUTPUT_MEMORY);
        for (int i = 0; i < r->include_count; i++) tcc_add_include_path(v->tcc, r->includes[i]);
        // libtcc can't give code compiled into memory thread-local storage (0.9.27 doesn't
        // know _Thread_local; 0.9.28 refuses it), and std/core.zc and the generated C use it:
        // a thread-local is an ordinary global of the module, shared by its threads.
        tcc_define_symbol(v->tcc, "_Thread_local", "");
        tcc_define_symbol(v->tcc, "__thread", "");
        if (own) tcc_define_symbol(v->tcc, "ZC_RELOAD_OWN_GLOBALS", "1");
        else
            for (unsigned i = 0; i < r->nstore; i++)
                tcc_add_symbol(v->tcc, r->store[i].name, r->store[i].addr);
        if (tcc_add_file(v->tcc, r->c_file) == -1 || zr_relocate(v) < 0)
        {
            zr_version_delete(v);
            return -1;
        }
        // A version owns globals only if it has some.
        v->loaded = 1;
        const ZcManifest *m = own ? zr_version_manifest(v) : NULL;
        v->owns_globals = m && m->nglobals > 0;
        return 0;
    }

    // `v`, compiled to use the store, really does: each of its globals is one in the store,
    // of the same type, at the store's address (not, say, a variable of the same name that
    // the host exports).
    //
    // Nor may a global's type have changed (a struct it holds rearranged, say): its old bytes
    // can't be read as the new layout.
    static int zr_globals_shared(ZrReloader *r, ZrVersion *v)
    {
        ZcManifest *m = zr_mf_copy(zr_version_manifest(v));
        if (!m) return 0;
        int shared = 1;
        for (unsigned i = 0; i < m->nglobals && shared; i++)
        {
            const ZcMfGlobal *g = &m->globals[i];
            const ZcMfGlobal *s = zr_global_find(r->store, r->nstore, g->name);
            if (!s || strcmp(zr_s(s->type), zr_s(g->type)) || s->size != g->size ||
                s->addr != g->addr ||
                (!(s->flags & ZR_FRESH) && zr_global_type_changed(r->types_now, m, g, NULL)))
                shared = 0;
        }
        zr_mf_free(m);
        return shared;
    }

    // What reloading to the version `next` (its manifest `nm`, sorted) would do to the state:
    // the globals (when `next` owns new storage) and the host's block, moved to the new
    // layout. With `dry`, only the problems are found, into `why`; otherwise the state is
    // moved and what was not simply kept is written to `log`, a line per part.
    static int zr_move_state(ZrReloader *r, ZrVersion *next, const ZcManifest *om,
                             const ZcManifest *nm, int dry, FILE *why, FILE *log)
    {
        ZrMove mv;
        memset(&mv, 0, sizeof mv);
        mv.dry = dry;
        mv.why = why;
        mv.old = om;
        mv.now = nm;

        // The functions the host looked up must still take what it passes them.
        for (int i = 0; i < r->fetched_count; i++)
        {
            const ZcMfFunc *a = zr_func_find(om, r->fetched[i]), *b = zr_func_find(nm, r->fetched[i]);
            if (!a || !b) continue;
            int same = !strcmp(zr_s(a->ret), zr_s(b->ret)) && a->nparams == b->nparams;
            for (unsigned j = 0; same && j < a->nparams; j++)
                same = !strcmp(zr_s(a->params[j]), zr_s(b->params[j]));
            if (!same)
                zr_move_problem(&mv, r->fetched[i], "now takes or returns other types, and the "
                                "host calls it the old way");
        }

        // No pointer in the state may lead to a type whose layout changed.
        if (dry)
        {
            for (unsigned i = 0; i < nm->nglobals; i++)
                if (!(nm->globals[i].flags & 2))
                    zr_check_pointers(&mv, zr_s(nm->globals[i].name), nm->globals[i].type, 0);
            int amb = 0;
            const char *st = r->state ? zr_state_type(r, nm, &amb) : NULL;
            char root[256];
            if (st)
            {
                snprintf(root, sizeof root, "%s", st);
                zr_check_pointers(&mv, "state", root, 0);
            }
        }

        // The globals whose storage changed (all of them, in a version that defines its own;
        // those given storage of their own by zr_store_extend otherwise), from where they were.
        char *text = NULL;
        size_t len = 0;
        const ZcMfGlobal *was = r->store_prev ? r->store_prev : r->store;
        unsigned nwas = r->store_prev ? r->nstore_prev : r->nstore;
        if ((next->owns_globals || r->store_prev) && was)
        {
            const ZcManifest *live = zr_version_manifest(next);
            mv.notes = dry ? NULL : open_memstream(&text, &len);
            mv.nnotes = 0;
            for (unsigned i = 0; live && i < live->nglobals; i++)
            {
                const ZcMfGlobal *g = &live->globals[i];
                const ZcMfGlobal *s = zr_global_find(was, nwas, g->name);
                if (!s || (g->flags & 2) || s->addr == g->addr) continue;
                zr_move_value(&mv, zr_s(g->name), zr_s(s->type), s->size,
                              (const unsigned char *)s->addr, zr_s(g->type), g->size,
                              (unsigned char *)g->addr, 0);
            }
            if (mv.notes)
            {
                fclose(mv.notes);
                if (mv.nnotes && log) fprintf(log, "reload: moved the globals: %s\n", text);
                free(text);
                text = NULL;
                mv.notes = NULL;
            }
        }

        // The host's block, in place.
        if (r->state)
        {
            int amb_old = 0, amb_new = 0;
            char was[256] = "", is[256] = "";
            const char *t = zr_state_type(r, om, &amb_old);
            if (t) snprintf(was, sizeof was, "%s", t);
            t = zr_state_type(r, nm, &amb_new);
            if (t) snprintf(is, sizeof is, "%s", t);
            const ZcMfType *nt = is[0] ? zr_mf_find(nm, is) : NULL;
            const ZcMfType *ot = was[0] ? zr_mf_find(om, was) : NULL;
            int changed = was[0] && is[0] &&
                          (strcmp(was, is) != 0 || zr_mf_changed(om, nm, is, 0, NULL));
            if (changed && (amb_old || amb_new))
                zr_move_problem(&mv, "", "can't be moved: the functions the host looked up take "
                                "pointers to more than one type, so which is the state isn't known");
            else if (changed && strcmp(was, is) != 0)
                zr_move_problem(&mv, "", "is now a %s (it was a %s)", is, was);
            else if (changed && nt && nt->size > r->state_size)
                zr_move_problem(&mv, "", "(%s) no longer fits: %u bytes, and the host's block is %zu",
                                is, nt->size, r->state_size);
            else if (changed && nt && ot)
            {
                unsigned char *old = dry ? r->state : (unsigned char *)malloc(ot->size);
                if (!old) return 1;
                if (!dry)
                {
                    memcpy(old, r->state, ot->size);
                    memset(r->state, 0, r->state_size);
                    mv.notes = open_memstream(&text, &len);
                    mv.nnotes = 0;
                }
                zr_move_value(&mv, "", is, ot->size, old, is, nt->size, r->state, 0);
                if (!dry)
                {
                    free(old);
                    fclose(mv.notes);
                    if (log)
                        fprintf(log, "reload: moved the state (%s) to the new layout%s%s\n", is,
                                mv.nnotes ? ": " : "", mv.nnotes ? text : "");
                    free(text);
                    mv.notes = NULL;
                }
            }
        }
        return mv.problems;
    }

    // The vtables in the storage being replaced, to refresh from now on (zr_reset_globals).
    static void zr_keep_old_vtables(ZrReloader *r)
    {
        for (unsigned i = 0; i < r->nstore; i++)
        {
            const ZcMfGlobal *g = &r->store[i];
            if (!(g->flags & 2)) continue;
            ZcMfGlobal *grown = (ZcMfGlobal *)realloc(r->old_vtables, (r->nold_vtables + 1) * sizeof(ZcMfGlobal));
            if (!grown) return;
            r->old_vtables = grown;
            ZcMfGlobal *o = &r->old_vtables[r->nold_vtables++];
            memset(o, 0, sizeof(*o));
            o->name = zr_strdup(g->name);
            o->type = zr_strdup(g->type);
            o->size = g->size;
            o->addr = g->addr;
        }
    }

    // ---- Function pointers that follow the new code ------------------------------------
    //
    // Every loaded version's functions, by address, with their name and C signature. After a
    // reload, a function pointer in the state (a field of a function pointer type, in the
    // host's block or a global, reached by value) that holds one of them is pointed at the
    // new version's function of the same name and signature.

    static char *zr_fn_sig(const ZcMfFunc *f)
    {
        size_t n = strlen(zr_s(f->ret)) + 3;
        for (unsigned j = 0; j < f->nparams; j++) n += strlen(zr_s(f->params[j])) + 2;
        char *sig = (char *)malloc(n);
        if (!sig) return NULL;
        snprintf(sig, n, "%s(", zr_s(f->ret));
        for (unsigned j = 0; j < f->nparams; j++)
        {
            if (j) strcat(sig, ", ");
            strcat(sig, zr_s(f->params[j]));
        }
        strcat(sig, ")");
        return sig;
    }

    // The one copy of `s` (taken: freed if there is one already), or NULL.
    static const char *zr_intern(ZrReloader *r, char *s)
    {
        if (!s) return NULL;
        if ((r->strs_used + 1) * 2 > r->strs_cap)
        {
            unsigned cap = r->strs_cap ? r->strs_cap * 2 : 4096;
            char **t = (char **)calloc(cap, sizeof(char *));
            if (!t) { free(s); return NULL; }
            for (unsigned i = 0; i < r->strs_cap; i++)
            {
                if (!r->strs[i]) continue;
                unsigned k = zr_hash(r->strs[i]) & (cap - 1);
                while (t[k]) k = (k + 1) & (cap - 1);
                t[k] = r->strs[i];
            }
            free(r->strs);
            r->strs = t;
            r->strs_cap = cap;
        }
        unsigned k = zr_hash(s) & (r->strs_cap - 1);
        for (; r->strs[k]; k = (k + 1) & (r->strs_cap - 1))
            if (!strcmp(r->strs[k], s)) { free(s); return r->strs[k]; }
        r->strs[k] = s;
        r->strs_used++;
        return s;
    }

    static unsigned zr_addr_hash(void *addr)
    {
        uintptr_t a = (uintptr_t)addr;
        a ^= a >> 33;
        a *= 0xff51afd7ed558ccdULL;
        a ^= a >> 33;
        return (unsigned)a;
    }

    static void zr_fn_index(ZrReloader *r, unsigned i)
    {
        unsigned k = zr_addr_hash(r->fns[i].addr) & (r->fn_slot_cap - 1);
        while (r->fn_slot[k]) k = (k + 1) & (r->fn_slot_cap - 1);
        r->fn_slot[k] = i + 1;
    }

    static void zr_note_fns(ZrReloader *r, const ZcManifest *m)
    {
        for (unsigned i = 0; m && i < m->nfuncs; i++)
        {
            if (!m->funcs[i].addr) continue;
            if (r->nfns == r->fns_cap)
            {
                unsigned cap = r->fns_cap ? r->fns_cap * 2 : 256;
                struct ZrFn *grown = (struct ZrFn *)realloc(r->fns, cap * sizeof(struct ZrFn));
                if (!grown) return;
                r->fns = grown;
                r->fns_cap = cap;
            }
            if ((r->nfns + 1) * 2 > r->fn_slot_cap)
            {
                unsigned cap = r->fn_slot_cap ? r->fn_slot_cap * 2 : 1024;
                unsigned *t = (unsigned *)calloc(cap, sizeof(unsigned));
                if (!t) return;
                free(r->fn_slot);
                r->fn_slot = t;
                r->fn_slot_cap = cap;
                for (unsigned k = 0; k < r->nfns; k++) zr_fn_index(r, k);
            }
            r->fns[r->nfns].addr = m->funcs[i].addr;
            r->fns[r->nfns].name = zr_intern(r, zr_strdup(m->funcs[i].name));
            r->fns[r->nfns].sig = zr_intern(r, zr_fn_sig(&m->funcs[i]));
            zr_fn_index(r, r->nfns);
            r->nfns++;
        }
    }

    // The function at `addr` (the first noted there), or NULL.
    static const struct ZrFn *zr_fn_at(ZrReloader *r, void *addr)
    {
        if (!r->fn_slot_cap) return NULL;
        const struct ZrFn *found = NULL;
        unsigned k = zr_addr_hash(addr) & (r->fn_slot_cap - 1);
        for (; r->fn_slot[k]; k = (k + 1) & (r->fn_slot_cap - 1))
        {
            const struct ZrFn *f = &r->fns[r->fn_slot[k] - 1];
            if (f->addr == addr && (!found || f < found)) found = f;
        }
        return found;
    }

    // Through the value of C type `type` at `p`, every function pointer to an old function,
    // pointed at the new version's (manifest `m`). Each one moved, or kept, is noted in `log`.
    static int zr_stub_at(ZrReloader *r, void *addr);

    static void zr_repoint(ZrReloader *r, const ZcManifest *m, const char *path, const char *type,
                           unsigned char *p, unsigned size, FILE *log, int *n, int depth)
    {
        if (depth > 64 || !type) return;
        char elem[256], sub[512];
        unsigned count = 0;
        if (zr_array_of(type, elem, sizeof elem, &count))
        {
            unsigned es = size / count;
            for (unsigned i = 0; i < count; i++)
            {
                snprintf(sub, sizeof sub, "%s[%u]", path, i);
                zr_repoint(r, m, sub, elem, p + i * es, es, log, n, depth + 1);
            }
            return;
        }
        if (strstr(type, "(*") && size == sizeof(void *))
        {
            void *fn;
            memcpy(&fn, p, sizeof fn);
            // A stub: it followed its name, or stayed (zr_stubs_follow).
            int si = fn ? zr_stub_at(r, fn) : -1;
            if (si >= 0)
            {
                const struct ZrStub *st = &r->fs[si];
                if (st->changed_in != r->version || !st->sig) return;
                fputs((*n)++ ? ", " : "reload: function pointers in the state: ", log);
                if (!st->pinned) fprintf(log, "%s now calls the new %s", path, st->name);
                else fprintf(log, "%s still calls the old %s (%s)", path, st->name, zr_s(st->why));
                return;
            }
            const struct ZrFn *was = fn ? zr_fn_at(r, fn) : NULL;
            const ZcMfFunc *now = was ? zr_func_find(m, was->name) : NULL;
            if (!was || (now && now->addr == fn)) return;
            char *sig = now ? zr_fn_sig(now) : NULL;
            int same = sig && was->sig && !strcmp(sig, was->sig);
            free(sig);
            fputs((*n)++ ? ", " : "reload: function pointers in the state: ", log);
            if (same)
            {
                memcpy(p, &now->addr, sizeof fn);
                fprintf(log, "%s now calls the new %s", path, was->name);
            }
            else
                fprintf(log, "%s still calls the old %s (%s)", path, was->name,
                        now ? "its signature changed" : "it's gone");
            return;
        }
        const ZcMfType *t = zr_mf_find(m, type);
        if (!t) return;
        if (t->kind == 1)
        {
            for (unsigned i = 0; i < t->nfields; i++)
            {
                const ZcMfField *f = &t->fields[i];
                if (f->bits) continue;
                snprintf(sub, sizeof sub, "%s%s%s", path, *path ? "." : "", zr_s(f->name));
                zr_repoint(r, m, sub, f->type, p + f->offset, f->size, log, n, depth + 1);
            }
        }
        else if (t->kind == 4)
        {
            const ZcMfField *tag = zr_field_find(t, "tag"), *data = zr_field_find(t, "data");
            const ZcMfVariant *v = tag ? zr_variant_by_value(t, zr_int_read(p + tag->offset, tag->size)) : NULL;
            unsigned ps = v && v->payload ? zr_type_size(m, v->payload) : 0;
            if (v && ps && data && ps <= data->size)
            {
                snprintf(sub, sizeof sub, "%s(%s)", path, zr_s(v->name));
                zr_repoint(r, m, sub, v->payload, p + data->offset, ps, log, n, depth + 1);
            }
        }
    }

    // ---- Old code that runs the new code -------------------------------------------------
    //
    // A function of an old version can still be called after a reload: through a pointer in
    // the heap, one handed to a library, a closure, or an old vtable. Each one is made to run
    // the new version's function of the same name instead: its first five bytes become a jump
    // there (tcc starts every function with an 11-byte prologue, so there is room). A
    // function follows its name from one version to the next only while the call means the
    // same: the same signature, and no type it takes or returns changed. Once a step doesn't,
    // it stays where it was (that version stays loaded), and the reload says so. Each reload
    // moves everything still following to the newest version, so a call is one jump.
    //
    // Only while old versions are kept (the default): keep_old(false) deletes them, so the
    // jumps are undone. x86-64 only; elsewhere old code runs as it did.

    // A name -> function table of a manifest's functions, for one reload.
    typedef struct { const ZcMfFunc **slot; unsigned cap; } ZrFnTable;

    static void zr_fntab_init(ZrFnTable *t, const ZcManifest *m)
    {
        t->cap = 64;
        while (m && t->cap < m->nfuncs * 2) t->cap *= 2;
        t->slot = (const ZcMfFunc **)calloc(t->cap, sizeof(*t->slot));
        for (unsigned i = 0; t->slot && m && i < m->nfuncs; i++)
        {
            const char *name = zr_s(m->funcs[i].name);
            unsigned k = zr_hash(name) & (t->cap - 1);
            while (t->slot[k] && strcmp(zr_s(t->slot[k]->name), name) != 0) k = (k + 1) & (t->cap - 1);
            if (!t->slot[k]) t->slot[k] = &m->funcs[i]; // the first of a name
        }
    }

    static const ZcMfFunc *zr_fntab_get(const ZrFnTable *t, const char *name)
    {
        if (!t->slot) return NULL;
        unsigned k = zr_hash(name) & (t->cap - 1);
        for (; t->slot[k]; k = (k + 1) & (t->cap - 1))
            if (strcmp(zr_s(t->slot[k]->name), name) == 0) return t->slot[k];
        return NULL;
    }

    // The type named in C type `ctype` without qualifiers, pointers or array bounds ("const
    // struct Rock *" -> "Rock"), into `out`; "" for a function pointer.
    static void zr_base_type(const char *ctype, char *out, size_t n)
    {
        out[0] = 0;
        if (!ctype || strstr(ctype, "(*")) return;
        char buf[256];
        snprintf(buf, sizeof buf, "%s", ctype);
        char *b = strchr(buf, '[');
        if (b) *b = 0;
        size_t len = 0;
        for (char *w = strtok(buf, " *&\t"); w; w = strtok(NULL, " *&\t"))
        {
            if (!strcmp(w, "const") || !strcmp(w, "volatile") || !strcmp(w, "struct") ||
                !strcmp(w, "union") || !strcmp(w, "enum") || !strcmp(w, "restrict"))
                continue;
            len = (size_t)snprintf(out, n, "%s", w);
        }
        (void)len;
    }

    // Why `was` (of the previous version) can't be followed by `now` (the new one), or NULL if
    // it can. `why` holds the reason when there is one.
    static const char *zr_fwd_types_why(ZrReloader *r, const ZcMfFunc *now, char *why, size_t n);

    static const char *zr_fwd_why(ZrReloader *r, const ZcMfFunc *was, const ZcMfFunc *now,
                                  char *why, size_t n)
    {
        if (!now) return "it's gone";
        char *a = zr_fn_sig(was), *b = zr_fn_sig(now);
        int same = a && b && !strcmp(a, b);
        free(a);
        free(b);
        if (!same) return "its signature changed";
        return zr_fwd_types_why(r, now, why, n);
    }

    // Why a call to `now` (the new version's function) can't mean what a call to the old
    // one of the same signature meant: a type it takes or returns changed. NULL if none did.
    static const char *zr_fwd_types_why(ZrReloader *r, const ZcMfFunc *now, char *why, size_t n)
    {
        if (!r->types_prev || !r->types_now) return NULL;
        // The host's block is moved to the new layout in place: a pointer to it is right for
        // the new code. Any other changed type, or one passed by value, isn't.
        int amb = 0;
        const char *st = r->state ? zr_state_type(r, r->types_now, &amb) : NULL;
        char base[256];
        for (unsigned j = 0; j <= now->nparams; j++)
        {
            const char *ctype = j < now->nparams ? now->params[j] : now->ret;
            zr_base_type(ctype, base, sizeof base);
            if (st && !amb && !strcmp(base, st) && strchr(zr_s(ctype), '*')) continue;
            if (base[0] && zr_mf_find(r->types_now, base) &&
                zr_mf_changed(r->types_prev, r->types_now, base, 0, NULL))
            {
                snprintf(why, n, "it takes or returns a %s, which changed", base);
                return why;
            }
        }
        return NULL;
    }

    // ---- Stubs: what a function's address is ---------------------------------------------
    //
    // Every place a version takes the address of one of its own functions (a function
    // pointer, a vtable's entry, a callback handed to a library, what symbol() gives the host)
    // holds the function's stub instead: an indirect jump in kept memory, which no version
    // owns. Each reload points the stubs at the new version's functions of the same name,
    // where the call means the same (the same signature, and no type it takes or returns
    // changed), so a pointer kept anywhere, made by any version, calls the newest code, and
    // an old version's code is reached through nothing but its stubs. A stub whose function
    // can't follow stays on it (pinned), and the reload says so; the new version's pointers
    // to that name get a stub of their own. Direct calls stay direct. With the Reloader's
    // loading only (zl_load): a version libtcc loads has none of its own, but its functions
    // are followed into.

    static unsigned zr_stub_slot(unsigned *tab, unsigned cap, unsigned h)
    {
        (void)tab;
        return h & (cap - 1);
    }

    static int zr_stub_grow(unsigned **tab, unsigned *cap, unsigned used)
    {
        if ((used + 1) * 2 <= *cap) return 1;
        unsigned ncap = *cap ? *cap * 2 : 1024;
        unsigned *t = (unsigned *)calloc(ncap, sizeof(unsigned));
        if (!t) return 0;
        free(*tab);
        *tab = t;
        *cap = ncap;
        return 2; // emptied: to be filled again
    }

    static void *zr_stub_target(const struct ZrStub *st)
    {
        void *to;
        memcpy(&to, st->code + 8, sizeof to);
        return to;
    }

    static void zr_stub_point(struct ZrStub *st, void *to)
    {
        __atomic_store_n((void **)(st->code + 8), to, __ATOMIC_RELEASE);
    }

    static void zr_stub_index_name(ZrReloader *r, unsigned i)
    {
        unsigned k = zr_stub_slot(r->fs_by_name, r->fs_name_cap, zr_hash(r->fs[i].name));
        for (; r->fs_by_name[k]; k = (k + 1) & (r->fs_name_cap - 1))
            if (r->fs[r->fs_by_name[k] - 1].name == r->fs[i].name) break; // interned
        r->fs_by_name[k] = i + 1; // the newest of the name
    }

    static void zr_stub_index_addr(ZrReloader *r, unsigned i)
    {
        unsigned k = zr_stub_slot(r->fs_by_addr, r->fs_addr_cap, zr_addr_hash(r->fs[i].code));
        while (r->fs_by_addr[k]) k = (k + 1) & (r->fs_addr_cap - 1);
        r->fs_by_addr[k] = i + 1;
    }

    // The stub at `addr`, or -1.
    static int zr_stub_at(ZrReloader *r, void *addr)
    {
        if (!r->fs_addr_cap) return -1;
        unsigned k = zr_stub_slot(r->fs_by_addr, r->fs_addr_cap, zr_addr_hash(addr));
        for (; r->fs_by_addr[k]; k = (k + 1) & (r->fs_addr_cap - 1))
            if (r->fs[r->fs_by_addr[k] - 1].code == (unsigned char *)addr) return (int)r->fs_by_addr[k] - 1;
        return -1;
    }

    // The stub `name` (interned) calls through now, if it follows its name: -1 if there's
    // none, or it's pinned.
    static int zr_stub_live(ZrReloader *r, const char *name)
    {
        if (!r->fs_name_cap) return -1;
        unsigned k = zr_stub_slot(r->fs_by_name, r->fs_name_cap, zr_hash(name));
        for (; r->fs_by_name[k]; k = (k + 1) & (r->fs_name_cap - 1))
        {
            const struct ZrStub *st = &r->fs[r->fs_by_name[k] - 1];
            if (st->name == name) return st->pinned ? -1 : (int)r->fs_by_name[k] - 1;
        }
        return -1;
    }

    // A new stub for `name` (interned), of signature `sig` (or NULL), calling `to`; -1 if
    // there's no memory for it.
    static int zr_stub_new(ZrReloader *r, const char *name, const char *sig, void *to)
    {
        if (r->nfs == r->fs_cap)
        {
            unsigned cap = r->fs_cap ? r->fs_cap * 2 : 256;
            struct ZrStub *grown = (struct ZrStub *)realloc(r->fs, cap * sizeof(*grown));
            if (!grown) return -1;
            r->fs = grown;
            r->fs_cap = cap;
        }
        int g = zr_stub_grow(&r->fs_by_name, &r->fs_name_cap, r->nfs);
        if (g == 2)
            for (unsigned i = 0; i < r->nfs; i++) zr_stub_index_name(r, i);
        int h = g ? zr_stub_grow(&r->fs_by_addr, &r->fs_addr_cap, r->nfs) : 0;
        if (h == 2)
            for (unsigned i = 0; i < r->nfs; i++) zr_stub_index_addr(r, i);
    #ifdef ZR_LOADER
        unsigned char *code = h ? (unsigned char *)zl_keep(16, 16) : NULL;
    #else
        unsigned char *code = NULL;
    #endif
        if (!code) return -1;
        static const unsigned char jmp[8] = {0xFF, 0x25, 0x02, 0, 0, 0, 0xCC, 0xCC}; // jmp *2(%rip)
        memcpy(code, jmp, 8);
        struct ZrStub *st = &r->fs[r->nfs];
        memset(st, 0, sizeof(*st));
        st->name = name;
        st->sig = sig;
        st->code = code;
        st->made_in = st->changed_in = r->version;
        zr_stub_point(st, to);
        zr_stub_index_name(r, r->nfs);
        zr_stub_index_addr(r, r->nfs);
        return (int)r->nfs++;
    }

    // The stub for `name` that calls the current version's function of that name (at `to`):
    // the one following the name, or a new one.
    static void *zr_stub_for(ZrReloader *r, const ZcManifest *m, const char *name, void *to)
    {
        const char *in = zr_intern(r, zr_strdup(name));
        if (!in) return to;
        int i = zr_stub_live(r, in);
        if (i >= 0 && zr_stub_target(&r->fs[i]) == to) return r->fs[i].code;
        const ZcMfFunc *f = m ? zr_func_find(m, name) : NULL;
        const char *sig = f ? zr_intern(r, zr_fn_sig(f)) : NULL;
        i = zr_stub_new(r, in, sig, to);
        return i >= 0 ? r->fs[i].code : to;
    }

    // Why the stub `st` can't follow its name to `now` (the new version's function of that
    // name, if the manifest lists it; `there` if the new version has a function of that
    // name at all), or NULL.
    static const char *zr_stub_why(ZrReloader *r, const struct ZrStub *st, const ZcMfFunc *now,
                                   int there, char *why, size_t n)
    {
        if (!there) return "it's gone";
        if (st->sig || now)
        {
            char *b = now ? zr_fn_sig(now) : NULL;
            int same = st->sig && b && !strcmp(st->sig, b);
            free(b);
            if (!same) return "its signature changed";
            return zr_fwd_types_why(r, now, why, n);
        }
        // Not in a manifest: a lambda (by number, not a name that means the same function
        // from one version to the next), an enum's constructor (Type__Variant), or a helper
        // of zc's.
        if (!strncmp(st->name, "_lambda_", 8)) return "a lambda keeps the body it was made with";
        const char *sep = strstr(st->name, "__");
        if (sep && sep > st->name && (size_t)(sep - st->name) < 256 && r->types_prev && r->types_now)
        {
            char base[256];
            memcpy(base, st->name, (size_t)(sep - st->name));
            base[sep - st->name] = 0;
            if (zr_mf_find(r->types_now, base) && zr_mf_changed(r->types_prev, r->types_now, base, 0, NULL))
            {
                snprintf(why, n, "it makes a %s, which changed", base);
                return why;
            }
        }
        return NULL;
    }

    // After a reload: each stub following its name, to the new version's function, or pinned
    // where it is; then the new version's references to its functions, to their stubs. What
    // stays on old code (of functions the manifests list) is noted in `log`.
    static void zr_stubs_follow(ZrReloader *r, FILE *log)
    {
        ZrVersion *v = &r->current;
        ZrFnTable now;
        zr_fntab_init(&now, r->types_now);
        int n_kept = 0;
        char why_buf[320];
        for (unsigned i = 0; i < r->nfs; i++)
        {
            struct ZrStub *st = &r->fs[i];
            if (st->pinned) continue;
            const ZcMfFunc *b = zr_fntab_get(&now, st->name);
            void *to = b && b->addr ? b->addr : NULL;
    #ifdef ZR_LOADER
            if (!to && v->im && zl_is_func(v->im, st->name)) to = zl_sym(v->im, st->name);
    #endif
            if (!to && !v->im) to = zr_sym(v, st->name);
            const char *why = zr_stub_why(r, st, b, to != NULL, why_buf, sizeof why_buf);
            st->before = zr_stub_target(st);
            st->changed_in = r->version;
            if (why)
            {
                st->pinned = 1;
                st->why = zr_intern(r, zr_strdup(why));
                if (st->sig)
                {
                    if (n_kept < 4)
                        fprintf(log, "%s%s (%s)", n_kept ? ", " : "reload: old code still runs for: ",
                                st->name, why);
                    n_kept++;
                }
                continue;
            }
            zr_stub_point(st, to);
        }
        if (n_kept > 4) fprintf(log, ", and %d more", n_kept - 4);
        if (n_kept) fputc('\n', log);
    #ifdef ZR_LOADER
        ZlImage *im = v->im;
        for (unsigned k = 0; im && k < im->nrefs; k++)
        {
            unsigned sym = im->refs[k].sym;
            void *to = (void *)(uintptr_t)im->addr[sym];
            void *stub = zr_stub_for(r, r->types_now, zl_name(im, sym), to);
            if (stub != to) zl_bind(im, k, (uint64_t)(uintptr_t)stub);
        }
    #endif
        free(now.slot);
    }

    // Undoes zr_stubs_follow for the reload that made version `crashed`: the stubs it moved
    // or pinned go back; those it made for the crashed version's functions call the version
    // before's of the same name where the call means the same, or stay.
    static void zr_stubs_undo(ZrReloader *r, int crashed, const ZcManifest *back, ZrVersion *to_v)
    {
        ZrFnTable to;
        zr_fntab_init(&to, back);
        char why[320];
        for (unsigned i = 0; i < r->nfs; i++)
        {
            struct ZrStub *st = &r->fs[i];
            if (st->made_in == crashed)
            {
                const ZcMfFunc *b = zr_fntab_get(&to, st->name);
                void *addr = b && b->addr ? b->addr : NULL;
    #ifdef ZR_LOADER
                if (!addr && to_v->im && zl_is_func(to_v->im, st->name)) addr = zl_sym(to_v->im, st->name);
    #endif
                if (addr && !zr_stub_why(r, st, b, 1, why, sizeof why)) zr_stub_point(st, addr);
                continue;
            }
            if (st->changed_in != crashed) continue;
            zr_stub_point(st, st->before);
            if (st->pinned)
            {
                st->pinned = 0;
                st->why = NULL;
                zr_stub_index_name(r, i); // the newest of its name again
            }
            st->changed_in = crashed - 1;
        }
        // A name both pinned and made again in that reload: the one made goes, the one put
        // back follows.
        for (unsigned i = 0; i < r->nfs; i++)
        {
            struct ZrStub *st = &r->fs[i];
            if (st->made_in != crashed || st->pinned) continue;
            int live = zr_stub_live(r, st->name);
            if (live >= 0 && (unsigned)live != i)
            {
                st->pinned = 1;
                st->why = "made by a version that crashed";
            }
        }
        free(to.slot);
    }

    #ifdef ZR_FORWARD
    // Room for a 14-byte absolute jump within 2 GB of `near`, or NULL.
    static unsigned char *zr_stub(ZrReloader *r, unsigned char *near)
    {
        for (unsigned i = 0; i < r->nstubs; i++)
        {
            struct ZrStubs *s = &r->stubs[i];
            long long d = (long long)(s->page - near);
            if (s->used + 16 <= s->size && d < (1LL << 30) && d > -(1LL << 30))
            {
                s->used += 16;
                return s->page + s->used - 16;
            }
        }
        long page = sysconf(_SC_PAGESIZE);
        static const long long tries[] = {1LL << 20, -(1LL << 20), 1LL << 26, -(1LL << 26), 1LL << 29, -(1LL << 29)};
        for (unsigned t = 0; t < sizeof tries / sizeof tries[0]; t++)
        {
            uintptr_t hint = ((uintptr_t)near + (uintptr_t)tries[t]) & ~(uintptr_t)(page - 1);
            void *p = mmap((void *)hint, (size_t)page, PROT_READ | PROT_WRITE | PROT_EXEC,
                           MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
            if (p == MAP_FAILED) continue;
            long long d = (long long)((unsigned char *)p - near);
            if (d >= (1LL << 30) || d <= -(1LL << 30))
            {
                munmap(p, (size_t)page);
                continue;
            }
            struct ZrStubs *grown = (struct ZrStubs *)realloc(r->stubs, (r->nstubs + 1) * sizeof(*grown));
            if (!grown)
            {
                munmap(p, (size_t)page);
                return NULL;
            }
            r->stubs = grown;
            r->stubs[r->nstubs++] = (struct ZrStubs){(unsigned char *)p, 16, (size_t)page};
            return (unsigned char *)p;
        }
        return NULL;
    }

    // Writes `bytes` (n of them) at `at`, in code memory: its pages made writable (and left
    // so: they can hold the module's data too, and this is a development build).
    static int zr_code_write(unsigned char *at, const unsigned char *bytes, size_t n, int writable)
    {
        if (writable)
        {
            memcpy(at, bytes, n);
            return 1;
        }
        long page = sysconf(_SC_PAGESIZE);
        uintptr_t start = (uintptr_t)at & ~(uintptr_t)(page - 1);
        uintptr_t end = ((uintptr_t)at + n + (uintptr_t)page - 1) & ~(uintptr_t)(page - 1);
        if (mprotect((void *)start, end - start, PROT_READ | PROT_WRITE | PROT_EXEC) != 0) return 0;
        memcpy(at, bytes, n);
        return 1;
    }

    // `at` jumps to `to`: directly if it's within reach of a 32-bit offset, else through a
    // stub near `at`.
    // A far jump goes through `*stub`, made the first time one is needed and reused after.
    static int zr_jump(ZrReloader *r, unsigned char *at, unsigned char *to, int writable,
                       unsigned char **stub_of)
    {
        long long rel = (long long)(to - (at + 5));
        if (rel >= (1LL << 31) || rel < -(1LL << 31))
        {
            unsigned char *stub = *stub_of ? *stub_of : zr_stub(r, at);
            if (!stub) return 0;
            *stub_of = stub;
            unsigned char far[14] = {0xFF, 0x25, 0, 0, 0, 0}; // jmp *0(%rip), then the address
            memcpy(far + 6, &to, 8);
            memcpy(stub, far, sizeof far);
            rel = (long long)(stub - (at + 5));
        }
        int32_t rel32 = (int32_t)rel;
        unsigned char jmp[5] = {0xE9};
        memcpy(jmp + 1, &rel32, 4);
        return zr_code_write(at, jmp, 5, writable);
    }
    #endif

    static void zr_fwd_free(ZrReloader *r)
    {
        for (unsigned i = 0; i < r->fwd_names_cap; i++) free(r->fwd_names[i].name);
        free(r->fwd_names);
        r->fwd_names = NULL;
        r->fwd_names_cap = r->fwd_names_used = 0;
        free(r->fwd);
        r->fwd = NULL;
        r->nfwd = r->fwd_cap = 0;
    }

    static void zr_fwd_undo(ZrReloader *r)
    {
    #ifdef ZR_FORWARD
        for (unsigned i = 0; i < r->nfwd; i++) zr_code_write(r->fwd[i].at, r->fwd[i].orig, 5, 1);
    #endif
        zr_fwd_free(r);
    }

    // The followers of `name` (created empty if `make`), or NULL.
    static struct ZrFwdName *zr_fwd_name(ZrReloader *r, const char *name, int make)
    {
        if (make && (r->fwd_names_used + 1) * 2 > r->fwd_names_cap)
        {
            unsigned cap = r->fwd_names_cap ? r->fwd_names_cap * 2 : 256;
            struct ZrFwdName *t = (struct ZrFwdName *)calloc(cap, sizeof(*t));
            if (!t) return NULL;
            for (unsigned i = 0; i < r->fwd_names_cap; i++)
            {
                if (!r->fwd_names[i].name) continue;
                unsigned k = zr_hash(r->fwd_names[i].name) & (cap - 1);
                while (t[k].name) k = (k + 1) & (cap - 1);
                t[k] = r->fwd_names[i];
            }
            free(r->fwd_names);
            r->fwd_names = t;
            r->fwd_names_cap = cap;
        }
        if (!r->fwd_names_cap) return NULL;
        unsigned k = zr_hash(name) & (r->fwd_names_cap - 1);
        for (; r->fwd_names[k].name; k = (k + 1) & (r->fwd_names_cap - 1))
            if (!strcmp(r->fwd_names[k].name, name)) return &r->fwd_names[k];
        if (!make) return NULL;
        r->fwd_names[k].name = zr_strdup(name);
        r->fwd_names[k].head = -1;
        r->fwd_names_used++;
        return &r->fwd_names[k];
    }

    // After a reload: old functions to the new version's. `prev` is the version just
    // replaced, if it is still loaded (so its functions can be made to follow too).
    static void zr_forward(ZrReloader *r, ZrVersion *prev, FILE *log)
    {
        if (!r->keep_old)
        {
            zr_fwd_undo(r);
            return;
        }
    #ifdef ZR_FORWARD
        if (!r->types_prev || !r->types_now) return;
        ZrFnTable was, now;
        zr_fntab_init(&was, r->types_prev);
        zr_fntab_init(&now, r->types_now);
        // The previous version's code memory made writable at once (0.9.27, where it's
        // known), else page by page.
        int writable = 0;
        if (prev && prev->mem && prev->mem_size)
            writable = mprotect(prev->mem, prev->mem_size, PROT_READ | PROT_WRITE | PROT_EXEC) == 0;
        int n_kept = 0;
        char why_buf[320];
        // Each name of the previous version, decided once: its followers, and its own
        // function, go to the new version's, or stay where they are.
        for (unsigned i = 0; i < r->types_prev->nfuncs; i++)
        {
            const ZcMfFunc *a = &r->types_prev->funcs[i];
            const char *name = zr_s(a->name);
            if (!a->addr || zr_fntab_get(&was, name) != a) continue;
            const ZcMfFunc *b = zr_fntab_get(&now, name);
            const char *why = zr_fwd_why(r, a, b, why_buf, sizeof why_buf);
            struct ZrFwdName *fn = zr_fwd_name(r, name, !why && prev);
            if (why)
            {
                // The first few, then how many more (a changed type is taken by every
                // function generated for it: Vec<T>'s, Option<T>'s).
                if (b || strncmp(name, "_zc_", 4) != 0)
                {
                    if (n_kept < 4)
                        fprintf(log, "%s%s (%s)", n_kept ? ", " : "reload: old code still runs for: ",
                                name, why);
                    n_kept++;
                }
                if (fn) fn->head = -1; // its followers stay with the previous version's
                continue;
            }
            if (b->addr == a->addr) continue;
            int kept = -1; // the followers still following, relinked
            for (int e = fn ? fn->head : -1; e >= 0;)
            {
                int next = r->fwd[e].next;
                if (zr_jump(r, r->fwd[e].at, (unsigned char *)b->addr, 1, &r->fwd[e].stub))
                {
                    r->fwd[e].next = kept;
                    kept = e;
                }
                e = next;
            }
            if (fn) fn->head = kept;
            if (!prev || !fn) continue;
            if (r->nfwd == r->fwd_cap)
            {
                unsigned cap = r->fwd_cap ? r->fwd_cap * 2 : 256;
                struct ZrFwd *grown = (struct ZrFwd *)realloc(r->fwd, cap * sizeof(*grown));
                if (!grown) break;
                r->fwd = grown;
                r->fwd_cap = cap;
            }
            struct ZrFwd *f = &r->fwd[r->nfwd];
            f->at = (unsigned char *)a->addr;
            memcpy(f->orig, f->at, 5);
            f->stub = NULL;
            if (!zr_jump(r, f->at, (unsigned char *)b->addr, writable, &f->stub)) continue;
            f->next = fn->head;
            fn->head = (int)r->nfwd++;
        }
        if (n_kept > 4) fprintf(log, ", and %d more", n_kept - 4);
        if (n_kept) fputc('\n', log);
        // Names the new version doesn't have at all were reported above; a name only older
        // versions had keeps its followers where they are.
        free(was.slot);
        free(now.slot);
    #else
        (void)prev;
        (void)log;
    #endif
    }

    // After a reload: the function pointers in the host's block and the globals.
    static void zr_repoint_state(ZrReloader *r, FILE *log)
    {
        const ZcManifest *m = r->types_now;
        int n = 0;
        int amb = 0;
        const char *st = r->state ? zr_state_type(r, m, &amb) : NULL;
        const ZcMfType *t = st && !amb ? zr_mf_find(m, st) : NULL;
        if (t && t->size <= r->state_size)
        {
            char root[256];
            snprintf(root, sizeof root, "%s", st);
            zr_repoint(r, m, "state", root, r->state, t->size, log, &n, 0);
        }
        const ZcManifest *live = zr_version_manifest(&r->current);
        for (unsigned i = 0; live && i < live->nglobals; i++)
        {
            const ZcMfGlobal *g = &live->globals[i];
            if (g->flags & 2) continue;
            zr_repoint(r, m, zr_s(g->name), g->type, (unsigned char *)g->addr, g->size, log, &n, 0);
        }
        if (n) fputc('\n', log);
    }

    // A vtable (global `g` of a version's manifest): that version's functions, in its storage
    // and in any old storage of it, so a trait object made by any version calls them.
    static void zr_refill_vtable(ZrReloader *r, const ZcMfGlobal *g)
    {
        if (!g->init_value) return;
        memcpy(g->addr, g->init_value, g->size);
        for (unsigned j = 0; j < r->nold_vtables; j++)
        {
            const ZcMfGlobal *o = &r->old_vtables[j];
            if (!strcmp(zr_s(o->name), zr_s(g->name)) && !strcmp(zr_s(o->type), zr_s(g->type)) &&
                o->size == g->size)
                memcpy(o->addr, g->init_value, g->size);
        }
    }

    // Globals back to their initial value: those marked @reset_on_reload, on every reload,
    // and those whose initial value was edited (as hotreload-hx does: an edited initial value
    // is taken to be what was meant). Each is listed in `log`.
    static void zr_reset_globals(ZrReloader *r, FILE *log)
    {
        const ZcManifest *live = zr_version_manifest(&r->current);
        int n = 0;
        for (unsigned i = 0; live && i < live->nglobals; i++)
        {
            const ZcMfGlobal *g = &live->globals[i];
            if (g->flags & 2)
            {
                zr_refill_vtable(r, g);
                continue;
            }
            const ZcMfGlobal *was = zr_global_find(r->types_prev->globals, r->types_prev->nglobals, g->name);
            int marked = g->flags & 1;
            int edited = was && strcmp(zr_s(was->init), zr_s(g->init)) != 0;
            if (!marked && !edited) continue;
            if (g->init_value) memcpy(g->addr, g->init_value, g->size);
            else memset(g->addr, 0, g->size);
            fputs(n++ ? ", " : "reload: back to their initial values: ", log);
            if (marked) fprintf(log, "%s (@reset_on_reload)", zr_s(g->name));
            else
                fprintf(log, "%s (initial value edited: %s to %s)", zr_s(g->name),
                        was->init ? was->init : "zero", g->init ? g->init : "zero");
        }
        if (n) fputc('\n', log);
    }

    // ---- A crash in the new code ------------------------------------------------------
    //
    // The host calls the module through zr_call (Reloader.call, call_with). A crash in it
    // (SIGSEGV, SIGBUS, SIGFPE, SIGILL) comes back there instead of ending the program. If
    // the version running came from a reload, it is undone: the version before comes back,
    // with the host's block as it was before the reload moved it, its functions, vtables and
    // the function pointers in the state; old functions that had followed into the crashed
    // version follow the one before again, and the crashed version's own functions run that
    // one's. What the crashed code did to the heap, to globals and to libraries isn't undone.
    // With nothing to go back to (the first version, or one already undone), calls are
    // skipped until a version that loads replaces it. Best effort, for development.

    static __thread sigjmp_buf *zr_guard;   // where a crash goes: set while zr_call runs code
    static __thread volatile int zr_guard_sig;
    static struct sigaction zr_prev_act[32]; // the handlers there were, for other crashes
    static int zr_guard_ready;

    static void zr_on_fault(int sig, siginfo_t *info, void *uc)
    {
        if (zr_guard)
        {
            sigjmp_buf *to = zr_guard;
            zr_guard = NULL;
            zr_guard_sig = sig;
            siglongjmp(*to, 1);
        }
        // Not in the module's code: as if the Reloader weren't there.
        struct sigaction *was = sig < 32 ? &zr_prev_act[sig] : NULL;
        if (was && (was->sa_flags & SA_SIGINFO) && was->sa_sigaction)
        {
            was->sa_sigaction(sig, info, uc);
            return;
        }
        if (was && was->sa_handler != SIG_DFL && was->sa_handler != SIG_IGN && was->sa_handler)
        {
            was->sa_handler(sig);
            return;
        }
        signal(sig, SIG_DFL); // returning runs the faulting instruction again, unhandled
    }

    static void zr_guard_install(void)
    {
        if (zr_guard_ready) return;
        zr_guard_ready = 1;
        static char *alt;
        size_t alt_size = 1 << 16; // a stack overflow is a SIGSEGV with no stack left
        alt = (char *)malloc(alt_size);
        if (alt)
        {
            stack_t ss;
            memset(&ss, 0, sizeof ss);
            ss.ss_sp = alt;
            ss.ss_size = alt_size;
            sigaltstack(&ss, NULL);
        }
        static const int sigs[] = {SIGSEGV, SIGBUS, SIGFPE, SIGILL};
        for (unsigned i = 0; i < sizeof sigs / sizeof sigs[0]; i++)
        {
            struct sigaction sa;
            memset(&sa, 0, sizeof sa);
            sa.sa_sigaction = zr_on_fault;
            sa.sa_flags = SA_SIGINFO | SA_ONSTACK;
            sigemptyset(&sa.sa_mask);
            sigaction(sigs[i], &sa, &zr_prev_act[sigs[i]]);
        }
    }

    static const char *zr_sig_name(int sig)
    {
        switch (sig)
        {
        case SIGSEGV: return "SIGSEGV, a bad memory access";
        case SIGBUS: return "SIGBUS, a bad memory access";
        case SIGFPE: return "SIGFPE, an arithmetic error such as a division by zero";
        case SIGILL: return "SIGILL, an illegal instruction";
        default: return "a signal";
        }
    }

    static void zr_roll_back(ZrReloader *r)
    {
        ZrVersion crashed = r->current;
        ZrVersion prev = r->old[--r->old_count];
    #ifdef ZR_FORWARD
        // The replaced version's own functions run themselves again; those that followed
        // into the crashed version follow the replaced one's.
        for (unsigned i = r->nfwd_before; i < r->nfwd; i++)
            zr_code_write(r->fwd[i].at, r->fwd[i].orig, 5, 1);
        r->nfwd = r->nfwd_before;
        ZrFnTable back;
        zr_fntab_init(&back, r->types_prev);
        for (unsigned k = 0; k < r->fwd_names_cap; k++)
        {
            struct ZrFwdName *fn = &r->fwd_names[k];
            if (!fn->name) continue;
            const ZcMfFunc *t = zr_fntab_get(&back, fn->name);
            int kept = -1;
            for (int e = fn->head; e >= 0;)
            {
                int next = r->fwd[e].next;
                if (e < (int)r->nfwd_before && t && zr_jump(r, r->fwd[e].at, (unsigned char *)t->addr, 1, &r->fwd[e].stub))
                {
                    r->fwd[e].next = kept;
                    kept = e;
                }
                e = next;
            }
            fn->head = kept;
        }
        free(back.slot);
    #endif
        // The host's block: as it is, if the reload didn't change its type (what the frames
        // that did run did to it is kept); else as it was before the reload moved it.
        if (r->state && r->state_before)
        {
            int amb = 0;
            const char *st = zr_state_type(r, r->types_now, &amb);
            if (!st || amb || zr_mf_changed(r->types_prev, r->types_now, st, 0, NULL))
                memcpy(r->state, r->state_before, r->state_size);
        }
        // The crashed version stays loaded (something may point into it), and goes back to
        // being an old one; the replaced one is current again.
        r->old[r->old_count++] = crashed;
        r->current = prev;
        ZcManifest *crashed_types = r->types_now;
        r->types_now = r->types_prev;
        r->types_prev = crashed_types; // for the checks below: from the crashed to the one before
        zr_stubs_undo(r, r->version, r->types_now, &r->current);
    #ifdef ZR_FORWARD
        // The crashed version's functions run the replaced version's, where the call means
        // the same (outside any name's followers: they are never moved again).
        ZrFnTable to;
        zr_fntab_init(&to, r->types_now);
        char why[320];
        for (unsigned i = 0; !crashed.im && r->types_prev && i < r->types_prev->nfuncs; i++)
        {
            const ZcMfFunc *a = &r->types_prev->funcs[i];
            const ZcMfFunc *b = zr_fntab_get(&to, zr_s(a->name));
            if (!a->addr || !b || b->addr == a->addr || zr_fwd_why(r, a, b, why, sizeof why)) continue;
            if (r->nfwd == r->fwd_cap)
            {
                unsigned cap = r->fwd_cap ? r->fwd_cap * 2 : 256;
                struct ZrFwd *grown = (struct ZrFwd *)realloc(r->fwd, cap * sizeof(*grown));
                if (!grown) break;
                r->fwd = grown;
                r->fwd_cap = cap;
            }
            struct ZrFwd *f = &r->fwd[r->nfwd];
            f->at = (unsigned char *)a->addr;
            memcpy(f->orig, f->at, 5);
            f->stub = NULL;
            f->next = -1;
            if (zr_jump(r, f->at, (unsigned char *)b->addr, 0, &f->stub)) r->nfwd++;
        }
        free(to.slot);
    #endif
        const ZcManifest *live = zr_version_manifest(&r->current);
        for (unsigned i = 0; live && i < live->nglobals; i++)
            if (live->globals[i].flags & 2) zr_refill_vtable(r, &live->globals[i]);
        zr_repoint_state(r, stderr);
        zr_mf_free(r->types_prev);
        r->types_prev = NULL;
        r->version--;
        r->can_roll_back = 0;
    }

    static void zr_crashed(ZrReloader *r, int sig)
    {
        r->crashes++;
        if (r->can_roll_back && r->old_count > 0)
        {
            int was = r->version;
            zr_roll_back(r);
            fprintf(stderr,
                    "reload: version %d crashed (%s); back to version %d. What the crashed code "
                    "did to the heap, globals and libraries isn't undone. Fix and save to try "
                    "again\n",
                    was, zr_sig_name(sig), r->version);
        }
        else
        {
            r->broken = 1;
            fprintf(stderr,
                    "reload: version %d crashed (%s), with no version to go back to: calls to it "
                    "are skipped until a new version loads. Fix and save\n",
                    r->version, zr_sig_name(sig));
        }
    }

    // Calls `fn` (with `arg`, if `with_arg`) so that a crash in it doesn't end the program.
    // 1 if it ran to the end; 0 if it crashed or was skipped (look up symbols again).
    static int zr_call(void *h, void *fn, void *arg, int with_arg)
    {
        ZrReloader *volatile r = (ZrReloader *)h;
        if (!r || !fn || r->broken) return 0;
        zr_guard_install();
        sigjmp_buf here;
        sigjmp_buf *volatile outer = zr_guard;
        if (sigsetjmp(here, 1) == 0)
        {
            zr_guard = &here;
            if (with_arg) ((void (*)(void *))fn)(arg);
            else ((void (*)(void))fn)();
            zr_guard = outer;
            return 1;
        }
        zr_guard = outer;
        zr_crashed(r, zr_guard_sig);
        return 0;
    }

    static int zr_crashes(void *h) { return ((ZrReloader *)h)->crashes; }

    static int zr_build(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        r->seen = zr_newest(r);
        double t0 = zr_now_ms();

        // The include directories go to zc too: it reads the module's C headers (to know the
        // names they declare) with them.
        size_t incs_len = 1;
        for (int i = 0; i < r->include_count; i++) incs_len += strlen(r->includes[i]) + 6;
        char *incs = (char *)malloc(incs_len);
        if (!incs) return 0;
        incs[0] = 0;
        for (int i = 0; i < r->include_count; i++)
        {
            strcat(incs, "\"-I");
            strcat(incs, r->includes[i]);
            strcat(incs, "\" ");
        }
        size_t len = strlen(r->zc) + strlen(r->source) + strlen(r->c_file) + incs_len +
                     (r->zc_flags ? strlen(r->zc_flags) : 0) + 64 + 4096; // + an absolute path
        char *cmd = (char *)malloc(len);
        if (!cmd)
        {
            free(incs);
            return 0;
        }
        // The source by its absolute path: zc then writes the C's #line directives with
        // absolute paths, which a debugger finds the .zc files by wherever it runs.
        char *abs_source = realpath(r->source, NULL);
        snprintf(cmd, len,
                 "\"%s\" transpile --reload -q %s%s \"%s\" -o \"%s\" 1>&2", r->zc, incs,
                 r->zc_flags ? r->zc_flags : "", abs_source ? abs_source : r->source, r->c_file);
        free(abs_source);
        free(incs);
        int rc = system(cmd);
        free(cmd);
        if (rc != 0)
        {
            fprintf(stderr, "reload: %s did not build%s\n", r->source,
                    r->current.loaded ? "; still running the previous version" : "");
            return 0;
        }
        double t1 = zr_now_ms();

        // Using the globals already there if it can; defining them again if they changed.
        ZrVersion next;
        int compiled = -1;
        if (r->current.loaded && r->store)
        {
            compiled = zr_compile(r, &next, 0);
            if (compiled == 0 && !zr_globals_shared(r, &next))
            {
                zr_version_delete(&next);
                compiled = -1;
            }
        }
        if (compiled != 0) compiled = zr_compile(r, &next, 1);
        // The globals changed: those that did get storage of their own, the others keep theirs
        // (and pointers to them stay good), and the version is compiled against the store
        // again. If that fails, it keeps the storage it defines, as all of them used to.
        if (compiled == 0 && next.owns_globals && r->current.loaded && r->store &&
            zr_store_extend(r, &next))
        {
            ZrVersion ext;
            if (zr_compile(r, &ext, 0) == 0 && zr_globals_shared(r, &ext))
            {
                zr_version_delete(&next);
                next = ext;
            }
            else
            {
                if (ext.loaded) zr_version_delete(&ext);
                zr_store_settle(r, 0);
            }
        }
        double t2 = zr_now_ms();
        if (compiled != 0)
        {
            fprintf(stderr, "reload: %s did not compile%s\n", r->c_file,
                    r->current.loaded ? "; still running the previous version" : "");
            return 0;
        }

        // Room to keep the version being replaced, before anything about it changes.
        // A version that changes a type the host requires the same is not loaded.
        if (r->current.loaded && r->required_count && r->types_now)
        {
            ZcManifest *m = zr_mf_copy(zr_version_manifest(&next));
            int refused = -1;
            for (int i = 0; m && i < r->required_count && refused < 0; i++)
                if (zr_mf_changed(r->types_now, m, r->required[i], 0, NULL)) refused = i;
            if (refused >= 0)
            {
                zr_mf_report(stderr, r->types_now, m, r->version + 1);
                fprintf(stderr,
                        "reload: %s changed, so this version is not loaded: the running state "
                        "can't be read as the new layout. Restart the program to use it; still "
                        "running version %d\n",
                        r->required[refused], r->version);
                r->refused++;
            }
            zr_mf_free(m);
            if (refused >= 0)
            {
                zr_version_delete(&next);
                zr_store_settle(r, 0);
                return 0;
            }
        }

        // State the new version would have to move: everything must be movable, or it isn't
        // loaded.
        ZcManifest *nm = zr_mf_copy(zr_version_manifest(&next));
        if (r->current.loaded && nm && r->types_now)
        {
            char *why = NULL;
            size_t why_len = 0;
            FILE *wf = open_memstream(&why, &why_len);
            int problems = zr_move_state(r, &next, r->types_now, nm, 1, wf, NULL);
            if (wf) fclose(wf);
            if (problems)
            {
                zr_mf_report(stderr, r->types_now, nm, r->version + 1);
                fprintf(stderr,
                        "reload: this version is not loaded: %s. Restart the program to use it; "
                        "still running version %d\n",
                        why ? why : "the state can't be moved", r->version);
                free(why);
                zr_mf_free(nm);
                zr_version_delete(&next);
                zr_store_settle(r, 0);
                r->refused++;
                return 0;
            }
            free(why);
        }

        int keep_current = r->current.loaded && (r->keep_old || r->current.owns_globals);
        if (keep_current && r->old_count == r->old_cap)
        {
            int cap = r->old_cap ? r->old_cap * 2 : 8;
            ZrVersion *grown = (ZrVersion *)realloc(r->old, (size_t)cap * sizeof(ZrVersion));
            if (!grown)
            {
                zr_version_delete(&next);
                zr_store_settle(r, 0);
                fprintf(stderr, "reload: out of memory; still running the previous version\n");
                return 0;
            }
            r->old = grown;
            r->old_cap = cap;
        }

        // The version being replaced stops being the program's code here, though it may stay
        // loaded. Its @before_reload functions run first; its destructors don't (they run once,
        // at free(), on the version current then), and the new version's constructors don't
        // either (they ran when the first version loaded): a reload doesn't start the program
        // again. The new version's @after_reload functions run once the state has moved.
        int first = !r->current.loaded;
        // What undoing this reload would need (zr_call, after a crash in the new code).
        r->broken = 0;
        r->can_roll_back = !first && keep_current;
        r->nfwd_before = r->nfwd;
        if (r->can_roll_back && r->state)
        {
            unsigned char *snap = (unsigned char *)realloc(r->state_before, r->state_size);
            if (snap)
            {
                memcpy(snap, r->state, r->state_size);
                r->state_before = snap;
            }
            else
                r->can_roll_back = 0;
        }
        if (r->current.loaded)
        {
            zr_version_call(&r->current, "_zc_module_before_reload");
            if (keep_current)
            {
                r->old[r->old_count++] = r->current;
            }
            else
            {
                zr_version_delete(&r->current);
            }
        }
        r->current = next;
        r->version++;

        // The new version's types, to compare with the one it replaces.
        zr_mf_free(r->types_prev);
        r->types_prev = r->types_now;
        r->types_now = nm;

        // The state, moved to the new layout: the globals into the storage the new version
        // defines (if it does), and the host's block in place.
        free(r->moved);
        r->moved = NULL;
        size_t moved_len = 0;
        FILE *log = open_memstream(&r->moved, &moved_len);
        if (r->types_prev && r->types_now)
            zr_move_state(r, &r->current, r->types_prev, r->types_now, 0, NULL, log);
        zr_store_settle(r, 1); // the values are in the storage they keep from now on
        if (r->current.owns_globals && r->store) zr_keep_old_vtables(r);
        if (r->types_prev && r->types_now && log) zr_reset_globals(r, log);
        zr_note_fns(r, r->types_now);
        // Stubs first (what the state's function pointers are, reported next); old code made
        // to jump to new code only between versions libtcc loaded.
        ZrVersion *replaced = keep_current ? &r->old[r->old_count - 1] : NULL;
        char *kept_text = NULL;
        size_t kept_len = 0;
        FILE *kept_log = open_memstream(&kept_text, &kept_len);
        if (kept_log) zr_stubs_follow(r, kept_log);
        if (kept_log) fclose(kept_log);
        if (r->types_prev && r->types_now && log) zr_repoint_state(r, log);
        if (kept_text && log) fputs(kept_text, log);
        free(kept_text);
        if (r->types_prev && r->types_now && log && !r->current.im && (!replaced || !replaced->im))
            zr_forward(r, replaced, log);
        if (log) fclose(log);
        if (r->current.owns_globals) zr_store_set(r, zr_version_manifest(&r->current));

        zr_version_call(&r->current, first ? "_zc_module_init" : "_zc_module_after_reload");
        if (r->verbose)
        {
            fprintf(stderr, "reload: version %d of %s loaded (zc %.0f ms, tcc %.0f ms, reload %.1f ms)\n",
                    r->version, r->source, t1 - t0, t2 - t1, zr_now_ms() - t2);
            zr_report_kept(r);
            zr_mf_report(stderr, r->types_prev, r->types_now, r->version);
            if (r->moved) fputs(r->moved, stderr);
        }
        return 1;
    }

    static int zr_poll(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (zr_unchanged(r)) return 0;
        int64_t newest = zr_newest(r);
        if (newest == r->seen) return 0;
        if (r->verbose) fprintf(stderr, "reload: %s changed, rebuilding\n", r->source);
        return zr_build(h);
    }

    // A name the host looks up is a function it will call, with the state it keeps.
    static void *zr_symbol(void *h, const char *name)
    {
        ZrReloader *r = (ZrReloader *)h;
        int known = 0;
        for (int i = 0; i < r->fetched_count && !known; i++) known = !strcmp(r->fetched[i], name);
        if (!known && r->fetched_count == r->fetched_cap)
        {
            int cap = r->fetched_cap ? r->fetched_cap * 2 : 8;
            char **grown = (char **)realloc(r->fetched, (size_t)cap * sizeof(char *));
            if (grown) { r->fetched = grown; r->fetched_cap = cap; }
        }
        if (!known && r->fetched_count < r->fetched_cap) r->fetched[r->fetched_count++] = zr_strdup(name);
        if (!r->current.loaded) return NULL;
        void *addr = zr_sym(&r->current, name);
    #ifdef ZR_LOADER
        // A function: its stub, which calls the newest version's (a pointer the host keeps
        // past a reload still works).
        if (addr && r->current.im && zl_is_func(r->current.im, name))
            return zr_stub_for(r, r->types_now, name, addr);
    #endif
        return addr;
    }

    static const void *zr_manifest(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        const ZcManifest *(*get)(void) =
            r->current.loaded ? (const ZcManifest *(*)(void))zr_sym(&r->current, "_zc_manifest") : NULL;
        return get ? get() : NULL;
    }

    static void zr_keep_state(void *h, void *state, size_t size)
    {
        ZrReloader *r = (ZrReloader *)h;
        r->state = (unsigned char *)state;
        r->state_size = size;
    }

    static void zr_print_changes(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        zr_mf_report(stdout, r->types_prev, r->types_now, r->version);
        if (r->moved) fputs(r->moved, stdout);
    }

    static int zr_type_changed(void *h, const char *name)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (r->version < 2) return 0;
        // Without both manifests nothing can be ruled out.
        if (!r->types_prev || !r->types_now) return 1;
        return zr_mf_changed(r->types_prev, r->types_now, name, 0, NULL);
    }

    static int zr_version(void *h) { return ((ZrReloader *)h)->version; }
    static int zr_refused(void *h) { return ((ZrReloader *)h)->refused; }
    static int zr_kept(void *h) { return ((ZrReloader *)h)->old_count; }

    static void zr_free(void *h)
    {
        ZrReloader *r = (ZrReloader *)h;
        if (!r) return;
        zr_version_call(&r->current, "_zc_module_fini");
        for (int i = 0; i < r->old_count; i++) zr_version_delete(&r->old[i]);
        free(r->old);
        zr_version_delete(&r->current);
        zr_mf_free(r->types_now);
        zr_mf_free(r->types_prev);
        zr_store_settle(r, 1);
        zr_store_free(r);
        for (unsigned i = 0; i < r->nblocks; i++) free(r->blocks[i]);
        free(r->blocks);
    #ifdef __linux__
        zr_ino_close(r);
    #endif
        zr_fwd_free(r); // the code they're in is gone

    #ifdef ZR_FORWARD
        for (unsigned i = 0; i < r->nstubs; i++) munmap(r->stubs[i].page, r->stubs[i].size);
    #endif
        free(r->stubs);
        free(r->fs); // the stubs' code is in kept memory, for the process
        free(r->fs_by_name);
        free(r->fs_by_addr);
        free(r->state_before);
        for (int i = 0; i < r->include_count; i++) free(r->includes[i]);
        for (int i = 0; i < r->required_count; i++) free(r->required[i]);
        for (int i = 0; i < r->fetched_count; i++) free(r->fetched[i]);
        free(r->fetched);
        free(r->moved);
        for (unsigned i = 0; i < r->nold_vtables; i++)
        {
            free((void *)r->old_vtables[i].name);
            free((void *)r->old_vtables[i].type);
        }
        free(r->old_vtables);
        for (unsigned i = 0; i < r->strs_cap; i++) free(r->strs[i]);
        free(r->strs);
        free(r->fn_slot);
        free(r->fns);
        free(r->zc);
        free(r->zc_flags);
        free(r->source);
        free(r->c_file);
        free(r->watch_dir);
        free(r);
    }
}

extern fn zr_new(source: const char*, c_file: const char*) -> void*;
extern fn zr_set_zc(h: void*, zc: const char*);
extern fn zr_set_zc_flags(h: void*, flags: const char*);
extern fn zr_set_source(h: void*, source: const char*);
extern fn zr_set_watch(h: void*, dir: const char*);
extern fn zr_set_keep_old(h: void*, keep: c_int);
extern fn zr_set_verbose(h: void*, verbose: c_int);
extern fn zr_add_include(h: void*, dir: const char*) -> c_int;
extern fn zr_require_same(h: void*, type_name: const char*) -> c_int;
extern fn zr_refused(h: void*) -> c_int;
extern fn zr_keep_state(h: void*, state: void*, size: usize);
extern fn zr_build(h: void*) -> c_int;
extern fn zr_poll(h: void*) -> c_int;
extern fn zr_symbol(h: void*, name: const char*) -> void*;
extern fn zr_manifest(h: void*) -> const void*;
extern fn zr_print_changes(h: void*);
extern fn zr_type_changed(h: void*, name: const char*) -> c_int;
extern fn zr_version(h: void*) -> c_int;
extern fn zr_kept(h: void*) -> c_int;
extern fn zr_free(h: void*);
extern fn zr_call(h: void*, f: void*, arg: void*, with_arg: c_int) -> c_int;
extern fn zr_crashes(h: void*) -> c_int;

/// A module rebuilt from Zen C source and reloaded into this process. See the top of
/// std/reload.zc.
struct Reloader {
    handle: void*;
}

impl Reloader {
    /// A reloader for the module whose root file is `source`; its C goes to `c_file`.
    /// Nothing is built until build() or poll().
    fn new(source: const char*, c_file: const char*) -> Reloader {
        return Reloader { handle: zr_new(source, c_file) };
    }

    /// The zc to run (default "zc", found on PATH).
    fn set_zc(self, zc: const char*) { zr_set_zc(self.handle, zc); }

    /// More flags for `zc transpile`, as one string (for example "-D DEV").
    fn set_zc_flags(self, flags: const char*) { zr_set_zc_flags(self.handle, flags); }

    /// Build a different root file from now on.
    fn set_source(self, source: const char*) { zr_set_source(self.handle, source); }

    /// The directory whose .zc files (searched recursively) are watched by poll(). By
    /// default, the source's directory.
    fn watch(self, dir: const char*) { zr_set_watch(self.handle, dir); }

    /// Keep old versions loaded until free() (the default), or delete each when the next
    /// one loads.
    fn keep_old(self, keep: bool) { zr_set_keep_old(self.handle, keep ? 1 : 0); }

    /// Print a line for each version loaded (the default) or not. Errors are always printed.
    fn verbose(self, on: bool) { zr_set_verbose(self.handle, on ? 1 : 0); }

    /// A directory for the C compiler to search for the module's #includes.
    fn add_include(self, dir: const char*) -> bool { return zr_add_include(self.handle, dir) != 0; }

    /// The block of `size` bytes the host passes to the module's functions, the same one
    /// every time. Its type is what the functions the host looked up (symbol()) take a
    /// pointer to. When a reload changes that type, the block's contents are moved to the
    /// new layout in place: fields by name, enums by variant name, numbers converted, a new
    /// field zero. A version whose state can't be moved (a pointer to a type that changed,
    /// a type that no longer fits in `size`) is not loaded, and the reload says why.
    fn keep_state(self, state: void*, size: usize) { zr_keep_state(self.handle, state, size); }

    /// Don't load a version in which the type `type_name` (its C name) changed, itself or
    /// through a type it holds by value: for state the host keeps across reloads and can't
    /// rebuild. The running version stays in use, and the reload prints what changed and
    /// that the program must be restarted. A host that can rebuild its state instead asks
    /// type_changed() after a reload, and resets it.
    fn require_same(self, type_name: const char*) -> bool {
        return zr_require_same(self.handle, type_name) != 0;
    }

    /// How many builds were not loaded because their state couldn't be moved (or a type
    /// given to require_same() changed). See HOT_RELOAD.md, "What a reload refuses".
    fn refused(self) -> int { return (int)zr_refused(self.handle); }

    /// Build now. True if a new version was loaded; on failure, the errors are printed and
    /// the version already loaded, if any, stays in use.
    fn build(self) -> bool { return zr_build(self.handle) != 0; }

    /// Build if any watched .zc file changed since the last build. True if a new version
    /// was loaded. Call it when none of the module's code is running.
    fn poll(self) -> bool { return zr_poll(self.handle) != 0; }

    /// The address of `name` in the version loaded now, or NULL. Look again after a
    /// build() or poll() that returned true.
    fn symbol(self, name: const char*) -> void* { return zr_symbol(self.handle, name); }

    /// The version loaded now's description of its types (a `const ZcManifest*`, declared
    /// in this file's C), or NULL.
    fn manifest(self) -> const void* { return zr_manifest(self.handle); }

    /// Print what changed in the types of the version loaded now, compared with the one
    /// before it: structs and enums whose layout or values changed, types added and
    /// removed, and types that hold one that changed by value. Nothing if no type changed.
    /// With verbose() on (the default), each reload prints this to stderr.
    fn print_changes(self) { zr_print_changes(self.handle); }

    /// True if the type `name` (its C name: "State", "Box__int32_t") is not the same in the
    /// version loaded now as in the one before: its layout or values changed, it was added
    /// or removed, or a type it holds by value changed. Memory laid out as the old type
    /// can't be read as the new one. False after the first build.
    fn type_changed(self, name: const char*) -> bool { return zr_type_changed(self.handle, name) != 0; }

    /// How many versions have been loaded.
    fn version(self) -> int { return (int)zr_version(self.handle); }

    /// How many old versions are kept loaded.
    fn kept(self) -> int { return (int)zr_kept(self.handle); }

    /// Delete every version and the reloader.
    /// Calls `f`, a function of the module, so that a crash in it (SIGSEGV, SIGBUS, SIGFPE,
    /// SIGILL) doesn't end the program. If the version running came from a reload, the
    /// reload is undone: the version before runs again, with the state as it was. What the
    /// crashed code did to the heap, globals and libraries isn't undone. True if `f` ran
    /// to the end; false if it crashed, or was skipped (a version crashed with none to go
    /// back to; calls are skipped until a new one loads): look up symbols again.
    fn call(self, f: fn*()) -> bool { return zr_call(self.handle, (void*)f, NULL, 0) != 0; }

    /// call() for a function taking a pointer (the host's block, say).
    fn call_with(self, f: fn*(void*), arg: void*) -> bool {
        return zr_call(self.handle, (void*)f, arg, 1) != 0;
    }

    /// Crashes caught by call() and call_with().
    fn crashes(self) -> int { return (int)zr_crashes(self.handle); }

    fn free(self) {
        zr_free(self.handle);
        self.handle = NULL;
    }
}
