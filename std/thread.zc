
include <time.h>

import "./core.zc"
import "./result.zc"
import "./mem.zc"
import "./sync.zc"
// Essential raw block: required for thread operations and closure trampolining. Threads are
// pthread's on POSIX; on Windows the C runtime's (_beginthreadex), as pthread isn't there for
// every compiler (MinGW has its own; tcc, compiling for msvcrt alone, has none). No
// <windows.h>: what std includes, every program that imports it gets; what it's used for is
// declared here as it declares it.
// This block cannot be eliminated because:
// 1. z_closure_T is an internal compiler type for Zen-C closures
// 2. pthread_t, pthread_mutex_t are opaque types that can't be extern'd with void*
// 3. The trampoline function needs to cast and execute Zen-C closures
raw {
    typedef void (*ZenThreadFunc)(void*);
    
    struct ZenThreadCtx {
        void *func_ptr;
        void *ctx;
    };
    
    static void* _z_thread_trampoline(void *arg) {
        z_closure_T *closure = (z_closure_T*)arg;
        void (*f)(void*) = (void(*)(void*))closure->func;
        f(closure->ctx);
        if (closure->drop) closure->drop(closure->ctx);
        // In MISRA mode, we don't freeCtx.
        // In non-MISRA mode, this still uses free() which is fine as it's raw C.
        // Actually, we should use a macro prefix to be consistent.
        #ifndef ZC_MISRA
        free(closure);
        #endif
        return NULL;
    }

#ifdef _WIN32
    #include <process.h>
    __declspec(dllimport) unsigned long __stdcall WaitForSingleObject(void *, unsigned long);
    __declspec(dllimport) int __stdcall CloseHandle(void *);
    __declspec(dllimport) void __stdcall Sleep(unsigned long);

    static unsigned __stdcall _z_thread_win_start(void *arg) {
        _z_thread_trampoline(arg);
        return 0;
    }

    static int _z_thread_equal(void* handle1, void* handle2) {
        return handle1 == handle2;
    }

    static int _z_thread_spawn(void *ctx_copy, size_t *out_handle) {
        uintptr_t h = _beginthreadex(NULL, 0, _z_thread_win_start, ctx_copy, 0, NULL);
        if (!h) return -1;
        *out_handle = (size_t)h;
        return 0;
    }

    static int _z_thread_join(void *handle) {
        if (WaitForSingleObject(handle, 0xFFFFFFFFUL) != 0) return -1;
        CloseHandle(handle);
        return 0;
    }

    static int _z_thread_detach(void* handle) {
        return CloseHandle(handle) ? 0 : -1;
    }

    // (Windows has no safe way to stop another thread: TerminateThread can leave its locks
    // held and its memory half written)
    static int _z_thread_cancel(void* handle) {
        (void)handle;
        return -1;
    }
#else
    #include <pthread.h>
    #include <unistd.h>

    static int _z_thread_equal(void* handle1, void* handle2) {
        return pthread_equal((pthread_t)handle1, (pthread_t)handle2);
    }

    static int _z_thread_spawn(void *ctx_copy, size_t *out_handle) {
        pthread_t pt;
        int ret = pthread_create(&pt, NULL, _z_thread_trampoline, ctx_copy);
        if (ret == 0) {
            *out_handle = (size_t)pt;
        }
        return (int)ret;
    }

    static int _z_thread_join(void *handle) {
        return (int)pthread_join((pthread_t)handle, NULL);
    }

    static int _z_thread_detach(void* handle) {
        return pthread_detach((pthread_t)handle);
    }

    static int _z_thread_cancel(void* handle) {
        return pthread_cancel((pthread_t)handle);
    }
#endif

    static void _z_usleep(int micros) {
#ifdef _WIN32
        Sleep((unsigned long)((micros + 999) / 1000));
#else
        usleep(micros);
#endif
    }
}

extern fn _z_thread_equal(handle1: void*, handle2: void*) -> c_int;
extern fn _z_thread_spawn(ctx: void*, out: usize*) -> c_int;
extern fn _z_thread_join(handle: void*) -> c_int;
extern fn _z_thread_detach(handle: void*) -> c_int;
extern fn _z_thread_cancel(handle: void*) -> c_int;
extern fn _z_usleep(micros: c_int);

struct Thread {
    handle: void*;
}

impl Thread {
    /// Spawns a thread running the closure.
    fn spawn(func: fn()) -> Result<Thread> {
        let out_handle: usize = 0; 
        
        let ctx = alloc_bytes(sizeof(fn())); 
        if (ctx == NULL) return Result<Thread>::Err("OOM");
        
        memcpy(ctx, &func, sizeof(fn()));
        
        // Zero out the drop field to prevent f64-free by this function's cleanup
        raw {
            ((z_closure_T*)&func)->drop = NULL;
        }

        let ret = _z_thread_spawn(ctx, &out_handle);
        
        if ret != 0 {
            dealloc<void>(ctx);
            return Result<Thread>::Err("Failed to create thread");
        }
        
        return Result<Thread>::Ok(Thread { handle: (void*)out_handle });
    }
    
    /// Waits for the thread to finish.
    fn join(self) -> Result<bool> {
        let err = _z_thread_join(self.handle);
        if err {
            return Result<bool>::Err("Join failed");
        }
        return Result<bool>::Ok(true);
    }

    /// Detaches the thread (runs independently).
    fn detach(self) -> Result<bool> {
        let err = _z_thread_detach(self.handle);
        if err {
            return Result<bool>::Err("Detach failed");
        }
        return Result<bool>::Ok(true);
    }

    /// Cancels the thread (pthread_cancel). Not on Windows, which has no safe way to stop
    /// another thread: there it fails.
    fn cancel(self) -> Result<bool> {
        let err = _z_thread_cancel(self.handle);
        if err {
            return Result<bool>::Err("Cancel failed");
        }
        return Result<bool>::Ok(true);
    }
}

fn sleep_ms(ms: int) {
    let micros: c_int = (c_int)(ms * 1000);
    _z_usleep(micros);
}
