// The reload tests' host, on std/reload.zc.
//
// Usage: host ZC CASE_DIR WORK_DIR [--delete-old]
//
// Each CASE_DIR/stepN.zc (N = 1, 2, ...) is one version of the module, in order. For each
// step the host builds it with a Reloader and calls its `reload_step(void *state)`, as a
// program's host would after a save. `state` is a zeroed block the host owns, the same one
// for every step. A step that does not build leaves the previous version running.
//
// Old versions stay loaded (the Reloader's default); --delete-old deletes each when the
// next one loads, to show what that breaks.
//
// The host calls each step through the Reloader's call_with(), so a crash in it is caught:
// it prints "(crashed)", looks the step up again and calls it once more ("(skipped)" if no
// version can run).
//
// The host prints "--- step N" before each step, so the expected output shows which
// version printed what. If CASE_DIR has a `print-type` file, it names a type whose layout
// the host prints from each version's manifest when it loads (Reloader.manifest()). If it
// has a `print-changes` file, the host prints what each reload changed in the module's
// types (Reloader.print_changes()), then, for each type named in the file, whether
// type_changed() says it changed.
//
// The host gives its state block to the Reloader (keep_state), which moves its contents
// when a reload changes its layout; the host never names the state's type. With a
// `require-same` file, it passes the type named there to require_same(), so a version
// that changes it is not loaded.

import "std/reload.zc"

include <stdio.h>
include <stdlib.h>
include <string.h>

raw {
    // The layout of the type `name` in a module's manifest, one line per field or variant.
    static void print_type(const void *manifest, const char *name)
    {
        const ZcManifest *m = (const ZcManifest *)manifest;
        if (!m)
        {
            printf("(no manifest)\n");
            return;
        }
        for (unsigned i = 0; i < m->ntypes; i++)
        {
            const ZcMfType *t = &m->types[i];
            if (strcmp(t->c_name, name) != 0) continue;
            printf("%s: size %u align %u\n", t->zc_name, t->size, t->align);
            for (unsigned j = 0; j < t->nfields; j++)
                printf("  %s: %s at %u\n", t->fields[j].name, t->fields[j].type, t->fields[j].offset);
            for (unsigned j = 0; j < t->nvariants; j++)
                printf("  %s = %lld\n", t->variants[j].name, t->variants[j].value);
            return;
        }
        printf("(%s is not in the manifest)\n", name);
    }
}
extern fn print_type(manifest: const void*, name: const char*);

def STATE_BYTES = 65536;
def MAX_STEPS = 64;

fn exists(path: const char*) -> bool {
    let f = fopen(path, "r");
    if f == NULL { return false; }
    fclose(f);
    return true;
}

// The first word of CASE_DIR/name into `out` (256 bytes); false if there is no such file.
fn read_word(case_dir: const char*, name: const char*, out: char*) -> bool {
    let path: char[4096];
    snprintf(path, 4096, "%s/%s", case_dir, name);
    out[0] = 0;
    let f = fopen(path, "r");
    if f == NULL { return false; }
    if fgets(out, 256, f) != NULL { out[strcspn(out, " \t\r\n")] = 0; }
    fclose(f);
    return true;
}

fn main(argc: int, argv: char**) -> int {
    if argc < 4 {
        fprintf(stderr, "usage: host ZC CASE_DIR WORK_DIR [--delete-old]\n");
        return 2;
    }
    let case_dir: const char* = argv[2];
    let delete_old = argc > 4 && strcmp(argv[4], "--delete-old") == 0;
    setvbuf(stdout, NULL, _IONBF, 0); // the module's output and ours, in order

    let c_file: char[4096];
    snprintf(c_file, 4096, "%s/module.c", argv[3]);
    let code = Reloader::new("", c_file);
    code.set_zc(argv[1]);
    code.keep_old(!delete_old);
    code.verbose(false);

    // The type to print from each version's manifest, if any.
    let print_name: char[256];
    print_name[0] = 0;
    let type_path: char[4096];
    snprintf(type_path, 4096, "%s/print-type", case_dir);
    let tf = fopen(type_path, "r");
    if tf != NULL {
        if fgets(print_name, 256, tf) != NULL { print_name[strcspn(print_name, "\r\n")] = 0; }
        fclose(tf);
    }

    // The types to ask type_changed() about, if the case prints changes.
    let changes_names: char[1024];
    changes_names[0] = 0;
    let changes_path: char[4096];
    snprintf(changes_path, 4096, "%s/print-changes", case_dir);
    let print_changes = exists(changes_path);
    if print_changes {
        let cf = fopen(changes_path, "r");
        let got = fread(changes_names, 1, 1023, cf);
        changes_names[got] = 0;
        fclose(cf);
    }

    let required: char[256];
    if read_word(case_dir, "require-same", required) { code.require_same(required); }

    let state = calloc(1, STATE_BYTES);
    code.keep_state(state, STATE_BYTES);
    let step: fn*(void*) = NULL;
    let source: char[4096];
    let n = 1;
    while n <= MAX_STEPS {
        snprintf(source, 4096, "%s/step%d.zc", case_dir, n);
        if !exists(source) { break; }
        println "--- step {n}";
        code.set_source(source);
        if code.build() {
            step = code.symbol("reload_step"); // a void* converts to a function pointer
            if step == NULL { fprintf(stderr, "host: step%d.zc has no reload_step\n", n); }
            if print_name[0] != 0 { print_type(code.manifest(), print_name); }
            if print_changes && n > 1 {
                code.print_changes();
                let names: char[1024];
                strcpy(names, changes_names);
                let name = strtok(names, " \t\r\n");
                while name != NULL {
                    if code.type_changed(name) { println "{name} changed: yes"; }
                    else { println "{name} changed: no"; }
                    name = strtok(NULL, " \t\r\n");
                }
            }
        } else {
            println "(build failed, running the previous module)";
        }
        // Through call_with, so a crash in the step comes back here: the host then looks the
        // step up again (in the version it went back to, if any) and calls it once more.
        if step != NULL && !code.call_with(step, state) {
            println "(crashed)";
            step = code.symbol("reload_step");
            if step != NULL && !code.call_with(step, state) { println "(skipped)"; }
        }
        n = n + 1;
    }

    code.free();
    free(state);
    return 0;
}
