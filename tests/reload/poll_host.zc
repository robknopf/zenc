// The reload tests' check of poll(), on std/reload.zc.
//
// Usage: poll_host ZC WORK_DIR
//
// Writes a module in WORK_DIR/mod, builds it, then changes files the ways an editor does
// and checks after each what poll() says: true when a .zc file under the module's
// directory changed (written in place, saved through a rename, or added in a directory
// made after the first poll), or a C file the module links or a header that includes,
// inside the directory or not; false when nothing did, only another file did, or only the
// Reloader's own C file was written, and false again right after a true. On Linux poll() learns of changes through inotify; elsewhere it
// scans every time, and the answers must be the same. Prints "ok" lines; on a wrong answer,
// prints "FAIL" and exits 1.

import "std/reload.zc"

include <stdio.h>
include <stdlib.h>
include <string.h>
include <sys/stat.h>
include <unistd.h>

raw {
    static void put(const char *path, const char *text)
    {
        usleep(20000); // so each write has a newer modification time than the last
        FILE *f = fopen(path, "w");
        if (!f) { fprintf(stderr, "poll_host: can't write %s\n", path); exit(2); }
        fputs(text, f);
        fclose(f);
    }

    static void module_src(char *out, size_t n, int value)
    {
        snprintf(out, n, "@link_name(\"poll_value\")\nfn poll_value() -> int {\n    return %d;\n}\n", value);
    }

    // A module that links two C files: helper.c beside it, and `outside`.
    static void linking_src(char *out, size_t n, const char *outside)
    {
        snprintf(out, n,
                 "@link(\"helper.c\")\nextern fn helper_value() -> int;\n"
                 "@link(\"%s\")\nextern fn outside_value() -> int;\n"
                 "@link_name(\"poll_value\")\nfn poll_value() -> int {\n"
                 "    return helper_value() + outside_value();\n}\n",
                 outside);
    }

    #include <dirent.h>
    #include <stdint.h>
    #include <sys/stat.h>
    static _Bool own_loader(void)
    {
    #ifdef ZR_LOADER
        return 1;
    #else
        return 0;
    #endif
    }
    static _Bool on_linux(void)
    {
    #ifdef __linux__
        return 1;
    #else
        return 0;
    #endif
    }
    #ifdef _WIN32
    #include <windows.h>
    #endif
    // An editor's save: `from` renamed over `to` (which Windows' rename() won't replace).
    static void replace_file(const char *from, const char *to)
    {
    #ifdef _WIN32
        MoveFileExA(from, to, MOVEFILE_REPLACE_EXISTING);
    #else
        rename(from, to);
    #endif
    }
    static void make_dir(const char *path)
    {
    #ifdef _WIN32
        mkdir(path);
    #else
        mkdir(path, 0755);
    #endif
    }
    // Whether the code at `p` is in an object file registered with debuggers (gdb's JIT
    // interface, which std/reload.zc defines): in one of its loaded sections.
    struct zr_jit_entry;
    struct zr_jit_descriptor;
    static int registered(void *p)
    {
        typedef struct { unsigned char e_ident[16]; uint16_t e_type, e_machine; uint32_t e_version; uint64_t e_entry, e_phoff, e_shoff; uint32_t e_flags; uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx; } Ehdr;
        typedef struct { uint32_t sh_name, sh_type; uint64_t sh_flags, sh_addr, sh_offset, sh_size; uint32_t sh_link, sh_info; uint64_t sh_addralign, sh_entsize; } Shdr;
    #ifdef ZR_LOADER
        for (zr_jit_entry *e = __jit_debug_descriptor.first_entry; e; e = e->next_entry)
        {
            const Ehdr *eh = (const Ehdr *)e->symfile_addr;
            const Shdr *sh = (const Shdr *)(e->symfile_addr + eh->e_shoff);
            for (unsigned i = 0; i < eh->e_shnum; i++)
                if ((sh[i].sh_flags & 2) && sh[i].sh_addr <= (uintptr_t)p && (uintptr_t)p < sh[i].sh_addr + sh[i].sh_size)
                    return 1;
        }
    #endif
        (void)p;
        return 0;
    }

    // Files beside the C file named after it (module.c.*): what a version, or a library it
    // links, left on disk.
    static int files_left(const char *dir_path)
    {
        DIR *d = opendir(dir_path);
        int n = 0;
        struct dirent *e;
        while (d && (e = readdir(d)) != NULL)
            if (!strncmp(e->d_name, "module.c.", 9)) n++;
        if (d) closedir(d);
        return n;
    }
}
extern fn registered(p: void*) -> c_int;
extern fn make_dir(path: const char*);
extern fn replace_file(from: const char*, to: const char*);
extern fn on_linux() -> bool;
extern fn own_loader() -> bool;
extern fn files_left(dir: const char*) -> int;
extern fn put(path: const char*, text: const char*);
extern fn module_src(out: char*, n: usize, value: int);
extern fn linking_src(out: char*, n: usize, outside: const char*);

// poll(), after waiting out the 200 ms between scans when scanning (ZC_RELOAD_SCAN set, or
// not Linux: no inotify).
fn poll_now(code: Reloader*) -> bool {
    let scan = getenv("ZC_RELOAD_SCAN");
    if (scan != NULL && scan[0] != 0) || !on_linux() { usleep(250000); }
    return code.poll();
}

fn check(what: const char*, got: bool, want: bool) {
    if got != want {
        println "FAIL {what}: poll() said {got}, expected {want}";
        exit(1);
    }
    println "ok {what}";
}

fn main(argc: int, argv: char**) -> int {
    if argc < 3 {
        fprintf(stderr, "usage: poll_host ZC WORK_DIR\n");
        return 2;
    }
    setvbuf(stdout, NULL, _IONBF, 0);
    let dir: char[3072];
    let main_zc: char[4096];
    let tmp: char[4096];
    let path: char[4096];
    let c_file: char[4096];
    let src: char[512];
    snprintf(dir, 3072, "%s/mod", argv[2]);
    make_dir(dir);
    snprintf(main_zc, 4096, "%s/main.zc", dir);
    snprintf(c_file, 4096, "%s/module.c", argv[2]);

    module_src(src, 512, 1);
    put(main_zc, src);
    let code = Reloader::new(main_zc, c_file);
    code.set_zc(argv[1]);
    code.verbose(false);
    if !code.build() { println "FAIL the module does not build"; return 1; }
    let value: fn*() -> int = code.symbol("poll_value");

    // Each version is registered with debuggers where the Reloader loads it itself (where
    // libtcc does, it isn't), and leaves no file beside the C file either way.
    let loads_itself = own_loader();
    check("registered with debuggers", registered((void*)code.manifest()) != 0, loads_itself);
    check("no file left beside the C file", files_left(argv[2]) == 0, true);

    check("nothing changed (first poll)", poll_now(&code), false);
    check("nothing changed", poll_now(&code), false);

    module_src(src, 512, 2);
    put(main_zc, src);
    check("written in place", poll_now(&code), true);
    value = code.symbol("poll_value");
    check("and the new code runs", value() == 2, true);
    check("the new version registered too", registered((void*)code.manifest()) != 0, loads_itself);
    check("nothing changed since", poll_now(&code), false);

    // An editor's save: a temporary file, renamed over the source.
    module_src(src, 512, 3);
    snprintf(tmp, 4096, "%s/main.zc.swp", dir);
    put(tmp, src);
    replace_file(tmp, main_zc);
    check("saved through a rename", poll_now(&code), true);
    value = code.symbol("poll_value");
    check("and the new code runs", value() == 3, true);

    snprintf(path, 4096, "%s/notes.txt", dir);
    put(path, "not a .zc file\n");
    check("another file written", poll_now(&code), false);

    // A directory made after the first poll: a .zc in it counts, and so do later edits.
    snprintf(path, 4096, "%s/sub", dir);
    make_dir(path);
    snprintf(path, 4096, "%s/sub/extra.zc", dir);
    put(path, r"fn extra() -> int { return 1; }");
    check("a .zc added in a new directory", poll_now(&code), true);
    put(path, r"fn extra() -> int { return 2; }");
    check("that file edited", poll_now(&code), true);
    check("nothing changed since", poll_now(&code), false);

    // C the module links: a file beside it, with a header beside that, and a file outside
    // the watched directory. Each edited alone is a change, and the new C runs (a linked
    // file is an image of its own, compiled again when it or a header it includes changes).
    let helper_h: char[4096];
    let helper_c: char[4096];
    let outside_c: char[4096];
    let big: char[8192];
    snprintf(helper_h, 4096, "%s/helper.h", dir);
    snprintf(helper_c, 4096, "%s/helper.c", dir);
    snprintf(path, 4096, "%s/ext", argv[2]);
    make_dir(path);
    snprintf(outside_c, 4096, "%s/ext/outside.c", argv[2]);
    put(helper_h, "#define HELPER_BASE 10\n");
    put(helper_c, "#include \"helper.h\"\nint helper_value(void) {{ return HELPER_BASE + 1; }}\n");
    put(outside_c, "int outside_value(void) {{ return 100; }}\n");
    linking_src(big, 8192, outside_c);
    put(main_zc, big);
    check("a module that links C", poll_now(&code), true);
    value = code.symbol("poll_value");
    check("and its C runs", value() == 111, true);
    check("nothing changed since", poll_now(&code), false);

    put(helper_c, "#include \"helper.h\"\nint helper_value(void) {{ return HELPER_BASE + 2; }}\n");
    check("a linked C file edited alone", poll_now(&code), true);
    value = code.symbol("poll_value");
    check("and the new C runs", value() == 112, true);

    put(helper_h, "#define HELPER_BASE 20\n");
    check("a header it includes edited alone", poll_now(&code), true);
    value = code.symbol("poll_value");
    check("and the C compiled with it runs", value() == 122, true);

    put(outside_c, "int outside_value(void) {{ return 200; }}\n");
    check("a linked C file outside the directory", poll_now(&code), true);
    value = code.symbol("poll_value");
    check("and the new C runs", value() == 222, true);
    check("nothing changed since", poll_now(&code), false);
    code.free();

    // The Reloader's own C file, written inside the watched directory: zc writes it on
    // every build, and that isn't a change.
    snprintf(c_file, 4096, "%s/sub/inside.c", dir);
    module_src(src, 512, 4);
    put(main_zc, src);
    let inside = Reloader::new(main_zc, c_file);
    inside.set_zc(argv[1]);
    inside.verbose(false);
    if !inside.build() { println "FAIL the module does not build (its C inside)"; return 1; }
    check("its own C file written in the directory", poll_now(&inside), false);
    if !inside.build() { println "FAIL the module does not build again (its C inside)"; return 1; }
    check("and written again", poll_now(&inside), false);
    inside.free();
    return 0;
}
