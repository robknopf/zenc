// Version 1. Pointers from version 1 kept where the Reloader can't see them (void* in the
// host's block): a string literal (the pool's), a module function (its stub, which follows
// its name) and a C static function, renamed in every version (its stub stays on version 1's,
// which is copied out of it). Only two versions stay loaded: from version 3 on, version 1 is
// released whole, and all three still work.
raw {
    static void legacy_v1(void) { printf("legacy, version 1\n"); }
    static void *legacy_addr(void) { return (void *)legacy_v1; }
    static void call0(void *f) { ((void (*)(void))f)(); }
}
fn greet() {
    println "greet version 1";
}
struct State { msg: string; cb: void*; legacy: void*; }
@link_name("reload_step")
fn reload_step(state: State*) {
    if state.msg == NULL {
        state.msg = "hello from version 1";
        state.cb = (void*)greet;
        state.legacy = legacy_addr();
    }
    println "{state.msg}";
    call0(state.cb);
    call0(state.legacy);
}
