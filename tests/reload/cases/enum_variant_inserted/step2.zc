// A variant added before the one stored renumbers it: the host is told (type_changed),
// through the struct that holds the enum, and clears the state rather than read Run (1)
// as Walk.
enum Mode { Stand, Walk, Run }
struct State { mode: Mode; set: bool; }
@link_name("reload_step")
fn reload_step(state: State*) {
    if !state.set { state.mode = Mode::Run; state.set = true; }
    match state.mode {
        Mode::Stand => { println "stand"; },
        Mode::Walk => { println "walk"; },
        Mode::Run => { println "run"; },
    }
}
