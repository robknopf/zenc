// Version 6. The Reloader's kept memory made small (env: 256 KB of a 1 MB space), and each
// version a new 60 KB string literal, which the pool keeps: once there is no room for one,
// that version isn't loaded (the reload says so), and the version running stays.
raw {
    static const char *blob(void) { return ""; }
}
extern fn blob() -> const char*;
@link_name("reload_step")
fn reload_step(_state: void*) {
    let n = strlen(blob());
    println "version 6: a literal of {n} bytes";
}
