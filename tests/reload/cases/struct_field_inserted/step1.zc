// A field added before another changes the state's layout: the Reloader moves the
// state to the new layout, so lives keeps its value and the new field starts at zero.
struct State { lives: int; }
@link_name("reload_step")
fn reload_step(state: State*) {
    if state.lives == 0 { state.lives = 3; }
    state.lives = state.lives - 1;
    println "lives {state.lives}";
}
