// A field added before another changes the state's layout: the host is told
// (type_changed), and clears the state rather than read the old bytes as the new layout.
struct State { lives: int; }
@link_name("reload_step")
fn reload_step(state: State*) {
    if state.lives == 0 { state.lives = 3; }
    state.lives = state.lives - 1;
    println "lives {state.lives}";
}
