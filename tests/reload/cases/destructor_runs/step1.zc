// The @destructor functions run once, at the end, on the version current then: replacing a
// version doesn't run its destructors (or the new one's constructors).
@constructor
fn setup() {
    println "setup version 1";
}
@destructor
fn teardown() {
    println "teardown version 1";
}
@link_name("reload_step")
fn reload_step(_state: void*) {
    println "step";
}
