// A crash in a function an old callback was forwarded to: going back undoes the forwarding,
// so the callback (kept in the heap since version 1) runs version 1's function again.
struct Box { cb: fn*(int) -> int; }
struct State { kept: void*; }
fn greet(x: int) -> int {
    println "greet version 2";
    return x / (x - 10); // 10 / 0: SIGFPE
}
@link_name("reload_step")
fn reload_step(state: State*) {
    if state.kept == NULL {
        let b = (Box*)malloc(sizeof(Box));
        b.cb = greet;
        state.kept = (void*)b;
    }
    let b = (Box*)state.kept;
    let r = b.cb(10);
    println "returned {r}";
}
