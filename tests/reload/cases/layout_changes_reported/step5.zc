// A reload reports what changed in the module's types, and type_changed() answers for one.
// A field inserted first: the four after it move 4 bytes later, as one item.
struct State { pad: int; total: int; flag: u8; speed: f32; name: char[8]; }
struct Wrap { s: State; }
enum Mode { Idle, Walk, Run }
struct Pet { mode: Mode; id: int; }
struct Node { next: State*; }
struct Fresh { z: int; }
@link_name("reload_step")
fn reload_step(state: void*) { println "five"; }
