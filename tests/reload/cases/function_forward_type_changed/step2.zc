// A kept function pointer whose function takes a type that changed is not forwarded: the
// caller passes what it has, in the old layout. It goes on calling the old function, and the
// reload says why; a function whose types didn't change is forwarded as usual.
// Pt gains a field: take_pt stays with version 1; take_int is forwarded.
struct Pt { x: int; y: int; }
struct Box { on_pt: fn*(Pt) -> int; on_int: fn*(int) -> int; }
struct State { kept: void*; }
fn take_pt(p: Pt) -> int {
    println "take_pt version 2: {p.x}";
    return p.x;
}
fn take_int(x: int) -> int {
    println "take_int version 2: {x}";
    return x;
}
@link_name("reload_step")
fn reload_step(state: State*) {
    if state.kept == NULL {
        let b = (Box*)malloc(sizeof(Box));
        b.on_pt = take_pt;
        b.on_int = take_int;
        state.kept = (void*)b;
    }
    let b = (Box*)state.kept;
    let p: Pt;
    p.x = 7;
    b.on_pt(p);
    b.on_int(8);
}
