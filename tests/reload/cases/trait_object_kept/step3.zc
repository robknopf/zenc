// A trait object made by one version and kept in the host's block calls the newest code
// after a reload, even with old versions deleted: its vtable's storage is the host's, and
// every reload fills it with the new version's functions (also where the globals' storage
// moved, in step 2).
trait Speak { fn speak(self) -> int; }
struct Dog { n: int; }
let added: int = 1; // a new global: the globals get new storage
impl Speak for Dog { fn speak(self) -> int { println "dog version 3"; return self.n; } }
struct State { dog: Dog; pet: Speak; made: bool; }
@link_name("reload_step")
fn reload_step(state: State*) {
    if !state.made {
        state.dog = Dog { n: 7 };
        let dog: Dog* = &state.dog; // `state.pet = &state.dog` doesn't compile yet
        state.pet = dog;
        state.made = true;
    }
    let n = state.pet.speak();
    println "speak returned {n}";
}
