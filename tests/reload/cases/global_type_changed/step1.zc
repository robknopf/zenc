// A global whose struct type is rearranged, at the same size, is moved field by field:
// a and b keep their values (read as it was, the old bytes would give a 2 b 1).
struct Pair { a: int; b: int; }
let p: Pair;
@link_name("reload_step")
fn reload_step(_state: void*) {
    if p.a == 0 { p.a = 1; p.b = 2; }
    println "a {p.a} b {p.b}";
}
