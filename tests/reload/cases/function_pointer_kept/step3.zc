// A function pointer kept in the state (the host's block, or a global) is pointed at the new
// version's function of the same name after a reload. One whose function's signature
// changed keeps calling the old one, and the reload says so.
fn greet(times: int) {
    println "greet version 3, {times}";
}
struct Hooks { on: fn*(); }
let hooks: Hooks;
struct State { hook: fn*(); }
@link_name("reload_step")
fn reload_step(state: State*) {
    state.hook();
}
