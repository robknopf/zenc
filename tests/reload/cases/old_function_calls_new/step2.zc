// Version 2. A function pointer kept in the heap whose function's signature then changes
// (version 2) keeps calling the old function, and what that one calls by name (shout) runs
// the newest version's: the old function is copied out of its version when its stub is
// pinned to it, its calls through stubs. Version 1 is released at version 3; the copy stays.
struct Box { cb: fn*(int) -> int; }
struct State { kept: void*; }
fn shout(x: int) {
    println "shout version 2: {x}";
}
fn greet(x: int, y: int) -> int {
    println "greet version 2";
    shout(x + y);
    return x + y + 1;
}
@link_name("reload_step")
fn reload_step(state: State*) {
    if state.kept == NULL {
        let b = (Box*)malloc(sizeof(Box));
        b.cb = (fn*(int) -> int)greet;
        state.kept = (void*)b;
    }
    let b = (Box*)state.kept;
    let r = b.cb(10);
    println "returned {r}";
}
