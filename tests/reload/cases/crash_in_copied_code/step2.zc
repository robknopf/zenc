// Version 2. (See step1.zc.) greet takes two now.
struct Box { cb: fn*(int) -> int; }
struct State { kept: void*; }
fn greet(x: int, y: int) -> int {
    println "greet version 2: {x} {y}";
    return x + y;
}
@link_name("reload_step")
fn reload_step(state: State*) {
    let b = (Box*)state.kept;
    println "version 2 calls the kept pointer with 10";
    let r = b.cb(10);
    println "version 2 returned {r}";
}
