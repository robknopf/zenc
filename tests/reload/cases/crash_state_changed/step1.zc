// A crash in a version whose reload changed the state's layout: the state goes back to
// what it was before that reload, for the version before.
fn crash(at: int) -> int {
    let p = (int*)(usize)at; // 0: a write to address 0
    *p = 1;
    return 0;
}
struct State { count: int; }
@link_name("reload_step")
fn reload_step(state: State*) {
    state.count = state.count + 1;
    println "version 1: count {state.count}";
    
}
